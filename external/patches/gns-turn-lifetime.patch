+void ICESessionInterface::PollTURNStream( SteamNetworkingMicroseconds usecNow )
+{
+    if ( !m_pTURNStream ) return;
+    CTURNStream *const stream = m_pTURNStream.get();
+    const netadr_t server = stream->Remote();
+    std::vector<std::vector<uint8>> packets;
+    stream->Poll( packets, m_boundAddr );
+    if ( stream->Failed() )
+    {
+        // Cancel the server request before dropping its allocation. The next
+        // discovery tick can move to another server of the same transport.
+        if ( m_pPendingSTUNRequest ) { delete m_pPendingSTUNRequest; m_pPendingSTUNRequest = nullptr; }
+        const int next = m_session.NextTURNServer( *this, m_nTURNServerIndex );
+        const bool wasAllocated = m_addrRelayed.IsValid();
+        m_session.DropRelayAllocation( this );
+        if ( next >= 0 )
+            QueueAllocateRequest( next, &CSteamNetworkingICESession::STUNRequestCallback_AllocateRelay, m_session.m_nEncoding );
+        else
+        {
+            m_addrTURNServer = server;
+            m_bRelayFailed = true;
+            // Retry transient outages within the ordinary connection deadline.
+            m_usecTURNRetryAfter = usecNow + ( wasAllocated ? 1000000 : 5000000 );
+        }
+        SpewWarning( "ICE: TURN %s stream closed; trying another relay candidate\n", m_nTURNProtocol == k_EProtocolTypeTLS ? "TLS" : "TCP" );
+        return;
+    }
+    for ( const auto &packet : packets )
+    {
+        if ( m_pTURNStream.get() != stream || m_pTURNStream->Remote() != server ) break;
+        RecvPktInfo_t info{};
+        info.m_pPkt = packet.data();
+        info.m_cbPkt = int( packet.size() );
+        info.m_usecNow = usecNow;
+        info.m_adrFrom = server;
+        info.m_tos = 0xff;
+        m_session.OnPacketReceived( info, this );
+    }
+}
