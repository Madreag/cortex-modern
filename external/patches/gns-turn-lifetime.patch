+#ifdef STEAMNETWORKINGSOCKETS_ENABLE_MOCK
+bool TEST_ICE_STUNFailuresAreBounded()
+{
+	SteamNetworkingGlobalLock lock( "STUN failure selftest" );
+	for ( bool ipv6 : { false, true } )
+	{
+		CSteamNetworkingICESession session( k_EICERole_Controlling, nullptr, 0 );
+		// Repeated endpoints and mixed families must not rewind a failed request.
+		for ( const char *text : { "192.0.2.10:3478", "[2001:db8::10]:3478", "192.0.2.10:3478", "[2001:db8::10]:3478", "192.0.2.11:3478", "[2001:db8::11]:3478" } )
+		{
+			netadr_t address;
+			if ( !address.SetFromString( text ) ) return false;
+			session.m_vecSTUNServers.push_back( address );
+		}
+		session.m_vecInterfaces.emplace_back( new ICESessionInterface( session, 1, ipv6 ? 64 : 24 ) );
+		auto &intf = *session.m_vecInterfaces.back();
+		if ( !intf.m_boundAddr.SetFromString( ipv6 ? "[2001:db8::1]:50000" : "192.0.2.1:50000" ) ) return false;
+		const auto failPass = [&]( RecvSTUNPacketCallback_t callback ) {
+			int attempts = 0;
+			while ( intf.m_pPendingSTUNRequest && attempts < 8 )
+			{
+				auto *request = intf.m_pPendingSTUNRequest;
+				if ( request->m_remoteAddr.GetType() != intf.m_boundAddr.GetType() ) return false;
+				RecvSTUNPktInfo_t failure{};
+				failure.m_pRequest = request;
+				failure.m_usecNow = SteamNetworkingSockets_GetLocalTimestamp();
+				(session.*callback)( failure );
+				delete request;
+				++attempts;
+			}
+			return attempts == 3 && !intf.m_pPendingSTUNRequest;
+		};
+		session.Think_DiscoverServerReflexiveCandidates();
+		if ( !failPass( &CSteamNetworkingICESession::STUNRequestCallback_ServerReflexiveCandidate ) || !intf.m_bServerReflexiveFailed ) return false;
+		session.Think_DiscoverServerReflexiveCandidates();
+		if ( intf.m_pPendingSTUNRequest ) return false;
+		intf.m_addrServerReflexive = intf.m_boundAddr;
+		session.Think_KeepAliveOnCandidates( 1000000 );
+		if ( !failPass( &CSteamNetworkingICESession::STUNRequestCallback_ServerReflexiveKeepAlive ) ) return false;
+		session.Think_KeepAliveOnCandidates( 1000000 );
+		if ( intf.m_pPendingSTUNRequest ) return false;
+		session.Think_KeepAliveOnCandidates( 16000000 );
+		if ( !failPass( &CSteamNetworkingICESession::STUNRequestCallback_ServerReflexiveKeepAlive ) ) return false;
+	}
+	return true;
+}
