+int CSteamNetworkingICESession::FindTURNServer( const ICESessionInterface &intf, const netadr_t &address ) const
+{
+    for ( int i = 0; i < len( m_vecTURNServers ); ++i )
+        if ( m_vecTURNServers[i] == address && m_vecTURNCredentials[i].m_protocol == intf.m_nTURNProtocol
+            && ( intf.m_strTURNServerHostname.empty() || m_vecTURNCredentials[i].m_strHostname == intf.m_strTURNServerHostname ) ) return i;
+    return -1;
+}
+
+int CSteamNetworkingICESession::NextSTUNServer( const ICESessionInterface &intf, int after ) const
+{
+    for ( int i = after + 1; i < len( m_vecSTUNServers ); ++i )
+        if ( m_vecSTUNServers[i].GetType() == intf.m_boundAddr.GetType() ) return i;
+    return -1;
+}
+
+int CSteamNetworkingICESession::NextTURNServer( const ICESessionInterface &intf, int after ) const
+{
+    for ( int i = after + 1; i < len( m_vecTURNServers ); ++i )
+        if ( m_vecTURNServers[i].GetType() == intf.m_boundAddr.GetType() && m_vecTURNCredentials[i].m_protocol == intf.m_nTURNProtocol ) return i;
+    return -1;
+}
