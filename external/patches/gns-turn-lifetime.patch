+void ICETURNServerList::Read( ConnectionConfig &config )
+{
+	m_vecAddrs.clear();
+	m_vecUsers.clear();
+	m_vecPasses.clear();
+	m_vecServers.clear();
+	m_bLoginListMismatch = false;
+
+	{
+		CUtlVector<char*> tempTurnServers;
+		V_AllocAndSplitString( config.P2P_TURN_ServerList.Get().c_str(), ",", tempTurnServers, true );
+		for (const char* pszAddress : tempTurnServers)
+		{
+			std::string server;
+
+			// Add prefix, unless they already supplied it
+			if (V_strnicmp(pszAddress, "turn:", 5) != 0)
+				server = "turn:";
+			server.append(pszAddress);
+
+			m_vecAddrs.push_back(std::move(server));
+		}
+		for ( char *p: tempTurnServers ) delete[] p;
+	}
+	if ( m_vecAddrs.empty() )
+		return;
+
+	// populate usernames and passwords
+	{
+		CUtlVector<char*> tempUsers, tempPasses;
+		V_AllocAndSplitString( config.P2P_TURN_UserList.Get().c_str(), ",", tempUsers, true );
+		V_AllocAndSplitString( config.P2P_TURN_PassList.Get().c_str(), ",", tempPasses, true );
+		for ( char *p: tempUsers )  { m_vecUsers.push_back( p );  delete[] p; }
+		for ( char *p: tempPasses ) { m_vecPasses.push_back( p ); delete[] p; }
+	}
+
+	// If turn array lengths (servers, users and passes) do not match, treat all TURN servers as unauthenticated
+	if ( !m_vecUsers.empty() || !m_vecPasses.empty() )
+	{
+		if ( len( m_vecAddrs ) != len( m_vecUsers ) || len( m_vecAddrs ) != len( m_vecPasses ) )
+		{
+			m_vecUsers.clear();
+			m_vecPasses.clear();
+			m_bLoginListMismatch = true;
+		}
+	}
+
+	// Populate TurnServers configs
+	for (int i = 0; i < len( m_vecAddrs ); i++)
+	{
+		ICESessionConfig::TurnServer* turn = push_back_get_ptr( m_vecServers );
+		turn->m_pszHost = m_vecAddrs[i].c_str();
+		turn->m_pszUsername = ( i < len( m_vecUsers ) )  ? m_vecUsers[i].c_str()  : "";
+		turn->m_pszPwd      = ( i < len( m_vecPasses ) ) ? m_vecPasses[i].c_str() : "";
+	}
+}
