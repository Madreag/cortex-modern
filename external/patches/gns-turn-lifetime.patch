+void CSteamNetworkingICESession::EnsureTURNInterfaces()
+{
+    if ( !( m_nPermittedCandidateTypes & k_EICECandidate_Any_Relay ) ) return;
+    const int count = len( m_vecInterfaces );
+    for ( int i = 0; i < count; ++i )
+    {
+        ICESessionInterface *base = m_vecInterfaces[i].get();
+        if ( base->m_nTURNProtocol != k_EProtocolTypeUDP || base->m_nTURNAddressFamily != 1 ) continue;
+        for ( int family : { 1, 2 } )
+        for ( EProtocolType protocol : { k_EProtocolTypeUDP, k_EProtocolTypeTCP, k_EProtocolTypeTLS } )
+        {
+            if ( family == 1 && protocol == k_EProtocolTypeUDP ) continue;
+            if ( family == 2 && !( m_nPermittedCandidateTypes & k_EICECandidate_IPv6_Relay ) ) continue;
+            bool found = false;
+            for ( const auto &intf : m_vecInterfaces )
+                if ( intf->m_nTURNProtocol == protocol && intf->m_nTURNAddressFamily == family && intf->m_boundAddr.GetIP() == base->m_boundAddr.GetIP() ) { found = true; break; }
+            if ( found ) continue;
+            const uint32 offset = ( protocol == k_EProtocolTypeTLS ? 512 : protocol == k_EProtocolTypeTCP ? 256 : 0 ) + ( family == 2 ? 128 : 0 );
+            std::unique_ptr<ICESessionInterface> stream( new ICESessionInterface( *this, base->m_nPriority > offset ? base->m_nPriority - offset : 0, base->m_nPrefixLen ) );
+            stream->m_nTURNProtocol = protocol;
+            stream->m_nTURNAddressFamily = family;
+            stream->m_boundAddr = base->m_boundAddr;
+            stream->m_boundAddr.SetPort( 0 );
+            if ( NextTURNServer( *stream ) < 0 ) continue;
+            if ( protocol == k_EProtocolTypeUDP )
+            {
+                SteamDatagramErrMsg errMsg;
+                SteamNetworkingIPAddr bindAddr = base->m_pSocket->m_boundAddr;
+                bindAddr.m_port = 0;
+                stream->m_pSocket = OpenRawUDPSocket( CRecvPacketCallback( CSteamNetworkingICESession::StaticPacketReceived, stream.get() ), errMsg, &bindAddr, nullptr );
+                if ( !stream->m_pSocket ) continue;
+                SteamNetworkingIPAddrToNetAdr( stream->m_boundAddr, stream->m_pSocket->m_boundAddr );
+            }
+            m_vecInterfaces.emplace_back( std::move( stream ) );
+        }
+    }
 }
 
+void CSteamNetworkingICESession::UpdateTURNServers( const ICESessionConfig::TurnServer *pServers, int nServers )
+{
+	SteamNetworkingGlobalLock::AssertHeldByCurrentThread( "CSteamNetworkingICESession::UpdateTURNServers" );
+
+	// Without a server nothing could allocate, so keep the ones we have.
+	if ( nServers <= 0 )
+		return;
+
+	std_vector< netadr_t > vecOldServers = m_vecTURNServers;
+	std_vector< TURNCredentials > vecOldCredentials = m_vecTURNCredentials;
+	SetTURNServers( pServers, nServers );
+	bool bChanged = vecOldServers.size() != m_vecTURNServers.size();
+	for ( int i = 0; !bChanged && i < len( m_vecTURNServers ); ++i )
+	{
+		bChanged = !( vecOldServers[i] == m_vecTURNServers[i] )
+			|| vecOldCredentials[i].m_strUsername != m_vecTURNCredentials[i].m_strUsername
+            || vecOldCredentials[i].m_strPassword != m_vecTURNCredentials[i].m_strPassword
+            || vecOldCredentials[i].m_strHostname != m_vecTURNCredentials[i].m_strHostname
+            || vecOldCredentials[i].m_protocol != m_vecTURNCredentials[i].m_protocol;
+	}
+	if ( !bChanged )
+		return;
+
+	++m_nTURNLoginRevision;
+	SpewMsg( "ICE: TURN login updated (%d server address(es)); the next allocation uses it\n", len( m_vecTURNServers ) );
+
+	const SteamNetworkingMicroseconds usecNow = SteamNetworkingSockets_GetLocalTimestamp();
+	for ( const std::unique_ptr<ICESessionInterface> &pIntf : m_vecInterfaces )
+	{
+		// A relay the server refused or never answered tries again with the new login.
+		if ( pIntf->m_bRelayFailed && !pIntf->m_addrRelayed.IsValid() )
+		{
+			pIntf->m_addrTURNServer.Clear();
+			pIntf->m_bRelayFailed = false;
+            pIntf->ClearTURNAuth();
+            pIntf->m_pTURNStream.reset();
+            pIntf->m_nTURNServerIndex = -1;
+			continue;
+		}
+
+		// A live allocation tries the new login on a Refresh right away.
+		const int nSrvIdx = pIntf->m_addrRelayed.IsValid() ? FindTURNServer( *pIntf, pIntf->m_addrTURNServer ) : -1;
+		if ( nSrvIdx < 0 || m_vecTURNCredentials[ nSrvIdx ].m_strUsername.empty() || pIntf->m_strTURNRealm.empty() )
+			continue;
+        pIntf->m_nTURNServerIndex = nSrvIdx;
+		const TURNCredentials &cred = m_vecTURNCredentials[ nSrvIdx ];
+		if ( cred.m_strUsername == pIntf->m_strTURNUsername && cred.m_strPassword == pIntf->m_strTURNPassword )
+		{
+			pIntf->m_strTURNRenewedUsername.clear();
+			pIntf->m_strTURNRenewedPassword.clear();
+			continue;
+		}
+		pIntf->m_strTURNRenewedUsername = cred.m_strUsername;
+		pIntf->m_strTURNRenewedPassword = cred.m_strPassword;
+		pIntf->m_usecRefreshAfter = usecNow;
+	}
+    EnsureTURNInterfaces();
+	SetNextThinkTimeASAP();
+}
 
