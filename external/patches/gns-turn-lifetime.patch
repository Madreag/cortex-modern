+// TURN permissions last 300 s; send them again after 240 (RFC 5766 section 8).
+const SteamNetworkingMicroseconds k_usecTURNPermissionRefresh = 240 * k_nMillion;
+
+// The allocation lifetime when a success answer names none (RFC 5766 section 6.2).
+const SteamNetworkingMicroseconds k_usecTURNDefaultLifetime = 600 * k_nMillion;
+
+// Pause before sending a TURN request the server refused again.
+const SteamNetworkingMicroseconds k_usecTURNRetryBackoff = 10 * k_nMillion;
+
+// An error response has both class bits of the message type set (RFC 5389 section 6).
+static bool IsSTUNErrorResponse( const STUNHeader *pHeader )
+{
+    return pHeader != nullptr && ( pHeader->m_nMessageType & 0x0110 ) == 0x0110;
+}
+
+// The ERROR-CODE of an error response, or 0 when it names none.
+static int STUNErrorCode( const RecvSTUNPktInfo_t &info )
+{
+    const STUNAttribute *pErrorAttr = FindAttributeOfType( info.m_pAttributes, info.m_nAttributes, k_nSTUN_Attr_ErrorCode );
+    if ( pErrorAttr == nullptr || pErrorAttr->m_nLength < 4 )
+        return 0;
+    const uint8 *pErrBytes = reinterpret_cast<const uint8*>( pErrorAttr->m_pData );
+    return ( pErrBytes[2] & 7 ) * 100 + pErrBytes[3];
+}
+
+// The lifetime a TURN success answer granted.
+static SteamNetworkingMicroseconds TURNLifetime( const RecvSTUNPktInfo_t &info )
+{
+    const STUNAttribute *pLifetimeAttr = FindAttributeOfType( info.m_pAttributes, info.m_nAttributes, k_nTURN_Attr_Lifetime );
+    if ( pLifetimeAttr == nullptr || pLifetimeAttr->m_nLength != 4 || ntohl( pLifetimeAttr->m_pData[0] ) == 0 )
+        return k_usecTURNDefaultLifetime;
+    return (SteamNetworkingMicroseconds)ntohl( pLifetimeAttr->m_pData[0] ) * k_nMillion;
+}
