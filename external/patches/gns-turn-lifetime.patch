+// TURN client transports over TCP and TLS (RFC 8656). The allocation still
+// relays UDP to the peer. All methods run under the ICE session's global lock.
+#pragma once
+
+#include <deque>
+#include <vector>
+#ifndef _WIN32
+#include <netinet/tcp.h>
+#endif
+
+#ifdef VALVE_CRYPTO_OPENSSL
+#ifdef _WIN32
+#include <wincrypt.h>
+#undef X509_NAME
+#elif defined(__APPLE__)
+#include <Security/Security.h>
+#endif
+#include <openssl/ssl.h>
+#include <openssl/err.h>
+#include <openssl/x509v3.h>
+#endif
+
+namespace SteamNetworkingSocketsLib {
+
+class CTURNStream
+{
+public:
+    CTURNStream( const netadr_t &local, const netadr_t &remote, EProtocolType protocol, const std::string &hostname )
+        : m_protocol( protocol ), m_remote( remote ), m_hostname( hostname )
+    {
+        m_socket = socket( remote.GetType() == k_EIPTypeV4 ? AF_INET : AF_INET6, SOCK_STREAM, IPPROTO_TCP );
+        if ( m_socket == INVALID_SOCKET || !SetSocketNonBlocking( m_socket ) )
+        {
+            Fail();
+            return;
+        }
+        int one = 1;
+        setsockopt( m_socket, IPPROTO_TCP, TCP_NODELAY, reinterpret_cast<const char *>( &one ), sizeof( one ) );
+#ifdef SO_NOSIGPIPE
+        setsockopt( m_socket, SOL_SOCKET, SO_NOSIGPIPE, reinterpret_cast<const char *>( &one ), sizeof( one ) );
+#endif
+        sockaddr_storage addr;
+        netadr_t bindAddr = local;
+        bindAddr.SetPort( 0 );
+        const int bindSize = int( bindAddr.ToSockadr( &addr ) );
+        if ( !bindSize || bind( m_socket, reinterpret_cast<sockaddr *>( &addr ), bindSize ) != 0 )
+        {
+            Fail();
+            return;
+        }
+        const int remoteSize = int( remote.ToSockadr( &addr ) );
+        if ( !remoteSize )
+        {
+            Fail();
+            return;
+        }
+        if ( connect( m_socket, reinterpret_cast<sockaddr *>( &addr ), remoteSize ) == 0 )
+            m_connected = true;
+        else
+        {
+            const int err = GetLastSocketError();
+#ifdef _WIN32
+            if ( err != WSAEWOULDBLOCK && err != WSAEINPROGRESS ) Fail();
+#else
+            if ( err != EINPROGRESS && err != EWOULDBLOCK ) Fail();
+#endif
+        }
+    }
+
+    ~CTURNStream()
+    {
+#ifdef VALVE_CRYPTO_OPENSSL
+        if ( m_ssl ) SSL_free( m_ssl );
+#endif
+        if ( m_socket != INVALID_SOCKET ) closesocket( m_socket );
+    }
+
+    bool Failed() const { return m_failed; }
+    const netadr_t &Remote() const { return m_remote; }
+
+    bool Send( int nChunks, const iovec *chunks )
+    {
+        size_t size = 0;
+        for ( int i = 0; i < nChunks; ++i ) size += chunks[i].iov_len;
+        if ( m_failed || size > 65556 || m_queuedBytes + size > 1024 * 1024 ) return false;
+        std::vector<uint8> packet;
+        packet.reserve( size );
+        for ( int i = 0; i < nChunks; ++i )
+        {
+            const uint8 *data = static_cast<const uint8 *>( chunks[i].iov_base );
+            packet.insert( packet.end(), data, data + chunks[i].iov_len );
+        }
+        m_outgoing.emplace_back( std::move( packet ) );
+        m_queuedBytes += size;
+        return true;
+    }
+
+    // Return complete STUN frames. Dispatch them only after Poll returns: an ICE
+    // callback can replace the allocation and destroy this stream.
+    void Poll( std::vector<std::vector<uint8>> &packets, netadr_t &bound )
+    {
+        if ( m_failed ) return;
+        if ( !m_connected )
+        {
+#ifdef _WIN32
+            fd_set writes, errors;
+            FD_ZERO( &writes ); FD_ZERO( &errors );
+            FD_SET( m_socket, &writes ); FD_SET( m_socket, &errors );
+            timeval wait = {0, 0};
+            if ( select( int( m_socket ) + 1, nullptr, &writes, &errors, &wait ) <= 0 ) return;
+            int error = 0;
+            int size = sizeof( error );
+#else
+            pollfd socketPoll = { m_socket, POLLOUT, 0 };
+            if ( poll( &socketPoll, 1, 0 ) <= 0 ) return;
+            int error = 0;
+            socklen_t size = sizeof( error );
+#endif
+            if ( getsockopt( m_socket, SOL_SOCKET, SO_ERROR, reinterpret_cast<char *>( &error ), &size ) != 0 || error )
+            {
+                Fail();
+                return;
+            }
+            m_connected = true;
+        }
+        if ( !m_ready )
+        {
+            if ( m_protocol == k_EProtocolTypeTLS )
+            {
+#ifdef VALVE_CRYPTO_OPENSSL
+                if ( !m_ssl && !InitTLS() ) { Fail(); return; }
+                ERR_clear_error();
+                const int result = SSL_connect( m_ssl );
+                if ( result != 1 )
+                {
+                    if ( !TLSWouldBlock( result ) ) Fail();
+                    return;
+                }
+                if ( SSL_get_verify_result( m_ssl ) != X509_V_OK ) { Fail(); return; }
+#else
+                Fail(); return;
+#endif
+            }
+            sockaddr_storage addr;
+#ifdef _WIN32
+            int size = sizeof( addr );
+#else
+            socklen_t size = sizeof( addr );
+#endif
+            if ( getsockname( m_socket, reinterpret_cast<sockaddr *>( &addr ), &size ) != 0 || !bound.SetFromSockadr( &addr, size ) )
+            {
+                Fail(); return;
+            }
+            m_ready = true;
+            SpewMsg( "ICE: TURN %s stream connected\n", m_protocol == k_EProtocolTypeTLS ? "TLS" : "TCP" );
+        }
+
+        // Bound work per tick as well as memory. A stalled stream cannot stop
+        // direct candidates or the other relay transports from progressing.
+        for ( int count = 0; count < 64 && !m_outgoing.empty(); ++count )
+        {
+            const auto &packet = m_outgoing.front();
+            const int remaining = int( packet.size() - m_outOffset );
+            const int sent = Write( packet.data() + m_outOffset, remaining );
+            if ( sent < 0 ) { if ( !m_wouldBlock ) Fail(); break; }
+            if ( sent == 0 ) { Fail(); break; }
+            m_outOffset += sent;
+            m_queuedBytes -= sent;
+            if ( m_outOffset == packet.size() ) { m_outgoing.pop_front(); m_outOffset = 0; }
+        }
+        for ( int count = 0; count < 64 && !m_failed; ++count )
+        {
+            uint8 buffer[16384];
+            const int received = Read( buffer, sizeof( buffer ) );
+            if ( received < 0 ) { if ( !m_wouldBlock ) Fail(); break; }
+            if ( received == 0 ) { Fail(); break; }
+            m_incoming.insert( m_incoming.end(), buffer, buffer + received );
+            size_t used = 0;
+            while ( m_incoming.size() - used >= 20 )
+            {
+                const uint8 *frame = m_incoming.data() + used;
+                // We never use ChannelBind, so only STUN messages are valid.
+                const size_t length = ( size_t( frame[2] ) << 8 ) | frame[3];
+                if ( ( frame[0] & 0xc0 ) || ( length & 3 ) || frame[4] != 0x21 || frame[5] != 0x12 || frame[6] != 0xa4 || frame[7] != 0x42 )
+                { Fail(); break; }
+                if ( m_incoming.size() - used < 20 + length ) break;
+                packets.emplace_back( frame, frame + 20 + length );
+                used += 20 + length;
+            }
+            if ( used ) m_incoming.erase( m_incoming.begin(), m_incoming.begin() + used );
+            if ( m_incoming.size() > 65556 ) Fail();
+        }
+    }
+
+private:
+    SOCKET m_socket = INVALID_SOCKET;
+    EProtocolType m_protocol;
+    netadr_t m_remote;
+    std::string m_hostname;
+    bool m_connected = false, m_ready = false, m_failed = false, m_wouldBlock = false;
+    std::deque<std::vector<uint8>> m_outgoing;
+    std::vector<uint8> m_incoming;
+    size_t m_outOffset = 0, m_queuedBytes = 0;
+
+    void Fail() { m_failed = true; }
+    static bool SocketWouldBlock() { return GetLastSocketError() == WSAEWOULDBLOCK; }
+
+#ifdef VALVE_CRYPTO_OPENSSL
+    SSL *m_ssl = nullptr;
+
+    static SSL_CTX *TLSContext()
+    {
+        // Initialized under the networking lock; roots and the context outlive sessions.
+        static std::unique_ptr<SSL_CTX, decltype(&SSL_CTX_free)> ctx( []() -> SSL_CTX * {
+            SSL_CTX *value = SSL_CTX_new( TLS_client_method() );
+            if ( !value ) return nullptr;
+            SSL_CTX_set_min_proto_version( value, TLS1_2_VERSION );
+            SSL_CTX_set_verify( value, SSL_VERIFY_PEER, nullptr );
+            SSL_CTX_set_default_verify_paths( value );
+#ifdef _WIN32
+            HCERTSTORE roots = CertOpenSystemStoreA( 0, "ROOT" );
+            if ( roots )
+            {
+                PCCERT_CONTEXT cert = nullptr;
+                while ( ( cert = CertEnumCertificatesInStore( roots, cert ) ) != nullptr )
+                {
+                    const unsigned char *bytes = cert->pbCertEncoded;
+                    X509 *x509 = d2i_X509( nullptr, &bytes, cert->cbCertEncoded );
+                    if ( x509 ) { X509_STORE_add_cert( SSL_CTX_get_cert_store( value ), x509 ); X509_free( x509 ); }
+                }
+                CertCloseStore( roots, 0 );
+            }
+#elif defined(__APPLE__)
+            CFArrayRef roots = nullptr;
+            if ( SecTrustCopyAnchorCertificates( &roots ) == errSecSuccess && roots )
+            {
+                for ( CFIndex i = 0; i < CFArrayGetCount( roots ); ++i )
+                {
+                    CFDataRef data = SecCertificateCopyData( (SecCertificateRef)CFArrayGetValueAtIndex( roots, i ) );
+                    if ( !data ) continue;
+                    const unsigned char *bytes = CFDataGetBytePtr( data );
+                    X509 *x509 = d2i_X509( nullptr, &bytes, CFDataGetLength( data ) );
+                    if ( x509 ) { X509_STORE_add_cert( SSL_CTX_get_cert_store( value ), x509 ); X509_free( x509 ); }
+                    CFRelease( data );
+                }
+                CFRelease( roots );
+            }
+#endif
+            ERR_clear_error();
+            return value;
+        }(), &SSL_CTX_free );
+        return ctx.get();
+    }
+
+    // A socket BIO using MSG_NOSIGNAL avoids a broken TLS connection raising
+    // SIGPIPE in an application that has not changed its process signal policy.
+    static BIO_METHOD *SocketBIO()
+    {
+        static std::unique_ptr<BIO_METHOD, decltype(&BIO_meth_free)> method( []() -> BIO_METHOD * {
+            BIO_METHOD *value = BIO_meth_new( BIO_get_new_index() | BIO_TYPE_SOURCE_SINK, "TURN socket" );
+            if ( !value ) return nullptr;
+            BIO_meth_set_create( value, []( BIO *bio ) { BIO_set_init( bio, 1 ); return 1; } );
+            BIO_meth_set_destroy( value, []( BIO * ) { return 1; } );
+            BIO_meth_set_ctrl( value, []( BIO *, int cmd, long, void * ) -> long { return cmd == BIO_CTRL_FLUSH ? 1 : 0; } );
+            BIO_meth_set_read( value, []( BIO *bio, char *data, int size ) {
+                BIO_clear_retry_flags( bio );
+                CTURNStream *stream = static_cast<CTURNStream *>( BIO_get_data( bio ) );
+                const int result = int( recv( stream->m_socket, data, size, 0 ) );
+                if ( result < 0 && SocketWouldBlock() ) BIO_set_retry_read( bio );
+                return result;
+            } );
+            BIO_meth_set_write( value, []( BIO *bio, const char *data, int size ) {
+                BIO_clear_retry_flags( bio );
+                CTURNStream *stream = static_cast<CTURNStream *>( BIO_get_data( bio ) );
+                const int result = int( send( stream->m_socket, data, size, MSG_NOSIGNAL ) );
+                if ( result < 0 && SocketWouldBlock() ) BIO_set_retry_write( bio );
+                return result;
+            } );
+            return value;
+        }(), &BIO_meth_free );
+        return method.get();
+    }
+
+    bool InitTLS()
+    {
+        if ( !TLSContext() || !SocketBIO() ) return false;
+        m_ssl = SSL_new( TLSContext() );
+        if ( !m_ssl ) return false;
+        BIO *bio = BIO_new( SocketBIO() );
+        if ( !bio ) return false;
+        BIO_set_data( bio, this );
+        SSL_set_bio( m_ssl, bio, bio );
+        SSL_set_connect_state( m_ssl );
+        SSL_set_mode( m_ssl, SSL_MODE_ENABLE_PARTIAL_WRITE | SSL_MODE_ACCEPT_MOVING_WRITE_BUFFER );
+        CIPAddress numeric;
+        if ( numeric.SetFromString( m_hostname.c_str() ) )
+            return X509_VERIFY_PARAM_set1_ip_asc( SSL_get0_param( m_ssl ), m_hostname.c_str() ) == 1;
+        return SSL_set_tlsext_host_name( m_ssl, m_hostname.c_str() ) == 1 && SSL_set1_host( m_ssl, m_hostname.c_str() ) == 1;
+    }
+
+    bool TLSWouldBlock( int result )
+    {
+        const int error = SSL_get_error( m_ssl, result );
+        return error == SSL_ERROR_WANT_READ || error == SSL_ERROR_WANT_WRITE;
+    }
+#endif
+
+    int Write( const uint8 *data, int size )
+    {
+        m_wouldBlock = false;
+#ifdef VALVE_CRYPTO_OPENSSL
+        if ( m_ssl )
+        {
+            ERR_clear_error();
+            const int result = SSL_write( m_ssl, data, size );
+            if ( result <= 0 ) { m_wouldBlock = TLSWouldBlock( result ); return -1; }
+            return result;
+        }
+#endif
+        const int result = int( send( m_socket, reinterpret_cast<const char *>( data ), size, MSG_NOSIGNAL ) );
+        m_wouldBlock = result < 0 && SocketWouldBlock();
+        return result;
+    }
+
+    int Read( uint8 *data, int size )
+    {
+        m_wouldBlock = false;
+#ifdef VALVE_CRYPTO_OPENSSL
+        if ( m_ssl )
+        {
+            ERR_clear_error();
+            const int result = SSL_read( m_ssl, data, size );
+            if ( result <= 0 ) { m_wouldBlock = TLSWouldBlock( result ); return -1; }
+            return result;
+        }
+#endif
+        const int result = int( recv( m_socket, reinterpret_cast<char *>( data ), size, 0 ) );
+        m_wouldBlock = result < 0 && SocketWouldBlock();
+        return result;
+    }
+};
+
+} // namespace SteamNetworkingSocketsLib
