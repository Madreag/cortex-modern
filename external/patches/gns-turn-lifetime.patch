+bool CSteamNetworkingICESession::BLocalCandidateAllowed( const ICELocalCandidate &candidate ) const
+{
+    const netadr_t &bound = candidate.m_pInterface->m_boundAddr;
+    if ( candidate.IsRelay() )
+        return ( m_nPermittedCandidateTypes & CalcICECandidateType( ICECandidateKind::Relayed, candidate.m_pInterface->m_addrRelayed ) ) != 0;
+
+    if ( candidate.m_pInterface->m_nTURNProtocol != k_EProtocolTypeUDP || candidate.m_pInterface->m_nTURNAddressFamily != 1 ) return false;
+
+    // Host and reflexive candidates use the same socket.  A reflexive-only policy
+    // still needs that socket as its base, but a relay-only policy must never use it directly.
+    return ( m_nPermittedCandidateTypes & ( CalcICECandidateType( ICECandidateKind::Host, bound )
+        | CalcICECandidateType( ICECandidateKind::PeerReflexive, bound ) ) ) != 0;
