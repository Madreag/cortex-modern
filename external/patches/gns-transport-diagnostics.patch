+STEAMNETWORKINGSOCKETS_INTERFACE bool SteamNetworkingSockets_GetConnectionPacketTimes( HSteamNetConnection connection, SteamNetworkingMicroseconds *sent, SteamNetworkingMicroseconds *received )
+{
+	if ( !sent || !received ) return false;
+	*sent = *received = 0;
+	SteamNetworkingGlobalLock lock( "GetConnectionPacketTimes" );
+	ConnectionScopeLock connectionLock;
+	auto *peer = GetConnectionByHandleForAPI( connection, connectionLock, "GetConnectionPacketTimes" );
+	if ( !peer ) return false;
+	*sent = peer->m_statsEndToEnd.m_usecTimeLastSentPacket;
+	*received = peer->m_statsEndToEnd.m_usecTimeLastRecv;
+	return true;
+}
