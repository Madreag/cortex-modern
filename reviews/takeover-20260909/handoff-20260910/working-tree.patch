+		return seat.dropped || seat.closed || seat.substituting;
+	});
+	if (!anythingToDecide) {
+		return;
+	}
+	const uint64_t nowMs = static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
