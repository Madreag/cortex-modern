+		          << " seat=" << s_netMatchE2eModerateSeat << " delay_ms=" << s_netMatchE2eModerateDelayMs << std::endl;
+	}
+	if (nowMs < s_netMatchE2eModerateReadyMs) {
+		return;
+	}
