+	uint64_t NetSeatPresence::HoldSeconds(uint64_t frames) {
+		// The pinned 0.0166666 s timestep, rounded up without overflowing the product.
+		return (frames / 10000000) * 166666 + ((frames % 10000000) * 166666 + 9999999) / 10000000;
+	}
