+
+std::vector<std::shared_ptr<Vector>> GraphicalPrimitive::OwnVertices(const std::vector<Vector*>& vertices) {
+	static std::mutex mutex;
+	static std::unordered_map<Vector*, std::weak_ptr<Vector>> owners;
+	std::lock_guard<std::mutex> lock(mutex);
+	std::vector<std::shared_ptr<Vector>> result;
+	for (auto* vertex: vertices) {
+		if (!vertex) { result.emplace_back(); continue; }
+		auto& reference = owners[vertex];
+		auto owner = reference.lock();
+		if (!owner) { owner.reset(vertex); reference = owner; }
+		result.push_back(std::move(owner));
+	}
+	std::erase_if(owners, [](const auto& entry) { return entry.second.expired(); });
+	return result;
+}
