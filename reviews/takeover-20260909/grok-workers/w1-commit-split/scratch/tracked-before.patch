+						lobbyConfig.matchConfig = config.matchConfig;
+						lobbyConfig.session = &clientSession;
+						lobbyConfig.sessionNowMs = nowMs;
+						lobbyActive = clientLobby.Start(clientTransport, lobbyConfig, &peerError);
+						lobbyStartedAt = now;
+					}
+					if (!lobbyActive) return;
