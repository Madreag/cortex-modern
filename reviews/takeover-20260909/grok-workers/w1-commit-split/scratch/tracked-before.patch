+Actor* Activity::ResolveNetActor(int64_t uid) {
+	if (uid <= 0 || uid > std::numeric_limits<long>::max()) return nullptr;
+	auto* actor = dynamic_cast<Actor*>(g_MovableMan.FindObjectByUniqueID(static_cast<long>(uid)));
