+						previous = progressAt;
+					}
+					if (!ok || received != state || lastProgress != 12 || progressTimes.back() <= config.lobbyWaitMs || !clientCoordinator.IsRunning()) {
+						*error = "runner timed out a progressing state transfer: " + transferError;
+						return false;
+					}
+				}
+			}
+			return true;
+		}
