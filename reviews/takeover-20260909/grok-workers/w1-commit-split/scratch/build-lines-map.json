{
  "commit_subjects": [
    "Carry player-binding observations on the command wire",
    "Bound a resync envelope around archive, acks and pending commands",
    "Restore complete input, drop-map ownership and exact-target priming",
    "Restore typed native aliases and isolate craft-fixture clones",
    "Skip registry mutation when privately adopting a persisted UniqueID",
    "Keep ACraft exit selection and AHuman inventory across checkpoint load",
    "Add A7 journal helpers for recovery-arm traces",
    "Give the host a live F6 panel and codec-17 seat snapshots",
    "Restore peer-local player, UI and aliases after a restore",
    "Initialize saved-game modules and use the lobby shared clock",
    "Record A7 recovery events on session, tickets and ownership",
    "Compare snapshots by the controlled actor's inventory role"
  ],
