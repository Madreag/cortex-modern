+void GUILabel::EnsureDrawableTextFont(const std::string& fontFile) {
+	if (!m_Skin || !m_SkinFont) {
+		return;
+	}
+	const auto missingGlyphs = [](GUIFont* font, const std::string& text) {
+		int missing = 0;
+		for (char c : text) {
+			const unsigned char index = static_cast<unsigned char>(c);
+			if (index > 32 && !font->HasGlyphPixels(index)) {
+				missing++;
+			}
+		}
+		return missing;
+	};
+	SetFont(m_SkinFont);
+	const int missing = missingGlyphs(m_SkinFont, m_Text);
+	if (missing > 0) {
+		GUIFont* fallback = m_Skin->GetFont(fontFile);
+		if (fallback && missingGlyphs(fallback, m_Text) < missing) {
+			SetFont(fallback);
+		}
+	}
+	m_Font->CacheColor(m_FontColor);
+}
