{
  "schema": 1,
  "timeout_ms": 170000,
  "steps": [
    {
      "op": "wait",
      "service": "Running",
      "sim_at_least": 150
    },
    {
      "op": "key_down",
      "key": "F6"
    },
    {
      "op": "key_up",
      "key": "F6"
    },
    {
      "op": "wait",
      "panel_open": true
    },
    {
      "op": "mouse_down",
      "control": "NetworkSeatsOptions"
    },
    {
      "op": "mouse_up",
      "control": "NetworkSeatsOptions"
    },
    {
      "op": "wait",
      "control": "NetworkSeatsOptionsText",
      "equals": {
        "visible": true
      }
    },
    {
      "op": "assert_control",
      "control": "NetworkSeatsOptionsText",
      "fits": true,
      "text_contains": "Repair match: Ready - pause menu > Match Options"
    },
    {
      "op": "wait",
      "elapsed_ms": 825
    },
    {
      "op": "key_down",
      "key": "F6"
    },
    {
      "op": "key_up",
      "key": "F6"
    },
    {
      "op": "wait",
      "panel_open": false
    },
    {
      "op": "key_down",
      "key": "Escape"
    },
    {
      "op": "key_up",
      "key": "Escape"
    },
    {
      "op": "wait",
      "screen": "Pause",
      "elapsed_ms": 400
    },
    {
      "op": "menu",
      "command": "activate ButtonMatchOptions"
    },
    {
      "op": "wait",
      "screen": "PauseMatchOptions",
      "elapsed_ms": 400
    },
    {
      "op": "assert",
      "equals": {
        "service": "Running"
      }
    },
    {
      "op": "menu",
      "command": "assert_rect_inside MatchOptionsBox viewport"
    },
    {
      "op": "menu",
      "command": "assert_rect_inside LabelMatchRepairHint MatchOptionsBox"
    },
    {
      "op": "menu",
      "command": "assert_enabled ButtonMatchRepairNow 1"
    },
    {
      "op": "menu",
      "command": "assert_rect_inside ButtonMatchRepairNow MatchOptionsBox"
    },
    {
      "op": "menu",
      "command": "activate ButtonMatchRepairNow"
    },
    {
      "op": "wait",
      "elapsed_ms": 132
    },
    {
      "op": "menu",
      "command": "assert_label LabelMatchRepairHint Every peer pauses and reloads the host's snapshot - press again"
    },
    {
      "op": "menu",
      "command": "assert_enabled ButtonMatchRepairNow 1"
    },
    {
      "op": "assert",
      "equals": {
        "service": "Running"
      }
    },
    {
      "op": "menu",
      "command": "dump_host_options"
    },
    {
      "op": "wait_file",
      "path": "{PROBE_DIR_client}/ready.json"
    },
    {
      "op": "wait",
      "elapsed_ms": 660
    },
    {
      "op": "menu",
      "command": "activate ButtonMatchRepairNow"
    },
    {
      "op": "wait",
      "elapsed_ms": 1980
    },
    {
      "op": "signal",
      "name": "done"
    },
    {
      "op": "finish"
    }
  ]
}
