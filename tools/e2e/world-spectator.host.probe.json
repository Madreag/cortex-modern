{
  "schema": 1,
  "timeout_ms": 180000,
  "activate_phase": "Running",
  "steps": [
    {
      "op": "wait",
      "lockstep_frame_at_least": 1200
    },
    {
      "op": "menu",
      "command": "dump_world_ownership before-spectator"
    },
    {
      "op": "wait_file",
      "path": "{PROBE_DIR_spectator}/crawl-complete.json"
    },
    {
      "op": "menu",
      "command": "dump_world_ownership before-release"
    },
    {
      "op": "wait_file",
      "path": "{PROBE_DIR_seated-one}/departed.json"
    },
    {
      "op": "remove_participant",
      "stable_seat": 1,
      "ban": false,
      "expected": "Ok"
    },
    {
      "op": "signal",
      "name": "host-released"
    },
    {
      "op": "wait_file",
      "path": "{PROBE_DIR_spectator}/promoted-input.json"
    },
    {
      "op": "menu",
      "command": "dump_world_ownership after-promotion"
    },
    {
      "op": "signal",
      "name": "done"
    },
    {
      "op": "key_down",
      "key": "Escape"
    },
    {
      "op": "key_up",
      "key": "Escape"
    },
    {
      "op": "wait",
      "screen": "Pause",
      "elapsed_ms": 450
    },
    {
      "op": "menu",
      "command": "activate ButtonEndMatch"
    },
    {
      "op": "wait",
      "screen": "PauseLeaveConfirm",
      "renders": 4,
      "scope": "menu"
    },
    {
      "op": "assert",
      "equals": {
        "service": "Running",
        "screen": "PauseLeaveConfirm"
      },
      "scope": "menu"
    },
    {
      "op": "assert_control",
      "control": "LabelLeaveConfirm",
      "text_contains": "all players",
      "fits": true,
      "scope": "menu"
    },
    {
      "op": "menu",
      "command": "activate ButtonLeaveConfirm",
      "scope": "menu"
    },
    {
      "op": "finish"
    }
  ]
}
