{
  "schema": 1,
  "name": "mp-direct-vs-relay",
  "port_base": 49474,
  "size": "960x540",
  "timeout_s": 190,
  "title": "Direct and relay connections proved by the transport and visible diagnostics",
  "capture_policy": "Every route item requires visible connected-route diagnostics and the native selected-candidate and RouteAllowed lines. Preferences alone are not route proof.",
  "requires_tokens": [
    "TURN_SERVER",
    "TURN_USER",
    "TURN_PASS"
  ],
  "runs": [
    {
      "name": "direct",
      "peers": [
        {
          "name": "host",
          "args": [
            "-input-script",
            "{INPUT_SCRIPT}"
          ],
          "menu_script": "mp-direct-vs-relay.direct.host.menu.txt",
          "input_script": "ui-surfaces.input.txt",
          "probe": "mp-direct-vs-relay.direct.host.probe.json",
          "settings": {
            "NetworkDisplayName": "Host",
            "NetworkIceEnable": "1",
            "NetworkShowDiagnostics": "1",
            "NetworkMatchStatusMode": "Always",
            "SessionDirectoryUrl": "{DIRECTORY_URL}",
            "SessionDirectoryCertSha256": "{DIRECTORY_PIN}"
          }
        },
        {
          "name": "client",
          "args": [
            "-input-script",
            "{INPUT_SCRIPT}"
          ],
          "menu_script": "mp-direct-vs-relay.direct.client.menu.txt",
          "input_script": "ui-surfaces.input.txt",
          "probe": "mp-direct-vs-relay.direct.client.probe.json",
          "settings": {
            "NetworkDisplayName": "Joiner",
            "NetworkIceEnable": "1",
            "NetworkShowDiagnostics": "1",
            "NetworkMatchStatusMode": "Always",
            "SessionDirectoryUrl": "{DIRECTORY_URL}",
            "SessionDirectoryCertSha256": "{DIRECTORY_PIN}"
          },
          "start_when": {
            "peer": "host",
            "event": "video_mark direct-mp-lobby-host",
            "timeout_s": 90
          }
        }
      ]
    },
    {
      "name": "relay",
      "peers": [
        {
          "name": "host",
          "args": [
            "-input-script",
            "{INPUT_SCRIPT}"
          ],
          "menu_script": "mp-direct-vs-relay.relay.host.menu.txt",
          "input_script": "play-input.txt",
          "probe": "mp-direct-vs-relay.relay.host.probe.json",
          "settings": {
            "NetworkDisplayName": "Host",
            "NetworkIceEnable": "1",
            "NetworkShowDiagnostics": "1",
            "NetworkMatchStatusMode": "Always",
            "NetworkTurnServers": "{TURN_SERVER}",
            "NetworkTurnUser": "{TURN_USER}",
            "NetworkTurnPass": "{TURN_PASS}",
            "NetworkHostRelayMode": "Fixed",
            "SessionDirectoryUrl": "{DIRECTORY_URL}",
            "SessionDirectoryCertSha256": "{DIRECTORY_PIN}"
          }
        },
        {
          "name": "client",
          "args": [
            "-input-script",
            "{INPUT_SCRIPT}"
          ],
          "menu_script": "mp-direct-vs-relay.relay.client.menu.txt",
          "input_script": "play-input.txt",
          "probe": "mp-direct-vs-relay.relay.client.probe.json",
          "settings": {
            "NetworkDisplayName": "Joiner",
            "NetworkIceEnable": "1",
            "NetworkShowDiagnostics": "1",
            "NetworkMatchStatusMode": "Always",
            "NetworkTurnServers": "{TURN_SERVER}",
            "NetworkTurnUser": "{TURN_USER}",
            "NetworkTurnPass": "{TURN_PASS}",
            "NetworkHostRelayMode": "Fixed",
            "SessionDirectoryUrl": "{DIRECTORY_URL}",
            "SessionDirectoryCertSha256": "{DIRECTORY_PIN}"
          },
          "start_when": {
            "peer": "host",
            "event": "video_mark relay-mp-lobby-host",
            "timeout_s": 90,
            "directory_listed": true
          }
        }
      ]
    }
  ],
  "checklist": [
    {
      "id": "direct-connection-host",
      "run": "direct",
      "peer": "host",
      "mark": "direct-connection-host",
      "screen": "SettingsScreen",
      "what": "The player selects Connection = Direct only on the Network Connection page.",
      "events": [
        "assert_label ComboNetworkConnection.*Direct only.*PASS"
      ]
    },
    {
      "id": "direct-route-host",
      "run": "direct",
      "peer": "host",
      "mark": "direct-mp-play-host",
      "screen": "game",
      "what": "The diagnostics overlay names the actual connected direct route while both players act.",
      "readback": [
        {
          "step": 4,
          "path": [
            "accepted"
          ],
          "equals": true
        },
        {
          "step": 4,
          "path": [
            "menu_observation"
          ],
          "contains": "via direct"
        },
        {
          "step": 3,
          "path": [
            "control",
            "visible"
          ],
          "equals": true
        },
        {
          "step": 3,
          "path": [
            "control",
            "text"
          ],
          "contains": "via direct"
        }
      ],
      "log_regex": [
        "\\[net-ice\\].*selected.*candidate=.*(host|srflx|prflx)",
        "\\[net-route\\].*RouteAllowed.*route=direct.*allowed=1"
      ],
      "assert": "Visible LabelNetMatchStatus connected-route readback, recorded assert_net_label, and both native transport lines."
    },
    {
      "id": "direct-candidate-host",
      "run": "direct",
      "peer": "host",
      "mark": "direct-mp-play-host",
      "screen": "game",
      "what": "The playing view is backed by a selected direct ICE candidate and an allowed transport route.",
      "log_regex": [
        "\\[net-ice\\].*selected.*candidate=.*(host|srflx|prflx)",
        "\\[net-route\\].*RouteAllowed.*route=direct.*allowed=1"
      ],
      "readback": [
        {
          "step": 4,
          "path": [
            "accepted"
          ],
          "equals": true
        },
        {
          "step": 4,
          "path": [
            "menu_observation"
          ],
          "contains": "via direct"
        },
        {
          "step": 3,
          "path": [
            "control",
            "visible"
          ],
          "equals": true
        },
        {
          "step": 3,
          "path": [
            "control",
            "text"
          ],
          "contains": "via direct"
        }
      ],
      "assert": "Visible LabelNetMatchStatus connected-route readback, recorded assert_net_label, and both native transport lines."
    },
    {
      "id": "direct-connection-client",
      "run": "direct",
      "peer": "client",
