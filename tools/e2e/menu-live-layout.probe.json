{
  "schema": 1,
  "timeout_ms": 80000,
  "steps": [
    {
      "op": "wait",
      "service": "Running",
      "sim_at_least": 150
    },
    {
      "op": "key_down",
      "key": "Escape"
    },
    {
      "op": "key_up",
      "key": "Escape"
    },
    {
      "op": "wait",
      "screen": "Pause",
      "elapsed_ms": 350
    },
    {
      "op": "menu",
      "command": "activate ButtonMatchOptions"
    },
    {
      "op": "wait",
      "screen": "PauseMatchOptions",
      "elapsed_ms": 400
    },
    {
      "op": "menu",
      "command": "video_mark pause-panel-background"
    },
    {
      "op": "menu",
      "command": "assert_opaque_panel MatchOptionsBox"
    },
    {
      "op": "menu",
      "command": "dump_host_options"
    },
    {
      "op": "wait",
      "elapsed_ms": 600
    },
    {
      "op": "menu",
      "command": "activate ButtonMatchOptionsClose"
    },
    {
      "op": "wait",
      "screen": "Pause",
      "elapsed_ms": 350
    },
    {
      "op": "menu",
      "command": "activate ButtonSettings"
    },
    {
      "op": "wait",
      "screen": "PauseSettings",
      "elapsed_ms": 350
    },
    {
      "op": "menu",
      "command": "video_mark pause-transition-Video"
    },
    {
      "op": "menu",
      "command": "select_settings_page Video"
    },
    {
      "op": "screenshot",
      "name": "pause-transition-Video-first"
    },
    {
      "op": "menu",
      "command": "dump_player_options"
    },
    {
      "op": "menu",
      "command": "assert_settings_page Video"
    },
    {
      "op": "menu",
      "command": "assert_visible CollectionBoxGameplaySettings 0"
    },
    {
      "op": "wait",
      "elapsed_ms": 350
    },
