    {
      "op": "signal",
      "name": "done"
    },
    {
      "op": "wait_file",
      "path": "{PROBE_DIR_host}/done.json"
    },
    {
      "op": "wait_file",
      "path": "{PROBE_DIR_client}/done.json"
    },
    {
      "op": "finish"
    }
