{
  "schema": 1,
  "name": "mp-host-draw-stall-menu",
  "port_base": 49479,
  "title": "A host whose frame draw is held 500 ms while its pause menu's Match Options is open keeps its round at 200 ms RTT with 3 peers, and every pause menu control reads the match service without touching the round inside an open plane window",
  "size": "640x360",
  "timeout_s": 300,
  "runs": [
    {
      "name": "menu-draw-500",
      "peers": [
        {
          "name": "host",
          "args": [
            "-net-match-service-e2e",
            "-net-port",
            "{PORT}",
            "-net-match-peers",
            "3",
            "-net-match-humans",
            "3",
            "-net-match-cpu-slots",
            "0",
            "-net-match-ticks",
            "2400",
            "-net-match-auto-delay",
            "-net-autosave-seconds",
            "0",
            "-num-lua-states",
            "4",
            "-seed",
            "42",
            "-input-script",
            "{INPUT_SCRIPT}",
            "-net-match-report",
            "{OUT}/host-match.json",
            "-out",
            "{OUT}/host_trace.json",
            "-tick-hashes",
            "-net-player-name",
            "host",
            "-net-host",
            "-selftest-draw-stall",
            "600:500"
          ],
          "input_script": "play-input.txt",
          "settings": {
            "NetworkSlowPlayerBoundTicks": "3",
            "NetworkSlowPlayerPolicy": "Substitute",
            "NetworkShowDiagnostics": "1",
            "NetworkMatchStatusMode": "Always"
          },
          "start_delay_s": 0,
          "probe": "mp-host-draw-stall-menu.host.probe.json"
        },
        {
          "name": "client",
          "args": [
            "-net-match-service-e2e",
            "-net-port",
            "{PORT}",
            "-net-match-peers",
            "3",
            "-net-match-humans",
            "3",
            "-net-match-cpu-slots",
            "0",
            "-net-match-ticks",
            "2400",
            "-net-match-auto-delay",
            "-net-autosave-seconds",
            "0",
            "-num-lua-states",
            "4",
            "-seed",
            "42",
            "-input-script",
            "{INPUT_SCRIPT}",
            "-net-match-report",
            "{OUT}/client-match.json",
            "-out",
            "{OUT}/client_trace.json",
            "-tick-hashes",
            "-net-player-name",
            "client",
            "-net-join",
            "127.0.0.1",
            "-net-fake-lag",
            "200"
          ],
          "input_script": "play-input.txt",
          "settings": {
            "NetworkSlowPlayerBoundTicks": "3",
            "NetworkSlowPlayerPolicy": "Substitute",
            "NetworkShowDiagnostics": "1",
            "NetworkMatchStatusMode": "Always"
          },
          "start_delay_s": 1
        },
        {
          "name": "survivor",
          "args": [
            "-net-match-service-e2e",
            "-net-port",
            "{PORT}",
            "-net-match-peers",
            "3",
            "-net-match-humans",
            "3",
            "-net-match-cpu-slots",
            "0",
            "-net-match-ticks",
            "2400",
            "-net-match-auto-delay",
            "-net-autosave-seconds",
            "0",
            "-num-lua-states",
            "4",
            "-seed",
            "42",
            "-input-script",
            "{INPUT_SCRIPT}",
            "-net-match-report",
            "{OUT}/survivor-match.json",
            "-out",
            "{OUT}/survivor_trace.json",
            "-tick-hashes",
            "-net-player-name",
            "survivor",
            "-net-join",
            "127.0.0.1",
            "-net-fake-lag",
            "200"
          ],
          "input_script": "play-input.txt",
          "settings": {
            "NetworkSlowPlayerBoundTicks": "3",
            "NetworkSlowPlayerPolicy": "Substitute",
            "NetworkShowDiagnostics": "1",
            "NetworkMatchStatusMode": "Always"
          },
          "start_delay_s": 5
        }
      ]
    }
  ],
  "checklist": [
    {
      "id": "menu-draw-500-host-plays-on",
      "run": "menu-draw-500",
      "peer": "host",
      "screen": [
        "PauseMatchOptions",
        "Pause",
        "PauseSettings",
        "PauseLeaveConfirm"
      ],
      "sim_ticks": [
        600,
        1200
      ],
      "what": "The host's draw is held 500 ms at tick 600 with Match Options open; the host's round plays on behind the pause menus its probe keeps open, with no unguarded access to the round.",
      "forbidden_log_regex": [
        "\\[net-plane\\] ASSERT",
        "unguarded coordinator access",
        "host lost",
        "now hosting",
        "Host left",
        "lockstep stopped",
        "desync at frame"
      ]
    },
    {
      "id": "menu-draw-500-client-plays-on",
      "run": "menu-draw-500",
      "peer": "client",
      "screen": "game",
      "sim_ticks": [
        600,
        1200
      ],
      "what": "The host's draw is held 500 ms at tick 600 with Match Options open; the client plays on with no unguarded access to the round.",
      "forbidden_log_regex": [
        "\\[net-plane\\] ASSERT",
        "unguarded coordinator access",
        "host lost",
        "now hosting",
        "Host left",
        "lockstep stopped",
        "desync at frame"
      ]
    },
    {
      "id": "menu-draw-500-survivor-plays-on",
      "run": "menu-draw-500",
      "peer": "survivor",
      "screen": "game",
      "sim_ticks": [
        600,
        1200
      ],
      "what": "The host's draw is held 500 ms at tick 600 with Match Options open; the survivor plays on with no unguarded access to the round.",
      "forbidden_log_regex": [
        "\\[net-plane\\] ASSERT",
        "unguarded coordinator access",
        "host lost",
        "now hosting",
        "Host left",
        "lockstep stopped",
        "desync at frame"
      ]
    },
    {
      "id": "menu-draw-500-client-completes-on-host-end",
      "run": "menu-draw-500",
      "peer": "client",
      "screen": "game",
      "sim_ticks": [
        1200,
        2400
      ],
      "what": "The host ends the match from its pause menu; the client completes the round on the host's word instead of reading the end as a broken match.",
      "log_regex": [
        "\\[net-match\\] completed_by_host_end=1 result=Match ended by host"
      ],
      "forbidden_log_regex": [
        "controller sync failed"
      ]
    },
    {
      "id": "menu-draw-500-survivor-completes-on-host-end",
      "run": "menu-draw-500",
      "peer": "survivor",
      "screen": "game",
      "sim_ticks": [
        1200,
        2400
      ],
      "what": "The host ends the match from its pause menu; the survivor completes the round on the host's word instead of reading the end as a broken match.",
      "log_regex": [
        "\\[net-match\\] completed_by_host_end=1 result=Match ended by host"
      ],
      "forbidden_log_regex": [
        "controller sync failed"
      ]
    }
  ]
}
