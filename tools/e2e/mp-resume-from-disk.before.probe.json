{
  "schema": 1,
  "timeout_ms": 150000,
  "steps": [
    {
      "op": "wait_file",
      "path": "{STAGE}/gameplay-started.json"
    },
    {
      "op": "menu",
      "command": "video_mark resume-play-before-drop"
    },
    {
      "op": "wait",
      "service": "Running",
      "sim_at_least": 400
    },
    {
      "op": "assert",
      "equals": {
        "service": "Running"
      },
      "sim_at_least": 400
    },
    {
      "op": "menu",
      "command": "video_mark resume-two-checkpoints"
    },
    {
      "op": "wait",
      "service": "Running",
      "sim_at_least": 550
    },
    {
      "op": "screenshot",
      "name": "before-drop"
    },
    {
      "op": "signal",
      "name": "ready-to-drop"
    },
    {
      "op": "finish"
    }
  ]
}
