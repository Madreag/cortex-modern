{
  "schema": 1,
  "timeout_ms": 200000,
  "steps": [
    {
      "op": "wait",
      "sim_at_least": 300
    },
    {
      "op": "key_down",
      "key": "Escape"
    },
    {
      "op": "key_up",
      "key": "Escape"
    },
    {
      "op": "wait",
      "screen": "Pause"
    },
    {
      "op": "assert",
      "equals": {
        "service": "Running"
      }
    },
    {
      "op": "menu",
      "command": "activate ButtonMatchOptions"
    },
    {
      "op": "wait",
      "screen": "PauseMatchOptions"
    },
    {
      "op": "menu",
      "command": "assert_visible ButtonMatchRepairNow 1"
    },
    {
      "op": "menu",
      "command": "assert_enabled ButtonMatchRepairNow 1"
    },
    {
      "op": "menu",
      "command": "dump_host_options"
    },
    {
      "op": "wait",
      "sim_at_least": 700
    },
    {
      "op": "menu",
      "command": "activate ButtonMatchRepairNow"
    },
    {
      "op": "wait",
      "renders": 2
    },
    {
      "op": "menu",
      "command": "assert_label LabelMatchRepairHint Every peer pauses and reloads the host's snapshot - press again"
    },
    {
      "op": "menu",
      "command": "activate ButtonMatchOptionsClose"
    },
    {
      "op": "wait",
      "screen": "Pause"
    },
    {
      "op": "menu",
      "command": "activate ButtonPauseMatch"
    },
    {
      "op": "wait",
      "elapsed_ms": 1500
    },
    {
      "op": "menu",
      "command": "activate ButtonPauseMatch"
    },
    {
      "op": "wait",
      "elapsed_ms": 1500
    },
    {
      "op": "menu",
      "command": "activate ButtonSettings"
    },
    {
      "op": "wait",
      "screen": "PauseSettings"
    },
    {
      "op": "menu",
      "command": "select_settings_page Gameplay"
    },
    {
      "op": "wait",
      "renders": 3
    },
    {
      "op": "menu",
      "command": "post_command ButtonBackToMainMenu"
    },
    {
      "op": "wait",
      "screen": "Pause"
    },
    {
      "op": "menu",
      "command": "activate ButtonLeaveMatch"
    },
    {
      "op": "wait",
      "screen": "PauseLeaveConfirm"
    },
    {
      "op": "menu",
      "command": "activate ButtonLeaveCancel"
    },
    {
      "op": "wait",
      "screen": "Pause"
    },
    {
      "op": "menu",
      "command": "activate ButtonMatchOptions"
    },
    {
      "op": "wait",
      "screen": "PauseMatchOptions"
    },
    {
      "op": "menu",
      "command": "activate ButtonMatchRepairNow"
    },
    {
      "op": "wait",
      "renders": 2
    },
    {
      "op": "menu",
      "command": "activate ButtonMatchRepairNow"
    },
    {
      "op": "wait",
      "elapsed_ms": 4000
    },
    {
      "op": "menu",
      "command": "activate ButtonMatchOptionsClose"
    },
    {
      "op": "wait",
      "screen": "Pause"
    },
    {
      "op": "wait",
      "elapsed_ms": 4000
    },
    {
      "op": "signal",
      "name": "done"
    },
    {
      "op": "menu",
      "command": "activate ButtonEndMatch"
    }
  ]
}
