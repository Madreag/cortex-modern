{
  "schema": 1,
  "timeout_ms": 175000,
  "steps": [
    {
      "op": "wait",
      "screen": "Gameplay",
      "lockstep_frame_at_least": 5
    },
    {
      "op": "screenshot",
      "name": "vw_start",
      "composited": true
    },
    {
      "op": "wait",
      "lockstep_frame_at_least": 30
    },
    {
      "op": "screenshot",
      "name": "vw_start_ready",
      "composited": true
    },
    {
      "op": "wait",
      "lockstep_frame_at_least": 330
    },
    {
      "op": "screenshot",
      "name": "vw_ship",
      "composited": true
    },
    {
      "op": "menu",
      "command": "video_mark vw-mp-play-host"
    },
    {
      "op": "wait",
      "service": "Running",
      "elapsed_ms": 10500,
      "lockstep_frame_at_least": 2500
    },
    {
      "op": "screenshot",
      "name": "vw_played",
      "composited": true
    },
    {
      "op": "key_down",
      "key": "Escape"
    },
    {
      "op": "key_up",
      "key": "Escape"
    },
    {
      "op": "wait",
      "screen": "Pause",
      "elapsed_ms": 400
    },
    {
      "op": "menu",
      "command": "video_mark vw-mp-pause-host"
    },
    {
      "op": "assert",
      "equals": {
        "service": "Running",
        "paused": false
      }
    },
    {
      "op": "menu",
      "command": "assert_visible ButtonLeaveMatch 1"
    },
    {
      "op": "menu",
      "command": "assert_visible ButtonMatchOptions 1"
    },
    {
      "op": "menu",
      "command": "assert_visible ButtonEndMatch 1"
    },
    {
      "op": "menu",
      "command": "assert_enabled ButtonEndMatch 1"
    },
    {
      "op": "menu",
      "command": "assert_text_fits ButtonEndMatch"
    },
    {
      "op": "wait",
      "elapsed_ms": 660
    },
    {
      "op": "menu",
      "command": "activate ButtonMatchOptions"
    },
    {
      "op": "wait",
      "screen": "PauseMatchOptions",
      "elapsed_ms": 400
    },
    {
      "op": "menu",
      "command": "video_mark vw-mp-match-options-host"
    },
    {
      "op": "menu",
      "command": "assert_rect_inside MatchOptionsBox viewport"
    },
    {
      "op": "menu",
      "command": "assert_visible ButtonMatchRepairNow 1"
    },
    {
      "op": "menu",
      "command": "dump_host_options"
    },
    {
      "op": "wait",
      "elapsed_ms": 825
    },
    {
      "op": "menu",
      "command": "activate ButtonMatchOptionsClose"
    },
    {
      "op": "wait",
      "screen": "Pause",
      "elapsed_ms": 400
    },
    {
      "op": "menu",
      "command": "video_mark vw-mp-end-match"
    },
    {
      "op": "menu",
      "command": "activate ButtonResume"
    },
    {
      "op": "wait",
      "screen": "Gameplay"
    },
    {
      "op": "wait",
      "elapsed_ms": 500
    },
    {
      "op": "key_down",
      "key": "Escape"
    },
    {
      "op": "key_up",
      "key": "Escape"
    },
    {
      "op": "wait",
      "screen": "Pause",
      "elapsed_ms": 400
    },
    {
      "op": "menu",
      "command": "video_mark vw-mp-end-match"
    },
    {
      "op": "wait",
      "elapsed_ms": 660
    },
    {
      "op": "menu",
      "command": "activate ButtonEndMatch"
    },
    {
      "op": "wait",
      "screen": "PauseLeaveConfirm",
      "renders": 4,
      "scope": "menu"
    },
    {
      "op": "assert",
      "equals": {
        "service": "Running",
        "screen": "PauseLeaveConfirm"
      },
      "scope": "menu"
    },
    {
      "op": "assert_control",
      "control": "LabelLeaveConfirm",
      "text_contains": "all players",
      "fits": true,
      "scope": "menu"
    },
    {
      "op": "menu",
      "command": "activate ButtonLeaveConfirm",
      "scope": "menu"
    },
    {
      "op": "wait",
      "elapsed_ms": 3000,
      "scope": "menu"
    },
    {
      "op": "assert",
      "equals": {
        "service": "Starting"
      },
      "scope": "menu"
    },
    {
      "op": "wait",
      "elapsed_ms": 1980,
      "scope": "menu"
    },
    {
      "op": "signal",
      "name": "done",
      "scope": "menu"
    },
    {
      "op": "finish"
    }
  ]
}
