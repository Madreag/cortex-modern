{
  "schema": 1,
  "name": "mp-rollback-lag",
  "title": "V1 feel gate at 100 and 200 ms with five percent loss, a silent seat and a ticket rejoin",
  "port_base": 49464,
  "size": "960x540",
  "timeout_s": 150,
