      "peers": [
        {
          "name": "host",
          "args": [
            "-net-match-service-e2e",
            "-net-port",
            "{PORT}",
            "-net-match-peers",
            "3",
            "-net-match-humans",
            "3",
            "-net-match-cpu-slots",
            "0",
            "-net-match-ticks",
            "1200",
            "-net-match-auto-delay",
            "-net-autosave-seconds",
            "0",
            "-num-lua-states",
            "4",
            "-seed",
            "42",
            "-input-script",
            "{INPUT_SCRIPT}",
            "-net-match-report",
            "{OUT}/host_report.json",
            "-out",
            "{OUT}/host_trace.json",
            "-tick-hashes",
            "-net-player-name",
            "host",
            "-net-host",
            "-net-match-service-preset",
            "Determinism FeelBaseline",
            "-net-match-service-module",
            "UserScenes.rte",
            "-net-fake-lag",
            "0",
            "-net-local-prediction",
            "on",
            "-feel-measure",
            "{VIDEO}/../feel",
            "-feel-render-settings",
            "{VIDEO}/../runtime/Userdata/FeelRender.ini",
            "-net-reconnect-ticket",
            "{OUT}/host.ticket"
