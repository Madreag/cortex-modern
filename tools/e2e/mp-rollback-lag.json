    {
      "id": "lag-100-item9a_wall_tps",
      "what": "The fast peer sustains the existing feel gate throughput.",
      "screen": "game",
      "assert": "unchanged tools/feel/report.py item9a_gates",
      "peer": "host",
      "run": "lag-100",
      "sim_ticks": [
        300,
        1200
      ],
      "gate": "item9a_wall_tps"
    },
    {
      "id": "lag-100-item9a_net_wait",
      "what": "The fast peer spends less than one percent of steady wall time waiting.",
      "screen": "game",
      "assert": "unchanged tools/feel/report.py item9a_gates",
      "peer": "host",
      "run": "lag-100",
      "sim_ticks": [
        300,
        1200
      ],
      "gate": "item9a_net_wait"
    },
    {
