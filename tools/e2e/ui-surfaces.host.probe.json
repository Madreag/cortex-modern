{
  "schema": 1,
  "timeout_ms": 150000,
  "steps": [
    {
      "op": "wait_file",
      "path": "{STAGE}/gameplay-started.json"
    },
    {
      "op": "wait",
      "service": "Running",
      "elapsed_ms": 1000
    },
    {
      "op": "key_down",
      "key": "P",
      "sim_at_least": 1
    },
    {
      "op": "key_up",
      "key": "P",
      "sim_at_least": 1
    },
    {
      "op": "wait",
      "elapsed_ms": 300
    },
    {
      "op": "key_down",
      "key": "F6"
    },
    {
      "op": "key_up",
      "key": "F6"
    },
    {
      "op": "wait",
      "panel_open": true
    },
    {
      "op": "menu",
      "command": "video_mark ui-f6-overlay"
    },
    {
      "op": "wait",
      "elapsed_ms": 990
    },
    {
      "op": "mouse_down",
      "control": "NetworkSeatsOptions"
    },
    {
      "op": "mouse_up",
      "control": "NetworkSeatsOptions"
    },
    {
      "op": "menu",
      "command": "video_mark ui-f6-options"
    },
    {
      "op": "wait",
      "control": "NetworkSeatsOptionsText",
      "equals": {
        "visible": true
      }
    },
    {
      "op": "assert_control",
      "control": "NetworkSeatsOptionsText",
      "text_contains": "Frame redundancy:"
    },
    {
      "op": "menu",
      "command": "assert_vertical_scroll NetworkSeatsOptionsText"
    },
    {
      "op": "wait",
      "elapsed_ms": 7000
    },
    {
      "op": "key_down",
      "key": "F6"
    },
    {
      "op": "key_up",
      "key": "F6"
    },
    {
      "op": "wait",
      "panel_open": false
    },
    {
      "op": "key_down",
      "key": "Escape"
    },
    {
      "op": "key_up",
      "key": "Escape"
    },
    {
      "op": "wait",
      "screen": "Pause",
      "elapsed_ms": 450
    },
    {
      "op": "menu",
      "command": "assert_visible ButtonLeaveMatch 1"
    },
    {
      "op": "menu",
      "command": "assert_visible ButtonMatchOptions 1"
    },
    {
      "op": "menu",
      "command": "assert_visible ButtonSettings 1"
    },
    {
      "op": "menu",
      "command": "assert_visible ButtonSaveDiagnostics 1"
    },
    {
      "op": "menu",
      "command": "assert_text_fits ButtonLeaveMatch"
    },
    {
      "op": "menu",
      "command": "assert_text_fits ButtonMatchOptions"
    },
    {
      "op": "wait",
      "elapsed_ms": 450
    },
    {
      "op": "menu",
      "command": "activate ButtonMatchOptions"
    },
    {
      "op": "wait",
      "screen": "PauseMatchOptions",
      "elapsed_ms": 450
    },
    {
      "op": "menu",
      "command": "video_mark ui-pause-match-options"
    },
    {
      "op": "menu",
      "command": "assert_rect_inside MatchOptionsBox viewport"
    },
    {
      "op": "menu",
      "command": "assert_rect_inside LabelMatchOptionsTitle MatchOptionsBox"
    },
    {
      "op": "menu",
      "command": "assert_rect_inside LabelMatchOptions MatchOptionsBox"
    },
    {
      "op": "menu",
      "command": "assert_rect_inside LabelMatchRepairHint MatchOptionsBox"
    },
    {
      "op": "menu",
      "command": "assert_rect_inside ButtonMatchOptionsClose MatchOptionsBox"
    },
    {
      "op": "menu",
      "command": "dump_host_options"
    },
    {
      "op": "wait",
      "elapsed_ms": 600
    },
    {
      "op": "menu",
      "command": "activate ButtonMatchOptionsClose"
    },
    {
      "op": "wait",
      "screen": "Pause",
      "elapsed_ms": 450
    },
    {
      "op": "menu",
      "command": "activate ButtonSettings"
    },
    {
      "op": "wait",
      "screen": "PauseSettings",
      "elapsed_ms": 450
    },
    {
      "op": "menu",
      "command": "select_settings_page Video"
    },
    {
      "op": "wait",
      "elapsed_ms": 450
    },
    {
      "op": "menu",
      "command": "assert_settings_page Video"
    },
    {
      "op": "menu",
      "command": "select_settings_page Gameplay"
    },
    {
      "op": "wait",
      "elapsed_ms": 450
    },
    {
      "op": "menu",
      "command": "assert_settings_page Gameplay"
    },
    {
      "op": "menu",
      "command": "dump_player_options"
    },
    {
      "op": "menu",
      "command": "post_command ButtonBackToMainMenu"
    },
    {
      "op": "wait",
      "screen": "Pause",
      "elapsed_ms": 450
    },
    {
      "op": "wait",
      "elapsed_ms": 450
    },
    {
      "op": "menu",
      "command": "activate ButtonPauseMatch"
    },
    {
      "op": "wait",
      "elapsed_ms": 300
    },
    {
      "op": "menu",
      "command": "activate ButtonResume"
    },
    {
      "op": "wait",
      "screen": "Gameplay"
    },
    {
      "op": "wait",
      "elapsed_ms": 450
    },
    {
      "op": "key_down",
      "key": "Escape"
    },
    {
      "op": "key_up",
      "key": "Escape"
    },
    {
      "op": "wait",
      "screen": "Pause",
      "elapsed_ms": 450
    },
    {
      "op": "menu",
      "command": "activate ButtonLeaveMatch"
    },
    {
      "op": "wait",
      "screen": "PauseLeaveConfirm",
      "elapsed_ms": 450
    },
    {
      "op": "menu",
      "command": "video_mark ui-leave-confirm"
    },
    {
      "op": "menu",
      "command": "assert_visible ButtonLeaveConfirm 1"
    },
    {
      "op": "wait",
      "elapsed_ms": 600
    },
    {
      "op": "menu",
      "command": "activate ButtonLeaveCancel"
    },
    {
      "op": "wait",
      "screen": "Pause",
      "elapsed_ms": 450,
      "scope": "menu"
    },
    {
      "op": "wait",
      "elapsed_ms": 450,
      "scope": "menu"
    },
    {
      "op": "signal",
      "name": "done",
      "scope": "menu"
    },
    {
      "op": "wait_file",
      "path": "{PROBE_DIR_client}/done.json",
      "scope": "menu"
    },
    {
      "op": "menu",
      "command": "video_mark ui-host-leave"
    },
    {
      "op": "menu",
      "command": "activate ButtonLeaveMatch"
    },
    {
      "op": "wait",
      "screen": "PauseLeaveConfirm",
      "elapsed_ms": 450,
      "scope": "menu"
    },
    {
      "op": "menu",
      "command": "activate ButtonLeaveConfirm"
    },
    {
      "op": "wait",
      "service": "Completed",
      "scope": "menu"
    },
    {
      "op": "finish"
    }
  ]
}
