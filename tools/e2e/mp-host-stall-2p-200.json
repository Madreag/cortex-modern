  "checklist": [
    {
      "id": "stall-100-client-keeps-its-host",
      "run": "stall-100",
      "peer": "client",
      "screen": "game",
      "sim_ticks": [
        600,
        1200
      ],
      "what": "The client waits out the host's 100 ms stall at 200 ms RTT and plays on under the same host.",
      "forbidden_log_regex": [
        "host lost",
        "now hosting",
        "Host left",
        "resync failed",
        "lockstep stopped"
      ]
    },
    {
      "id": "stall-100-host-plays-on",
      "run": "stall-100",
      "peer": "host",
      "screen": "game",
      "sim_ticks": [
        600,
        1200
      ],
      "what": "The host stalls 100 ms at tick 600 and keeps hosting.",
      "log_regex": [
        "\\[selftest\\] frame stall tick=600"
      ],
