  "checklist": [
    {
      "id": "draw-800-host-plays-on",
      "run": "draw-800",
      "peer": "host",
      "screen": "game",
      "sim_ticks": [
        600,
        1200
      ],
      "what": "The host is held 800 ms at present at tick 600; the host plays on under the same host.",
      "forbidden_log_regex": [
        "host lost",
        "now hosting",
