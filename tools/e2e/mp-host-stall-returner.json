  "checklist": [
    {
      "id": "ret-540-500-host-in-sync",
      "run": "ret-540-500",
      "peer": "host",
      "screen": "game",
      "sim_ticks": [
        500,
        1200
      ],
      "what": "The host stalls 1000 ms at 600 while the client, stalled 500 ms at 540, returns in place during the host's hold; the host plays on in sync.",
      "forbidden_log_regex": [
        "desync at frame",
        "lockstep stopped",
        "host lost",
        "now hosting",
        "resync failed"
