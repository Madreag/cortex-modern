{
  "schema": 1,
  "timeout_ms": 170000,
  "steps": [
    {
      "op": "wait_file",
      "path": "{STAGE}/gameplay-started.json"
    },
    {
      "op": "wait",
      "sim_at_least": 180
    },
    {
      "op": "menu",
      "command": "video_mark sp-feel-baseline"
    },
    {
      "op": "key_down",
      "key": "Escape"
    },
    {
      "op": "key_up",
      "key": "Escape"
    },
    {
      "op": "wait",
      "screen": "Pause",
      "elapsed_ms": 400
    },
    {
      "op": "menu",
      "command": "assert_visible ButtonResume 1"
    },
    {
      "op": "menu",
      "command": "assert_visible ButtonSettings 1"
    },
    {
      "op": "menu",
      "command": "assert_visible ButtonBackToMain 1"
    },
    {
      "op": "menu",
      "command": "assert_visible ButtonSaveOrLoadGame 1"
    },
    {
      "op": "menu",
      "command": "assert_visible ButtonModManager 1"
    },
    {
      "op": "menu",
      "command": "assert_rect_inside ButtonResume PauseScreen"
    },
    {
      "op": "menu",
      "command": "assert_rect_inside ButtonSettings PauseScreen"
    },
    {
      "op": "menu",
      "command": "assert_rect_inside ButtonBackToMain PauseScreen"
    },
    {
      "op": "menu",
      "command": "assert_text_fits ButtonResume"
    },
    {
      "op": "menu",
      "command": "assert_text_fits ButtonBackToMain"
    },
    {
      "op": "wait",
      "elapsed_ms": 660
    },
    {
      "op": "menu",
      "command": "activate ButtonSettings"
    },
    {
      "op": "wait",
      "screen": "PauseSettings",
      "elapsed_ms": 400
    },
    {
      "op": "menu",
      "command": "select_settings_page Video"
    },
    {
      "op": "wait",
      "elapsed_ms": 660
    },
    {
      "op": "menu",
      "command": "assert_settings_page Video"
    },
    {
      "op": "menu",
      "command": "assert_visible CollectionBoxVideoSettings 1"
    },
    {
      "op": "menu",
      "command": "select_settings_page Audio"
    },
    {
      "op": "wait",
      "elapsed_ms": 660
    },
    {
      "op": "menu",
      "command": "assert_settings_page Audio"
    },
    {
      "op": "menu",
      "command": "assert_visible CollectionBoxAudioSettings 1"
    },
    {
      "op": "menu",
      "command": "select_settings_page Input"
    },
    {
      "op": "wait",
      "elapsed_ms": 660
    },
    {
      "op": "menu",
      "command": "assert_settings_page Input"
    },
    {
      "op": "menu",
      "command": "assert_visible CollectionBoxInputSettings 1"
    },
    {
      "op": "menu",
      "command": "select_settings_page Gameplay"
    },
    {
      "op": "wait",
      "elapsed_ms": 660
    },
    {
      "op": "menu",
      "command": "assert_settings_page Gameplay"
    },
    {
      "op": "menu",
      "command": "assert_visible CollectionBoxGameplaySettings 1"
    },
    {
      "op": "menu",
      "command": "select_settings_page Misc"
    },
    {
      "op": "wait",
      "elapsed_ms": 660
    },
    {
      "op": "menu",
      "command": "assert_settings_page Misc"
    },
    {
      "op": "menu",
      "command": "assert_visible CollectionBoxMiscSettings 1"
    },
    {
      "op": "menu",
      "command": "post_command ButtonBackToMainMenu"
    },
    {
      "op": "wait",
      "screen": "Pause",
      "elapsed_ms": 400
    },
    {
      "op": "wait",
      "elapsed_ms": 660
    },
    {
      "op": "menu",
      "command": "activate ButtonResume"
    },
    {
      "op": "wait",
      "screen": "Gameplay"
    },
    {
      "op": "wait",
      "sim_at_least": 900
    },
    {
      "op": "signal",
      "name": "done"
    },
    {
      "op": "finish"
    }
  ]
}
