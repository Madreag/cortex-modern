{
  "schema": 1,
  "name": "world-late-join",
  "port_base": 49430,
  "title": "A dedicated persistent world: one client plays and leaves, a second joins late into the world's state",
  "size": "960x540",
  "timeout_s": 480,
  "peers": [
    {
      "name": "world",
      "args": [
        "-net-dedicated",
        "-net-port",
        "{PORT}",
        "-net-match-peers",
        "3",
        "-net-match-input-delay",
        "3",
        "-net-autosave-seconds",
        "1",
        "-net-match-ticks",
        "4200",
        "-max-ticks",
        "4200",
        "-net-match-report",
        "{OUT}/world-report.json",
        "-net-persistent-world",
        "-net-world-fresh",
        "-net-live-tick-hashes",
        "{OUT}/world-live.jsonl"
      ],
      "settings": {
        "NetworkDisplayName": "World"
      }
    },
    {
      "name": "client-first",
      "args": [
        "-net-match-service-e2e",
        "-net-join",
        "127.0.0.1",
        "-net-port",
        "{PORT}",
        "-net-match-peers",
        "3",
        "-net-match-input-delay",
        "3",
        "-net-autosave-seconds",
        "1",
        "-net-match-ticks",
        "1400",
        "-max-ticks",
        "1400",
        "-input-script",
        "{INPUT_SCRIPT}",
        "-net-reconnect-ticket",
        "{OUT}/first.ticket",
        "-net-match-report",
        "{OUT}/first-report.json",
        "-net-live-tick-hashes",
        "{OUT}/client-first-live.jsonl"
      ],
      "input_script": "play-input.txt",
      "settings": {
        "NetworkDisplayName": "Settler"
      },
      "start_delay_s": 6.0
    },
    {
      "name": "client-late",
      "args": [
        "-net-match-service-e2e",
        "-net-join",
        "127.0.0.1",
        "-net-port",
        "{PORT}",
        "-net-match-peers",
        "3",
        "-net-match-input-delay",
        "3",
        "-net-autosave-seconds",
        "1",
        "-net-match-ticks",
        "1400",
        "-max-ticks",
        "1400",
        "-input-script",
        "{INPUT_SCRIPT}",
        "-net-reconnect-ticket",
        "{OUT}/late.ticket",
        "-net-match-report",
        "{OUT}/late-report.json",
        "-net-live-tick-hashes",
        "{OUT}/client-late-live.jsonl"
      ],
      "input_script": "play-input.txt",
      "settings": {
        "NetworkDisplayName": "Latecomer"
      },
      "start_when": {
        "peer": "world",
        "sim_tick": 1800,
        "timeout_s": 100
      }
    }
  ],
  "checklist": [
    {
      "id": "pw-world-up",
      "peer": "world",
      "screen": "game",
      "sim_ticks": [
        0,
        4200
      ],
      "what": "the dedicated world host runs without a menu and keeps ticking across both clients' visits",
      "assert": "world report: the match runs to its tick cap",
      "gate": "scenario-behavior"
    },
    {
      "id": "pw-first-join",
      "peer": "client-first",
      "screen": "game",
      "sim_ticks": [
        30,
        1400
      ],
      "what": "the first client joins the running world and plays in it",
      "assert": "first report plus the world's seat rows",
      "gate": "scenario-behavior"
    },
    {
      "id": "pw-first-leave",
      "peer": "world",
      "screen": "game",
      "sim_ticks": [
        1400,
        2600
      ],
      "what": "the first client leaves and the world keeps its state, its seat held for it (the AI plays it) and no error",
      "assert": "world report between the two visits",
      "gate": "scenario-behavior"
    },
    {
      "id": "pw-late-join",
      "peer": "client-late",
      "screen": "game",
      "what": "the late joiner takes the free slot - not the held one - and is given the world as the first client left it: terrain, actors and objectives all carried over, not a fresh scene",
      "assert": "Native snapshot transfer and load evidence; the first recorded tick is the restored world tick, not a new zero-based client counter. Continued play remains subject to the peer result.",
      "service_state": "Running",
      "log_regex": [
        "\\[net-match\\] state transfer complete: \\d+ bytes",
        "\\[snapbench\\] read_ms=\\d+"
      ],
      "gate": "scenario-behavior"
    },
    {
      "id": "pw-late-video-agrees",
      "peer": "client-late",
      "screen": "game",
      "what": "the late joiner's first frames show the same world the host's video shows at that tick",
      "assert": "compare the two contact sheets at the same sim tick"
    },
    {
      "id": "pw-fresh-world-flag",
      "what": "a run that starts the world from scratch (-net-world-fresh) is part of this scenario",
      "assert": "launch.json carries -net-persistent-world and -net-world-fresh; frames show the fresh world",
      "peer": "world",
      "screen": "game",
      "gate": "scenario-behavior"
    },
    {
      "id": "pw-left-seat-held",
      "peer": "world",
      "screen": "game",
      "sim_ticks": [
        1400,
        4200
      ],
      "what": "The first client's seat stays held for it after its leave while the late joiner plays in the free slot: the world never releases it.",
      "assert": "world log: the first client's seat held, never released",
      "log_regex": [
        "\\[net-match\\] hold peer=2 frame=\\d+ AI in control"
      ],
      "forbidden_log_regex": [
        "seat released peer=2"
      ],
      "gate": "scenario-behavior"
    }
  ],
  "behavior_gate": {
    "kind": "world-continuity",
    "late_tick": 1800,
    "reports": {
      "world": "world-report.json",
      "client-first": "first-report.json",
      "client-late": "late-report.json"
    },
    "ticks": {
      "world": 4200,
      "client-first": 1400,
      "client-late": 1400
    }
  }
}
