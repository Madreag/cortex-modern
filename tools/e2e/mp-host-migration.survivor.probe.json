{
  "schema": 1,
  "timeout_ms": 140000,
  "steps": [
    {
      "op": "wait_file",
      "path": "{STAGE}/gameplay-started.json"
    },
    {
      "op": "menu",
      "command": "video_mark migration-play"
    },
    {
      "op": "wait",
      "service": "Running",
      "sim_at_least": 550
    },
    {
      "op": "menu",
      "command": "video_mark migration-host-drop"
    },
    {
      "op": "wait",
      "control": "LabelNetMatchStatus",
      "text_contains": "Host connection lost - choosing a new host",
      "equals": {
        "visible": true
      }
    },
    {
      "op": "menu",
      "command": "video_mark migration-loss-overlay"
    },
    {
      "op": "screenshot",
      "name": "host-loss"
    },
    {
      "op": "wait",
      "control": "LabelNetMatchHandoverToast",
      "text_contains": "Host left - ClientA is now hosting",
      "equals": {
        "visible": true
      }
    },
    {
      "op": "menu",
      "command": "video_mark migration-new-host"
    },
    {
      "op": "assert_control",
      "control": "LabelNetMatchHandoverToast",
      "text_contains": "Host left - ClientA is now hosting"
    },
    {
      "op": "menu",
      "command": "dump_network_layout"
    },
    {
      "op": "screenshot",
      "name": "new-host"
    },
    {
      "op": "wait",
      "elapsed_ms": 800
    },
    {
      "op": "menu",
      "command": "video_mark migration-continued"
    },
    {
      "op": "wait",
      "service": "Running",
      "sim_at_least": 880
    },
    {
      "op": "assert",
      "equals": {
        "service": "Running"
      },
      "sim_at_least": 880
    },
    {
      "op": "screenshot",
      "name": "continued"
    },
    {
      "op": "finish"
    }
  ]
}
