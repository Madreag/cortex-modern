{
  "schema": 1,
  "timeout_ms": 175000,
  "steps": [
    {
      "op": "wait_file",
      "path": "{STAGE}/gameplay-started.json"
    },
    {
      "op": "menu",
      "command": "video_mark mp-play-host"
    },
    {
      "op": "wait",
      "service": "Running",
      "elapsed_ms": 6000
    },
    {
      "op": "key_down",
      "key": "Escape"
    },
    {
      "op": "key_up",
      "key": "Escape"
    },
    {
      "op": "wait",
      "screen": "Pause",
      "elapsed_ms": 400
    },
    {
      "op": "menu",
      "command": "video_mark mp-pause-host"
    },
    {
      "op": "wait",
      "elapsed_ms": 500
    },
    {
      "op": "assert",
      "equals": {
        "service": "Running",
        "paused": false
      }
    },
    {
      "op": "menu",
      "command": "assert_visible ButtonLeaveMatch 1"
    },
    {
      "op": "menu",
      "command": "assert_visible ButtonMatchOptions 1"
    },
    {
      "op": "menu",
      "command": "assert_visible ButtonEndMatch 1"
    },
    {
      "op": "menu",
      "command": "assert_enabled ButtonEndMatch 1"
    },
    {
      "op": "menu",
      "command": "assert_text_fits ButtonEndMatch"
    },
    {
      "op": "menu",
      "command": "activate ButtonMatchOptions"
    },
    {
      "op": "wait",
      "screen": "PauseMatchOptions",
      "elapsed_ms": 400
    },
    {
      "op": "menu",
      "command": "video_mark mp-match-options-host"
    },
    {
      "op": "menu",
      "command": "assert_rect_inside MatchOptionsBox viewport"
    },
    {
      "op": "menu",
      "command": "assert_visible ButtonMatchRepairNow 1"
    },
    {
      "op": "menu",
      "command": "dump_host_options"
    },
    {
      "op": "wait",
      "elapsed_ms": 825
    },
    {
      "op": "menu",
      "command": "activate ButtonMatchOptionsClose"
    },
    {
      "op": "wait",
      "screen": "Pause",
      "elapsed_ms": 400
    },
    {
      "op": "menu",
      "command": "video_mark mp-resume-host"
    },
    {
      "op": "menu",
      "command": "activate ButtonResume"
    },
    {
      "op": "wait",
      "screen": "Gameplay"
    },
    {
      "op": "wait",
      "elapsed_ms": 500
    },
    {
      "op": "key_down",
      "key": "Escape"
    },
    {
      "op": "key_up",
      "key": "Escape"
    },
    {
      "op": "wait",
      "screen": "Pause",
      "elapsed_ms": 400
    },
    {
      "op": "menu",
      "command": "video_mark mp-end-match"
    },
    {
      "op": "wait",
      "elapsed_ms": 660
    },
    {
      "op": "menu",
      "command": "activate ButtonEndMatch"
    },
    {
      "op": "wait",
      "elapsed_ms": 3000,
      "scope": "menu"
    },
    {
      "op": "assert",
      "equals": {
        "service": "Starting"
      },
      "scope": "menu"
    },
    {
      "op": "wait",
      "elapsed_ms": 1980,
      "scope": "menu"
    },
    {
      "op": "signal",
      "name": "done",
      "scope": "menu"
    },
    {
      "op": "finish"
    }
  ]
}
