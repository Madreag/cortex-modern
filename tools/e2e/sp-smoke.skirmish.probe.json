{
  "schema": 1,
  "timeout_ms": 85000,
  "steps": [
    {
      "op": "wait_file",
      "path": "{STAGE}/gameplay-started.json"
    },
    {
      "op": "wait",
      "screen": "Gameplay",
      "sim_at_least": 120
    },
    {
      "op": "key_down",
      "key": "Escape"
    },
    {
      "op": "key_up",
      "key": "Escape"
    },
    {
      "op": "wait",
      "screen": "Pause",
      "elapsed_ms": 400
    },
    {
      "op": "menu",
      "command": "video_mark sp-pause-menu"
    },
    {
      "op": "menu",
      "command": "assert_visible ButtonResume 1"
    },
    {
      "op": "menu",
      "command": "assert_visible ButtonSettings 1"
    },
    {
      "op": "menu",
      "command": "assert_visible ButtonSaveOrLoadGame 1"
    },
    {
      "op": "menu",
      "command": "assert_visible ButtonModManager 1"
    },
    {
      "op": "menu",
      "command": "assert_visible ButtonBackToMain 1"
    },
    {
      "op": "wait",
      "elapsed_ms": 800
    },
    {
      "op": "menu",
      "command": "activate ButtonSettings"
    },
    {
      "op": "wait",
      "screen": "PauseSettings",
      "elapsed_ms": 400
    },
    {
      "op": "menu",
      "command": "select_settings_page Video"
    },
    {
      "op": "menu",
      "command": "video_mark sp-pause-video"
    },
    {
      "op": "wait",
      "elapsed_ms": 700
    },
    {
      "op": "menu",
      "command": "assert_settings_page Video"
    },
    {
      "op": "menu",
      "command": "assert_visible CollectionBoxVideoSettings 1"
    },
    {
      "op": "menu",
      "command": "select_settings_page Audio"
    },
    {
      "op": "menu",
      "command": "video_mark sp-pause-audio"
    },
    {
      "op": "wait",
      "elapsed_ms": 700
    },
    {
      "op": "menu",
      "command": "assert_settings_page Audio"
    },
    {
      "op": "menu",
      "command": "assert_visible CollectionBoxAudioSettings 1"
    },
    {
      "op": "menu",
      "command": "select_settings_page Input"
    },
    {
      "op": "menu",
      "command": "video_mark sp-pause-input"
    },
    {
      "op": "wait",
      "elapsed_ms": 700
    },
    {
      "op": "menu",
      "command": "assert_settings_page Input"
    },
    {
      "op": "menu",
      "command": "assert_visible CollectionBoxInputSettings 1"
    },
    {
      "op": "menu",
      "command": "select_settings_page Gameplay"
    },
    {
      "op": "menu",
      "command": "video_mark sp-pause-gameplay"
    },
    {
      "op": "wait",
      "elapsed_ms": 700
    },
    {
      "op": "menu",
      "command": "assert_settings_page Gameplay"
    },
    {
      "op": "menu",
      "command": "assert_visible CollectionBoxGameplaySettings 1"
    },
    {
      "op": "menu",
      "command": "select_settings_page Misc"
    },
    {
      "op": "menu",
      "command": "video_mark sp-pause-misc"
    },
    {
      "op": "wait",
      "elapsed_ms": 700
    },
    {
      "op": "menu",
      "command": "assert_settings_page Misc"
    },
    {
      "op": "menu",
      "command": "assert_visible CollectionBoxMiscSettings 1"
    },
    {
      "op": "menu",
      "command": "post_command ButtonBackToMainMenu"
    },
    {
      "op": "wait",
      "screen": "Pause",
      "elapsed_ms": 400
    },
    {
      "op": "menu",
      "command": "activate ButtonResume"
    },
    {
      "op": "wait",
      "screen": "Gameplay"
    },
    {
      "op": "menu",
      "command": "video_mark sp-resume"
    },
    {
      "op": "wait",
      "sim_at_least": 400
    },
    {
      "op": "assert",
      "sim_at_least": 400,
      "equals": {
        "service": "Idle"
      }
    },
    {
      "op": "key_down",
      "key": "Escape"
    },
    {
      "op": "key_up",
      "key": "Escape"
    },
    {
      "op": "wait",
      "elapsed_ms": 700,
      "scope": "menu"
    },
    {
      "op": "signal",
      "name": "done",
      "scope": "menu"
    },
    {
      "op": "finish"
    }
  ]
}
