{
  "schema": 1,
  "timeout_ms": 170000,
  "steps": [
    {"op": "wait", "service": "Running", "sim_at_least": 200},
    {"op": "key_down", "key": "F6"},
    {"op": "key_up", "key": "F6"},
    {"op": "wait", "panel_open": true},
    {"op": "wait", "renders": 30},
    {"op": "mouse_down", "control": "NetworkSeatsOptions"},
    {"op": "mouse_up", "control": "NetworkSeatsOptions"},
    {"op": "wait", "control": "NetworkSeatsOptionsText", "equals": {"visible": true}},
    {"op": "assert_control", "control": "NetworkSeatsOptionsText", "fits": true, "text_contains": "Frame redundancy:"},
    {"op": "wait", "renders": 30},
    {"op": "key_down", "key": "F6"},
    {"op": "key_up", "key": "F6"},
    {"op": "wait", "panel_open": false},
    {"op": "key_down", "key": "Escape"},
    {"op": "key_up", "key": "Escape"},
    {"op": "wait", "screen": "Pause"},
    {"op": "menu", "command": "assert_visible ButtonLeaveMatch 1"},
    {"op": "menu", "command": "assert_visible ButtonMatchOptions 1"},
    {"op": "menu", "command": "assert_visible ButtonSettings 1"},
    {"op": "menu", "command": "assert_visible ButtonSaveDiagnostics 1"},
    {"op": "menu", "command": "assert_text_fits ButtonLeaveMatch"},
    {"op": "menu", "command": "assert_text_fits ButtonMatchOptions"},
    {"op": "wait", "renders": 25},
    {"op": "menu", "command": "activate ButtonMatchOptions"},
    {"op": "wait", "screen": "PauseMatchOptions"},
    {"op": "menu", "command": "assert_rect_inside MatchOptionsBox viewport"},
    {"op": "menu", "command": "assert_rect_inside LabelMatchOptionsTitle MatchOptionsBox"},
    {"op": "menu", "command": "assert_rect_inside LabelMatchOptions MatchOptionsBox"},
    {"op": "menu", "command": "assert_rect_inside LabelMatchRepairHint MatchOptionsBox"},
    {"op": "menu", "command": "assert_rect_inside ButtonMatchOptionsClose MatchOptionsBox"},
    {"op": "menu", "command": "dump_host_options"},
    {"op": "wait", "renders": 30},
    {"op": "menu", "command": "activate ButtonMatchOptionsClose"},
    {"op": "wait", "screen": "Pause"},
    {"op": "menu", "command": "activate ButtonSettings"},
    {"op": "wait", "screen": "PauseSettings"},
    {"op": "menu", "command": "select_settings_page Video"},
    {"op": "wait", "renders": 20},
    {"op": "menu", "command": "assert_settings_page Video"},
    {"op": "menu", "command": "select_settings_page Gameplay"},
    {"op": "wait", "renders": 20},
    {"op": "menu", "command": "assert_settings_page Gameplay"},
    {"op": "menu", "command": "dump_player_options"},
    {"op": "menu", "command": "post_command ButtonBackToMainMenu"},
    {"op": "wait", "screen": "Pause"},
    {"op": "wait", "renders": 20},
    {"op": "menu", "command": "activate ButtonResume"},
    {"op": "wait", "screen": "Gameplay"},
    {"op": "wait", "sim_at_least": 700},
    {"op": "signal", "name": "done"},
    {"op": "finish"}
  ]
}
