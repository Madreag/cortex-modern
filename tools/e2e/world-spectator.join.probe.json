{
  "schema": 1,
  "timeout_ms": 180000,
  "steps": [
    {
      "op": "menu",
      "command": "dump_world_ownership spectator-image"
    },
    {
      "op": "menu",
      "command": "dump_seat_state"
    },
    {
      "op": "wait",
      "sim_at_least": 5940
    },
    {
      "op": "menu",
      "command": "video_mark spectator-crawl-begins"
    },
    {
      "op": "wait",
      "sim_at_least": 6061
    },
    {
      "op": "menu",
      "command": "dump_world_ownership crawl-complete"
    },
    {
      "op": "signal",
      "name": "crawl-complete"
    },
    {
      "op": "wait",
      "renders": 5
    },
    {
      "op": "menu",
      "command": "video_mark spectator-crawl-ends"
    },
    {
      "op": "wait_file",
      "path": "{PROBE_DIR_host}/host-released.json"
    },
    {
      "op": "wait",
      "service": "Running",
      "local_peer_at_most": 4
    },
    {
      "op": "wait",
      "renders": 120
    },
    {
      "op": "key_down",
      "key": "D"
    },
    {
      "op": "wait",
      "renders": 10
    },
    {
      "op": "menu",
      "command": "dump_world_ownership promoted-input"
    },
    {
      "op": "key_up",
      "key": "D"
    },
    {
      "op": "signal",
      "name": "promoted-input"
    },
    {
      "op": "finish"
    }
  ],
  "activate_phase": "Running",
  "label_dump": {
    "every_ms": 5000
  }
}
