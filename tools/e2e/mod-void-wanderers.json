{
  "schema": 1,
  "name": "mod-void-wanderers",
  "port_base": 49450,
  "title": "The installed Void Wanderers activity runs unchanged in offline and paired play",
  "requires": [
    "VoidWanderers.rte"
  ],
  "size": "960x540",
  "timeout_s": 600,
  "runs": [
    {
      "name": "single",
      "peers": [
        {
          "name": "sp",
          "args": [
            "-module",
            "VoidWanderers.rte",
            "-max-ticks",
            "4000",
            "-num-lua-states",
            "4",
            "-input-script",
            "{INPUT_SCRIPT}"
          ],
          "input_script": "play-input.txt",
          "menu_script": "mod-void-wanderers.menu.txt",
          "probe": "mod-void-wanderers.probe.json"
        }
      ]
    },
    {
      "name": "paired",
      "peers": [
        {
          "name": "host",
          "args": [
            "-module",
            "VoidWanderers.rte",
            "-net-match-service-e2e",
            "-net-port",
            "{PORT}",
            "-net-match-peers",
            "2",
            "-net-match-ticks",
            "2700",
            "-net-match-input-delay",
            "3",
            "-net-autosave-seconds",
            "0",
            "-net-match-service-module",
            "VoidWanderers.rte",
            "-net-match-service-preset",
            "Void Wanderers",
            "-net-match-report",
            "{OUT}/host-match.json",
            "-input-script",
            "{INPUT_SCRIPT}",
            "-net-host",
            "-net-match-service-scene",
            "Void Wanderers",
            "-net-match-service-scene-module",
            "VoidWanderers.rte"
          ],
          "input_script": "play-input.txt"
        },
        {
          "name": "client",
          "args": [
            "-module",
            "VoidWanderers.rte",
            "-net-match-service-e2e",
            "-net-port",
            "{PORT}",
            "-net-match-peers",
            "2",
            "-net-match-ticks",
            "2700",
            "-net-match-input-delay",
            "3",
            "-net-autosave-seconds",
            "0",
            "-net-match-service-module",
            "VoidWanderers.rte",
            "-net-match-service-preset",
            "Void Wanderers",
            "-net-match-report",
            "{OUT}/client-match.json",
            "-input-script",
            "{INPUT_SCRIPT}",
            "-net-join",
            "127.0.0.1",
            "-net-match-service-scene",
            "Void Wanderers",
            "-net-match-service-scene-module",
            "VoidWanderers.rte"
          ],
          "input_script": "play-input.txt",
          "start_delay_s": 3.0
        }
      ]
    }
  ],
  "checklist": [
    {
      "id": "vw-loads",
      "peer": "sp",
      "screen": "MainScreen",
      "what": "the engine loads with VoidWanderers.rte and reaches the main menu with no console error and no missing-preset warning",
      "assert": "menu script: assert_screen MainScreen, assert_console 0 (the error console never opened itself) plus a log scan for ERROR lines",
      "run": "single",
      "mark": "vw-loads",
      "events": [
        "assert_screen expected=MainScreen actual=MainScreen PASS"
      ],
      "forbidden_log_regex": [
        "^ERROR:",
        "RTE Aborted",
        "Assertion failed"
      ]
    },
    {
      "id": "vw-sp-play",
      "peer": "sp",
      "screen": "game",
      "sim_ticks": [
        1,
        4000
      ],
      "what": "the mod's own activity plays: its Lua runs, its actors and objects behave as they did before this fork's changes",
      "assert": "input script drives the seat; no Lua traceback in the log",
      "run": "single",
      "mark": "vw-play",
      "forbidden_log_regex": [
        "^ERROR:",
        "RTE Aborted",
        "Assertion failed"
      ]
    },
    {
      "id": "vw-mp-play",
      "screen": "game",
      "sim_ticks": [
        30,
        1800
      ],
      "what": "the same mod activity runs over the lockstep transport on two peers and the two videos agree",
      "assert": "both match reports and a frame-by-frame compare of the two contact sheets",
      "run": "paired",
      "forbidden_log_regex": [
        "^ERROR:",
        "RTE Aborted",
        "Assertion failed"
      ]
    },
    {
      "id": "vw-no-lua-break",
      "what": "no Lua or native API behaviour the mod relies on has changed",
      "assert": "logs carry no [lua] error, no RTE Assert and no missing-property warning on either run",
      "run": "paired",
      "forbidden_log_regex": [
        "^ERROR:",
        "RTE Aborted",
        "Assertion failed"
      ]
    }
  ]
}
