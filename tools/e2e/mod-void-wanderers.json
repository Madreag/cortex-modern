{
  "schema": 1,
  "name": "mod-void-wanderers",
  "port_base": 49450,
  "title": "The installed Void Wanderers activity runs unchanged in offline and paired play",
  "requires": [
    "VoidWanderers.rte"
  ],
  "size": "960x540",
  "timeout_s": 600,
  "runs": [
    {
      "name": "single",
      "peers": [
        {
          "name": "sp",
          "args": [
            "-module",
            "VoidWanderers.rte",
            "-max-ticks",
            "4000",
            "-num-lua-states",
            "4",
            "-input-script",
            "{INPUT_SCRIPT}",
            "-seed",
            "42"
          ],
          "input_script": "mod-void-wanderers-single-input.txt",
          "menu_script": "mod-void-wanderers.menu.txt",
          "probe": "mod-void-wanderers.probe.json",
          "settings": {
            "EnableGlobalScript": "UserSavedGames.rte/VW Scene Observer"
          },
          "runtime_files": [
            {
              "to": "Userdata/UserSavedGames.rte/Index.ini",
              "write": "DataModule\n\tModuleName = Scripted Activity Saves\n\tAddGlobalScript = GlobalScript\n\t\tPresetName = VW Scene Observer\n\t\tLateUpdate = 1\n\t\tScriptPath = UserSavedGames.rte/VWSceneObserver.lua\n\t\tLuaClassName = VWSceneObserver\n"
            },
            {
              "to": "Userdata/UserSavedGames.rte/VWSceneObserver.lua",
              "copy": "tools/e2e/mod-void-wanderers-observer.lua"
            }
          ],
          "env": {
            "CC_LUA_FILE_ROOT": "../ScriptFiles"
          }
        }
      ]
    },
    {
      "name": "paired",
      "peers": [
        {
          "name": "host",
          "args": [
            "-module",
            "VoidWanderers.rte",
            "-net-match-service-e2e",
            "-net-port",
            "{PORT}",
            "-net-match-peers",
            "2",
            "-net-match-ticks",
            "2700",
            "-net-match-input-delay",
            "3",
            "-net-autosave-seconds",
            "0",
            "-net-match-service-module",
            "VoidWanderers.rte",
            "-net-match-service-preset",
            "Void Wanderers",
            "-net-match-report",
            "{OUT}/host-match.json",
            "-input-script",
            "{INPUT_SCRIPT}",
            "-net-host",
            "-net-match-service-scene",
            "Void Wanderers",
            "-net-match-service-scene-module",
            "VoidWanderers.rte",
            "-seed",
            "42",
            "-num-lua-states",
            "4",
            "-net-live-tick-hashes",
            "{OUT}/host-live.jsonl"
          ],
          "input_script": "mod-void-wanderers-input.txt",
          "settings": {
            "EnableGlobalScript": "UserSavedGames.rte/VW Scene Observer"
          },
          "runtime_files": [
            {
              "to": "Userdata/UserSavedGames.rte/Index.ini",
              "write": "DataModule\n\tModuleName = Scripted Activity Saves\n\tAddGlobalScript = GlobalScript\n\t\tPresetName = VW Scene Observer\n\t\tLateUpdate = 1\n\t\tScriptPath = UserSavedGames.rte/VWSceneObserver.lua\n\t\tLuaClassName = VWSceneObserver\n"
            },
            {
              "to": "Userdata/UserSavedGames.rte/VWSceneObserver.lua",
              "copy": "tools/e2e/mod-void-wanderers-observer.lua"
            }
          ],
          "env": {
            "CC_LUA_FILE_ROOT": "../ScriptFiles"
          },
          "probe": "mod-void-wanderers-host.probe.json"
        },
        {
          "name": "client",
          "args": [
            "-module",
            "VoidWanderers.rte",
            "-net-match-service-e2e",
            "-net-port",
            "{PORT}",
            "-net-match-peers",
            "2",
            "-net-match-ticks",
            "2700",
            "-net-match-input-delay",
            "3",
            "-net-autosave-seconds",
            "0",
            "-net-match-service-module",
            "VoidWanderers.rte",
            "-net-match-service-preset",
            "Void Wanderers",
            "-net-match-report",
            "{OUT}/client-match.json",
            "-input-script",
            "{INPUT_SCRIPT}",
            "-net-join",
            "127.0.0.1",
            "-net-match-service-scene",
            "Void Wanderers",
            "-net-match-service-scene-module",
            "VoidWanderers.rte",
            "-seed",
            "42",
            "-num-lua-states",
            "4",
            "-net-live-tick-hashes",
            "{OUT}/client-live.jsonl"
          ],
          "input_script": "mod-void-wanderers-client-input.txt",
          "start_delay_s": 3.0,
          "settings": {
            "EnableGlobalScript": "UserSavedGames.rte/VW Scene Observer"
          },
          "runtime_files": [
            {
              "to": "Userdata/UserSavedGames.rte/Index.ini",
              "write": "DataModule\n\tModuleName = Scripted Activity Saves\n\tAddGlobalScript = GlobalScript\n\t\tPresetName = VW Scene Observer\n\t\tLateUpdate = 1\n\t\tScriptPath = UserSavedGames.rte/VWSceneObserver.lua\n\t\tLuaClassName = VWSceneObserver\n"
            },
            {
              "to": "Userdata/UserSavedGames.rte/VWSceneObserver.lua",
              "copy": "tools/e2e/mod-void-wanderers-observer.lua"
            }
          ],
          "env": {
            "CC_LUA_FILE_ROOT": "../ScriptFiles"
          },
          "probe": "mod-void-wanderers-client.probe.json"
        }
      ]
    }
  ],
  "checklist": [
    {
      "id": "vw-loads",
      "peer": "sp",
      "screen": "MainScreen",
      "what": "the engine loads with VoidWanderers.rte and reaches the main menu with no console error and no missing-preset warning",
      "assert": "menu script: assert_screen MainScreen, assert_console 0 (the error console never opened itself) plus a log scan for ERROR lines",
      "run": "single",
      "mark": "vw-loads",
      "events": [
        "assert_screen expected=MainScreen actual=MainScreen PASS"
      ],
      "forbidden_log_regex": [
        "^ERROR:",
        "RTE Aborted",
        "Assertion failed"
      ]
    },
    {
      "id": "vw-sp-play",
      "peer": "sp",
      "screen": "game",
      "what": "A hand starts a new game in the mod; Vessel Lynx then answers brain detach and movement presses for at least 1800 further ticks.",
      "assert": "mod-void-wanderers-scenes.py checks the lettering, ship, input responses and every paired tick hash; both engines exit 0.",
      "run": "single",
      "mark": "vw-play",
      "forbidden_log_regex": [
        "^ERROR:",
        "RTE Aborted",
        "Assertion failed"
      ],
      "sim_progress": 1800
    },
    {
      "id": "vw-mp-play",
      "screen": "game",
      "what": "A hand starts a new game in the mod; Vessel Lynx then answers brain detach and movement presses for at least 1800 further ticks.",
      "assert": "mod-void-wanderers-scenes.py checks the lettering, ship, input responses and every paired tick hash; both engines exit 0.",
      "run": "paired",
      "forbidden_log_regex": [
        "^ERROR:",
        "RTE Aborted",
        "Assertion failed"
      ],
      "sim_progress": 1800
    },
    {
      "id": "vw-no-lua-break",
      "what": "no Lua or native API behaviour the mod relies on has changed",
      "assert": "logs carry no [lua] error, no RTE Assert and no missing-property warning on either run",
      "run": "paired",
      "forbidden_log_regex": [
        "^ERROR:",
        "RTE Aborted",
        "Assertion failed"
      ]
    }
  ]
}
