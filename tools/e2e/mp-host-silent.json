{
  "schema": 1,
  "name": "mp-host-silent",
  "port_base": 49436,
  "size": "960x540",
  "timeout_s": 220,
  "title": "Two peers; the host goes silent for 4 s at tick 300: its session plane holds the host's own seat to the AI, the client plays on and sees the host reclaim the seat, and never takes the match over",
  "peers": [
    {
      "name": "host",
      "args": [
        "-seed",
        "42",
        "-max-ticks",
        "2400",
        "-tick-hashes",
        "-num-lua-states",
        "4",
        "-input-script",
        "{INPUT_SCRIPT}",
        "-out",
        "{OUT}/host_trace.json",
        "-net-match-report",
        "{OUT}/host-match.json",
        "-net-test-live-stall",
        "300:4000"
      ],
      "input_script": "mp-host-migration.input.txt",
      "observe_after_failure": true,
      "settings": {
        "NetworkDisplayName": "Host",
        "NetworkIceEnable": "0",
        "NetworkShowDiagnostics": "1",
        "NetworkMatchStatusMode": "Always",
        "NetworkSlowPlayerBoundTicks": "3",
        "NetworkSlowPlayerPolicy": "Substitute"
      },
      "menu_script": "mp-host-silent.host.menu.txt",
      "runtime_files": [
        {
          "copy": "tools/feel/FeelBaseline.lua",
          "to": "Userdata/UserScenes.rte/FeelBaseline.lua",
          "replace": [
            [
              "^local WINDOW_TICKS = \\d+;$",
              "local WINDOW_TICKS = 2400;"
            ]
          ]
        },
        {
          "to": "Userdata/UserScenes.rte/Index.ini",
          "write": "DataModule\n\tModuleName = User Scenes\n\tScanFolderContents = 1\n\tIgnoreMissingItems = 1\n\tAddActivity = GAScripted\n\t\tCopyOf = P4 Alpha Duel\n\t\tPresetName = Determinism FeelBaseline\n\t\tScriptPath = UserScenes.rte/FeelBaseline.lua\n\t\tLuaClassName = FeelBaseline\n\t\tTeamOfPlayer1 = 0\n\t\tPlayer1IsHuman = 1\n\t\tTeamOfPlayer2 = 1\n\t\tPlayer2IsHuman = 1\n"
        }
      ]
    },
    {
      "name": "client",
      "args": [
        "-seed",
        "42",
        "-max-ticks",
        "2400",
        "-tick-hashes",
        "-num-lua-states",
        "4",
        "-input-script",
        "{INPUT_SCRIPT}",
        "-out",
        "{OUT}/client_trace.json",
        "-net-match-report",
        "{OUT}/client-match.json"
      ],
      "input_script": "mp-host-migration.input.txt",
      "observe_after_failure": true,
      "settings": {
        "NetworkDisplayName": "Client",
        "NetworkIceEnable": "0",
        "NetworkShowDiagnostics": "1",
        "NetworkMatchStatusMode": "Always",
        "NetworkSlowPlayerBoundTicks": "3",
        "NetworkSlowPlayerPolicy": "Substitute"
      },
      "menu_script": "mp-host-migration.client.menu.txt",
      "start_when": {
        "peer": "host",
        "event": "video_mark silent-listening",
        "timeout_s": 90
      },
      "runtime_files": [
        {
          "copy": "tools/feel/FeelBaseline.lua",
          "to": "Userdata/UserScenes.rte/FeelBaseline.lua",
          "replace": [
            [
              "^local WINDOW_TICKS = \\d+;$",
              "local WINDOW_TICKS = 2400;"
            ]
          ]
        },
        {
          "to": "Userdata/UserScenes.rte/Index.ini",
          "write": "DataModule\n\tModuleName = User Scenes\n\tScanFolderContents = 1\n\tIgnoreMissingItems = 1\n\tAddActivity = GAScripted\n\t\tCopyOf = P4 Alpha Duel\n\t\tPresetName = Determinism FeelBaseline\n\t\tScriptPath = UserScenes.rte/FeelBaseline.lua\n\t\tLuaClassName = FeelBaseline\n\t\tTeamOfPlayer1 = 0\n\t\tPlayer1IsHuman = 1\n\t\tTeamOfPlayer2 = 1\n\t\tPlayer2IsHuman = 1\n"
        }
      ]
    }
  ],
  "checklist": [
    {
      "id": "silent-host-plays-on",
      "peer": "host",
      "screen": "game",
      "sim_ticks": [
        300,
        2400
      ],
      "what": "The host wakes, reclaims its own seat from the AI that held it through the stall, and keeps hosting.",
      "log_regex": [
        "\\[net-match\\] hold peer=1 frame=3\\d\\d AI in control \\(the host's own seat",
        "\\[net-match\\] seat-reclaimed peer=1 frame=\\d+"
      ],
      "forbidden_log_regex": [
        "now hosting",
        "host lost",
        "Host left",
        "PeerHeld:",
        "Your seat is held",
        "desync at frame"
      ],
      "ownership_reclaim": {
        "native": true
      }
    },
    {
      "id": "silent-client-plays-on-host-held",
      "peer": "client",
      "screen": "game",
      "sim_ticks": [
        300,
        2400
      ],
      "what": "The client plays on while the host's own seat is held to the AI through the host's stall, sees the host reclaim it, and is never held or made host itself.",
      "log_regex": [
        "\\[net-match\\] hold peer=1 frame=3\\d\\d AI in control \\(the host's own seat",
        "\\[net-match\\] seat-reclaimed peer=1 frame=\\d+"
      ],
      "forbidden_log_regex": [
        "now hosting",
        "host lost",
        "Host left",
        "PeerHeld:",
        "Your seat is held",
        "desync at frame"
      ]
    }
  ]
}
