{
  "schema": 1,
  "timeout_ms": 110000,
  "steps": [
    {
      "op": "wait_file",
      "path": "{STAGE}/gameplay-started.json"
    },
    {
      "op": "menu",
      "command": "video_mark vw-play"
    },
    {
      "op": "wait",
      "elapsed_ms": 45000
    },
    {
      "op": "assert",
      "equals": {
        "screen": "Gameplay"
      }
    },
    {
      "op": "key_down",
      "key": "Escape"
    },
    {
      "op": "key_up",
      "key": "Escape"
    },
    {
      "op": "wait",
      "screen": "Pause",
      "elapsed_ms": 400
    },
    {
      "op": "menu",
      "command": "activate ButtonBackToMain"
    },
    {
      "op": "wait",
      "elapsed_ms": 700,
      "scope": "menu"
    },
    {
      "op": "signal",
      "name": "done",
      "scope": "menu"
    },
    {
      "op": "finish"
    }
  ]
}
