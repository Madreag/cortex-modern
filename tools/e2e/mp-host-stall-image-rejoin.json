{
  "schema": 1,
  "name": "mp-host-stall-image-rejoin",
  "port_base": 49457,
  "title": "A host held for a 2000 ms stall plays on, and a client that drops afterwards rejoins through the host's image with no private-join error",
  "size": "960x540",
  "timeout_s": 480,
  "runs": [
    {
      "name": "image-after-stall",
      "peers": [
        {
          "name": "host",
          "args": [
            "-net-match-service-e2e",
            "-net-port",
            "{PORT}",
            "-net-match-peers",
            "2",
            "-net-match-ticks",
            "3000",
            "-net-match-input-delay",
            "3",
            "-net-autosave-seconds",
            "0",
            "-net-match-report",
            "{OUT}/host-match.json",
            "-net-reconnect-ticket",
            "{OUT}/host.ticket",
            "-input-script",
            "{INPUT_SCRIPT}",
            "-net-host",
            "-net-match-service-preset",
            "Determinism FeelBaseline",
            "-net-match-service-module",
            "UserScenes.rte",
            "-selftest-frame-stall",
            "600:2000"
          ],
          "input_script": "play-input.txt",
          "settings": {
            "NetworkDisplayName": "Host",
            "NetworkAutoReconnect": "1",
            "NetworkSlowPlayerBoundTicks": "3",
            "NetworkSlowPlayerPolicy": "Substitute"
          },
          "runtime_files": [
            {
              "copy": "tools/feel/FeelBaseline.lua",
              "to": "Userdata/UserScenes.rte/FeelBaseline.lua",
              "replace": [
                [
                  "^local WINDOW_TICKS = \\d+;$",
                  "local WINDOW_TICKS = 3000;"
                ]
              ]
            },
            {
              "to": "Userdata/UserScenes.rte/Index.ini",
              "write": "DataModule\n\tModuleName = User Scenes\n\tScanFolderContents = 1\n\tIgnoreMissingItems = 1\n\tAddActivity = GAScripted\n\t\tCopyOf = P4 Alpha Duel\n\t\tPresetName = Determinism FeelBaseline\n\t\tScriptPath = UserScenes.rte/FeelBaseline.lua\n\t\tLuaClassName = FeelBaseline\n\t\tIsTestActivity = 1\n\t\tTeamOfPlayer1 = 0\n\t\tPlayer1IsHuman = 1\n\t\tTeamOfPlayer2 = 1\n\t\tPlayer2IsHuman = 1\n"
            }
          ]
        },
        {
          "name": "client-dropped",
          "args": [
            "-net-match-service-e2e",
            "-net-port",
            "{PORT}",
            "-net-match-peers",
            "2",
            "-net-match-ticks",
            "3000",
            "-net-match-input-delay",
            "3",
            "-net-autosave-seconds",
            "0",
            "-net-match-report",
            "{OUT}/client-match.json",
            "-net-reconnect-ticket",
            "{OUT}/client.ticket",
            "-input-script",
            "{INPUT_SCRIPT}",
            "-net-join",
            "127.0.0.1",
            "-net-match-service-preset",
            "Determinism FeelBaseline",
            "-net-match-service-module",
            "UserScenes.rte"
          ],
          "input_script": "play-input.txt",
          "settings": {
            "NetworkDisplayName": "Joiner",
            "NetworkAutoReconnect": "1",
            "NetworkOfferStoredRejoin": "1",
            "NetworkSlowPlayerBoundTicks": "3",
            "NetworkSlowPlayerPolicy": "Substitute"
          },
          "start_delay_s": 3.0,
          "kill_at_tick": 900,
          "runtime_files": [
            {
              "copy": "tools/feel/FeelBaseline.lua",
              "to": "Userdata/UserScenes.rte/FeelBaseline.lua",
              "replace": [
                [
                  "^local WINDOW_TICKS = \\d+;$",
                  "local WINDOW_TICKS = 3000;"
                ]
              ]
            },
            {
              "to": "Userdata/UserScenes.rte/Index.ini",
              "write": "DataModule\n\tModuleName = User Scenes\n\tScanFolderContents = 1\n\tIgnoreMissingItems = 1\n\tAddActivity = GAScripted\n\t\tCopyOf = P4 Alpha Duel\n\t\tPresetName = Determinism FeelBaseline\n\t\tScriptPath = UserScenes.rte/FeelBaseline.lua\n\t\tLuaClassName = FeelBaseline\n\t\tIsTestActivity = 1\n\t\tTeamOfPlayer1 = 0\n\t\tPlayer1IsHuman = 1\n\t\tTeamOfPlayer2 = 1\n\t\tPlayer2IsHuman = 1\n"
            }
          ]
        },
        {
          "name": "client-rejoined",
          "args": [
            "-net-match-service-e2e",
            "-net-port",
            "{PORT}",
            "-net-match-peers",
            "2",
            "-net-match-ticks",
            "3000",
            "-net-match-input-delay",
            "3",
            "-net-autosave-seconds",
            "0",
            "-net-match-report",
            "{OUT}/rejoin-match.json",
            "-net-reconnect-ticket",
            "{OUT}/client.ticket",
            "-input-script",
            "{INPUT_SCRIPT}",
            "-net-join",
            "127.0.0.1",
            "-net-match-service-preset",
            "Determinism FeelBaseline",
            "-net-match-service-module",
            "UserScenes.rte"
          ],
          "input_script": "play-input.txt",
          "settings": {
            "NetworkDisplayName": "Joiner",
            "NetworkAutoReconnect": "1",
            "NetworkOfferStoredRejoin": "1",
            "NetworkSlowPlayerBoundTicks": "3",
            "NetworkSlowPlayerPolicy": "Substitute"
          },
          "start_when": {
            "peer": "client-dropped",
            "ended": true
          },
          "after_gate_delay_s": 2,
          "retain_runtime_from": {
            "run": "image-after-stall",
            "peer": "client-dropped"
          },
          "probe": "mp-reconnect-repair.rejoined.probe.json",
          "runtime_files": [
            {
              "copy": "tools/feel/FeelBaseline.lua",
              "to": "Userdata/UserScenes.rte/FeelBaseline.lua",
              "replace": [
                [
                  "^local WINDOW_TICKS = \\d+;$",
                  "local WINDOW_TICKS = 3000;"
                ]
              ]
            },
            {
              "to": "Userdata/UserScenes.rte/Index.ini",
              "write": "DataModule\n\tModuleName = User Scenes\n\tScanFolderContents = 1\n\tIgnoreMissingItems = 1\n\tAddActivity = GAScripted\n\t\tCopyOf = P4 Alpha Duel\n\t\tPresetName = Determinism FeelBaseline\n\t\tScriptPath = UserScenes.rte/FeelBaseline.lua\n\t\tLuaClassName = FeelBaseline\n\t\tIsTestActivity = 1\n\t\tTeamOfPlayer1 = 0\n\t\tPlayer1IsHuman = 1\n\t\tTeamOfPlayer2 = 1\n\t\tPlayer2IsHuman = 1\n"
            }
          ]
        }
      ]
    }
  ],
  "checklist": [
    {
      "id": "ias-play-before-drop",
      "peer": "host",
      "screen": "game",
      "sim_ticks": [
        30,
        900
      ],
      "what": "both peers play the match normally before the drop",
      "assert": "runner record and the host's match report",
      "run": "image-after-stall"
    },
    {
      "id": "ias-drop-seen",
      "peer": "host",
      "peer_drop": {
        "peer": "client-dropped",
        "tick": 900
      },
      "screen": "game",
      "sim_ticks": [
        900,
        1600
      ],
      "what": "the host keeps running when the client is killed and its seat is shown as dropped, not as a crash",
      "assert": "the client-dropped peer's runner record carries injected_termination",
      "run": "image-after-stall"
    },
    {
      "id": "ias-rejoin",
      "peer": "client-rejoined",
      "screen": "game",
      "sim_ticks": [
        1200,
        3000
      ],
      "what": "the relaunched client rejoins the running match from its stored ticket and plays on from the host's state",
      "assert": "Rejoined client probe requires Running at tick 1200 and again at tick 1300.",
      "run": "image-after-stall",
      "service_state": "Running",
      "ownership_reclaim": {
        "native": true
      }
    },
    {
      "id": "ias-dropped-index-kept",
      "peer": "client-dropped",
      "what": "the killed peer's own video still ends at the frame it was killed on, with its index intact",
      "assert": "frames.jsonl is flushed per frame; the manifest is absent on a killed peer, which is expected",
      "run": "image-after-stall",
      "drop_tick": 900
    }
  ]
}
