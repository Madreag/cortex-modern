{
  "schema": 1,
  "name": "mp-host-stall",
  "port_base": 49413,
  "title": "A live host whose simulation stalls 300 to 1000 ms keeps its round: its clients never elect it away",
  "size": "960x540",
  "timeout_s": 120,
  "runs": [
    {
      "name": "stall-300",
      "peers": [
        {
          "name": "host",
          "args": [
            "-net-match-service-e2e",
            "-net-port",
            "{PORT}",
            "-net-match-peers",
            "3",
            "-net-match-humans",
            "3",
            "-net-match-cpu-slots",
            "0",
            "-net-match-ticks",
            "1200",
            "-net-match-auto-delay",
            "-net-autosave-seconds",
            "0",
            "-num-lua-states",
            "4",
            "-seed",
            "42",
            "-input-script",
            "{INPUT_SCRIPT}",
            "-net-match-report",
            "{OUT}/host-match.json",
            "-out",
            "{OUT}/host_trace.json",
            "-tick-hashes",
            "-net-player-name",
            "host",
            "-net-host",
            "-selftest-frame-stall",
            "600:300"
          ],
          "input_script": "play-input.txt",
          "settings": {
            "NetworkSlowPlayerBoundTicks": "3",
            "NetworkSlowPlayerPolicy": "Substitute",
            "NetworkShowDiagnostics": "1",
            "NetworkMatchStatusMode": "Always"
          },
          "start_delay_s": 0
        },
        {
          "name": "client",
