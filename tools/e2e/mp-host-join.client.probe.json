{
  "schema": 1,
  "timeout_ms": 175000,
  "steps": [
    {"op": "wait", "service": "Running", "sim_at_least": 600},
    {"op": "key_down", "key": "Escape"},
    {"op": "key_up", "key": "Escape"},
    {"op": "wait", "screen": "Pause"},
    {"op": "assert", "equals": {"service": "Running", "paused": false}, "sim_at_least": 600},
    {"op": "menu", "command": "assert_visible ButtonLeaveMatch 1"},
    {"op": "menu", "command": "assert_visible ButtonMatchOptions 1"},
    {"op": "menu", "command": "assert_enabled ButtonEndMatch 0"},
    {"op": "menu", "command": "activate ButtonMatchOptions"},
    {"op": "wait", "screen": "PauseMatchOptions"},
    {"op": "menu", "command": "assert_visible ButtonMatchRepairNow 0"},
    {"op": "menu", "command": "dump_host_options"},
    {"op": "wait", "renders": 25},
    {"op": "menu", "command": "activate ButtonMatchOptionsClose"},
    {"op": "wait", "screen": "Pause"},
    {"op": "menu", "command": "activate ButtonResume"},
    {"op": "wait", "screen": "Gameplay"},
    {"op": "wait_file", "path": "{PROBE_DIR_host}/done.json"},
    {"op": "wait", "renders": 60},
    {"op": "signal", "name": "done"},
    {"op": "finish"}
  ]
}
