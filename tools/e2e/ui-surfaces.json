{
  "schema": 1,
  "name": "ui-surfaces",
  "port_base": 49440,
  "title": "Every multiplayer UI surface at 640x360, 960x540 and 1280x720: lobby, host options, kick/ban, chat, F6, visibility, Repair, pause Match Options",
  "timeout_s": 160,
  "runs": [
    {
      "name": "640x360",
      "size": "640x360"
    },
    {
      "name": "960x540",
      "size": "960x540"
    },
    {
      "name": "1280x720",
      "size": "1280x720"
    },
    {
      "name": "player-settings",
      "size": "960x540",
      "peers": [
        {
          "name": "settings",
          "args": [],
          "menu_script": "ui-surfaces.settings.menu.txt",
          "settings": {
            "NetworkAutoReconnect": "1",
            "NetworkRecordReplays": "0",
            "SessionDirectoryUrl": "{DIRECTORY_URL}",
            "SessionDirectoryCertSha256": "{DIRECTORY_PIN}"
          }
        }
      ]
    }
  ],
  "peers": [
    {
      "name": "host",
      "args": [
        "-input-script",
        "{INPUT_SCRIPT}"
      ],
      "menu_script": "ui-surfaces.host.menu.txt",
      "input_script": "ui-surfaces.walk.input.txt",
      "probe": "ui-surfaces.host.probe.json",
      "settings": {
        "NetworkDisplayName": "Host",
        "SessionDirectoryUrl": "{DIRECTORY_URL}",
        "SessionDirectoryCertSha256": "{DIRECTORY_PIN}",
        "NetworkChatVisible": "1",
        "NetworkChatNotify": "1"
      },
      "observe_after_failure": true
    },
    {
      "name": "client",
      "args": [
        "-input-script",
        "{INPUT_SCRIPT}"
      ],
      "menu_script": "ui-surfaces.client.menu.txt",
      "input_script": "ui-surfaces.walk.input.txt",
      "probe": "ui-surfaces.client.probe.json",
      "settings": {
        "NetworkDisplayName": "Joiner",
        "NetworkChatVisible": "1",
        "NetworkChatNotify": "1",
        "SessionDirectoryUrl": "{DIRECTORY_URL}",
        "SessionDirectoryCertSha256": "{DIRECTORY_PIN}"
      },
      "start_when": {
        "peer": "host",
        "event": "video_mark host-listening",
        "timeout_s": 100
      },
      "observe_after_failure": true
    }
  ],
  "checklist": [
    {
      "id": "ui-seats",
      "peer": "host",
      "mark": "ui-seats",
      "screen": "MultiplayerScreen",
      "what": "The Seats page shows the configured human seats.",
      "assert": "menu assertions in the marked interval",
      "events": [
        "assert_visible CollectionBoxHostPageSeats 1 actual=1 PASS"
      ],
      "run": [
        "640x360",
        "960x540",
        "1280x720"
      ]
    },
    {
      "id": "ui-rules",
      "peer": "host",
      "mark": "ui-rules",
      "screen": "MultiplayerScreen",
      "what": "Changing the brain-loss rule updates the selected label live.",
      "assert": "menu assertions in the marked interval",
      "events": [
        "assert_label ComboHostRulesBrainless .*End the match.* PASS"
      ],
      "run": [
        "640x360",
        "960x540",
        "1280x720"
      ]
    },
    {
      "id": "ui-network-routing",
      "peer": "host",
      "mark": "ui-network-routing",
      "screen": "MultiplayerScreen",
      "what": "Routing switches relay and NAT settings; the labels update.",
      "assert": "menu assertions in the marked interval",
      "events": [
        "assert_label ComboHostNetRelay .*Off.* PASS",
        "assert_label ComboHostNetIce .*Off.* PASS"
      ],
      "run": [
        "640x360",
        "960x540",
        "1280x720"
      ]
    },
    {
      "id": "ui-network-tuning",
      "peer": "host",
      "mark": "ui-network-tuning",
      "screen": "MultiplayerScreen",
      "what": "Both slow-player rows are visible; bound and policy changes update live.",
      "assert": "menu assertions in the marked interval",
      "events": [
        "assert_label TextHostNetSlowBound .*4.* PASS",
        "assert_label ComboHostNetSlowPolicy .*Hand the seat.* PASS"
      ],
      "run": [
        "640x360",
        "960x540",
        "1280x720"
      ]
    },
    {
      "id": "ui-visibility",
      "peer": "host",
      "mark": "ui-visibility",
      "screen": "MultiplayerScreen",
      "what": "The visibility selector opens and selects Unlisted and Listed.",
      "assert": "menu assertions in the marked interval",
      "events": [
        "assert_label ComboHostNetVisibility .*Unlisted.* PASS",
        "assert_label ComboHostNetVisibility .*Listed.* PASS"
      ],
      "run": [
        "640x360",
        "960x540",
        "1280x720"
      ]
    },
    {
      "id": "ui-recovery",
      "peer": "host",
      "mark": "ui-recovery",
      "screen": "MultiplayerScreen",
      "what": "Autosave enables its interval field, accepts 30, then disables it when unchecked.",
      "assert": "menu assertions in the marked interval",
      "events": [
        "assert_enabled TextHostRecAutosaveInterval expected=1 actual=1 PASS",
        "assert_enabled TextHostRecAutosaveInterval expected=0 actual=0 PASS"
      ],
      "run": [
        "640x360",
        "960x540",
        "1280x720"
      ]
    },
    {
      "id": "ui-files",
      "peer": "host",
      "mark": "ui-files",
      "screen": "MultiplayerScreen",
      "what": "The Files page changes the match status widget to Always.",
      "assert": "menu assertions in the marked interval",
      "events": [
        "assert_label ComboHostFilesWidget .*Always.* PASS"
      ],
      "run": [
        "640x360",
        "960x540",
        "1280x720"
      ]
    },
    {
      "id": "ui-session",
      "peer": "host",
      "mark": "ui-session",
      "screen": "MultiplayerScreen",
      "what": "The Session idle setting changes to five minutes.",
      "assert": "menu assertions in the marked interval",
      "events": [
        "assert_label ComboHostSessIdle .*5 minutes.* PASS"
      ],
      "run": [
        "640x360",
        "960x540",
        "1280x720"
      ]
    },
    {
      "id": "ui-seat-dialog-own",
      "peer": "host",
      "mark": "ui-seat-dialog-own",
      "screen": "MultiplayerScreen",
      "what": "The host seat dialog disables Kick and Ban and explains why.",
      "assert": "menu assertions in the marked interval",
      "events": [
        "assert_enabled ButtonHostSeatDlgKick expected=0 actual=0 PASS"
      ],
      "run": [
        "640x360",
        "960x540",
        "1280x720"
      ]
    },
    {
      "id": "ui-seat-dialog-other",
      "peer": "host",
      "mark": "ui-seat-dialog-other",
      "screen": "MultiplayerScreen",
      "what": "The other seat offers Kick and Ban, and Close dismisses the dialog.",
      "assert": "menu assertions in the marked interval",
      "events": [
        "assert_enabled ButtonHostSeatDlgKick expected=1 actual=1 PASS",
        "assert_enabled ButtonHostSeatDlgBan expected=1 actual=1 PASS"
      ],
      "run": [
        "640x360",
        "960x540",
        "1280x720"
      ]
    },
    {
      "id": "ui-directory-listing",
      "peer": "client",
      "mark": "ui-directory-listing",
      "screen": "MultiplayerScreen",
      "what": "A published session appears in discovery; selecting the row fills its join target.",
      "assert": "directory/listed.json; activate GameRow0",
      "events": [
        "activate GameRow0 ok=1"
      ],
      "run": [
        "640x360",
        "960x540",
        "1280x720"
      ]
    },
    {
      "id": "ui-chat-host",
      "peer": "host",
      "mark": "ui-chat",
      "screen": "MultiplayerScreen",
      "what": "The lobby chat band shows messages sent by both players.",
      "assert": "chat all returns ok=1",
      "events": [
        "chat scope=all ok=1"
      ],
      "run": [
        "640x360",
        "960x540",
        "1280x720"
      ]
    },
    {
      "id": "ui-chat-client",
      "peer": "client",
      "mark": "ui-chat",
      "screen": "MultiplayerScreen",
      "what": "The lobby chat band shows messages sent by both players.",
      "assert": "chat all returns ok=1",
      "events": [
        "chat scope=all ok=1"
      ],
      "run": [
        "640x360",
        "960x540",
        "1280x720"
      ]
    },
    {
      "id": "ui-f6-overlay-host",
      "peer": "host",
      "mark": "ui-f6-overlay",
      "screen": "game",
      "what": "F6 opens the live seats overlay.",
      "assert": "probe assertions in the marked interval",
      "run": [
        "640x360",
        "960x540",
        "1280x720"
      ]
    },
    {
      "id": "ui-f6-options-host",
      "peer": "host",
      "mark": "ui-f6-options",
      "screen": "game",
      "what": "The F6 Options view shows the live rules.",
      "assert": "probe assertions in the marked interval",
      "run": [
        "640x360",
        "960x540",
        "1280x720"
      ]
    },
    {
      "id": "ui-pause-match-options-host",
      "peer": "host",
      "mark": "ui-pause-match-options",
      "screen": "PauseMatchOptions",
      "what": "Pause Match Options draws the rules, repair hint and Close button.",
      "assert": "probe assertions in the marked interval",
      "run": [
        "640x360",
        "960x540",
        "1280x720"
      ]
    },
    {
      "id": "ui-f6-overlay-client",
      "peer": "client",
      "mark": "ui-f6-overlay",
      "screen": "game",
      "what": "F6 opens the live seats overlay.",
      "assert": "probe assertions in the marked interval",
      "run": [
        "640x360",
        "960x540",
        "1280x720"
      ]
    },
    {
      "id": "ui-f6-options-client",
      "peer": "client",
      "mark": "ui-f6-options",
      "screen": "game",
      "what": "The F6 Options view shows the live rules.",
      "assert": "probe assertions in the marked interval",
      "run": [
        "640x360",
        "960x540",
        "1280x720"
      ]
    },
    {
      "id": "ui-pause-match-options-client",
      "peer": "client",
      "mark": "ui-pause-match-options",
      "screen": "PauseMatchOptions",
      "what": "Pause Match Options draws the rules, repair hint and Close button.",
      "assert": "probe assertions in the marked interval",
      "run": [
        "640x360",
        "960x540",
        "1280x720"
      ]
    },
    {
      "id": "ui-player-settings",
      "run": "player-settings",
      "peer": "settings",
      "screen": "SettingsScreen",
      "mark": "ui-player-settings",
      "what": "Player name and fixed input delay update live.",
      "events": [
        "assert_label TextNetworkFixedDelay .*7.* PASS"
      ],
      "assert": "menu assertions inside the marked interval"
    },
    {
      "id": "ui-chat-settings",
      "run": "player-settings",
      "peer": "settings",
      "screen": "SettingsScreen",
      "mark": "ui-chat-settings",
      "what": "Chat scope and text size selections update.",
      "events": [
        "assert_label ComboNetworkChatTextSize .*Small.* PASS"
      ],
      "assert": "menu assertions inside the marked interval"
    },
    {
      "id": "ui-recovery-settings",
      "run": "player-settings",
      "peer": "settings",
      "screen": "SettingsScreen",
      "mark": "ui-recovery-settings",
      "what": "Automatic reconnect toggles off and on.",
      "events": [
        "assert_checked CheckboxNetworkAutoReconnect expected=1 actual=1 PASS"
      ],
      "assert": "menu assertions inside the marked interval"
    },
    {
      "id": "ui-files-settings",
      "run": "player-settings",
      "peer": "settings",
      "screen": "SettingsScreen",
      "mark": "ui-files-settings",
      "what": "Retention changes to five and replay recording turns on.",
      "events": [
        "assert_checked CheckboxNetworkRecordReplays expected=1 actual=1 PASS"
      ],
      "assert": "menu assertions inside the marked interval"
    },
    {
      "id": "ui-internet-settings",
      "run": "player-settings",
      "peer": "settings",
      "screen": "SettingsScreen",
      "mark": "ui-internet-settings",
      "what": "The local directory URL and certificate pin are accepted.",
      "events": [
        "assert_label LabelNetDirStatus .*Configured.* PASS"
      ],
      "assert": "menu assertions inside the marked interval"
    },
    {
      "id": "ui-connection-settings",
      "run": "player-settings",
      "peer": "settings",
      "screen": "SettingsScreen",
      "mark": "ui-connection-settings",
      "what": "Direct only, Relay only and Automatic each show their own performance hint.",
      "events": [
        "assert_label LabelNetworkConnectionHint .*Direct first.* PASS"
      ],
      "assert": "menu assertions inside the marked interval"
    },
    {
      "id": "ui-leave-confirm",
      "peer": "host",
      "run": [
        "640x360",
        "960x540",
        "1280x720"
      ],
      "mark": "ui-leave-confirm",
      "screen": "PauseLeaveConfirm",
      "what": "Leave Match opens its consequence dialog; Cancel returns the host to the local pause menu.",
      "assert": "probe asserts ButtonLeaveConfirm, activates ButtonLeaveCancel and waits for Pause"
    },
    {
      "id": "ui-hosted-recovery",
      "peer": "host",
      "run": [
        "640x360",
        "960x540",
        "1280x720"
      ],
      "mark": "ui-hosted-recovery",
      "screen": "MultiplayerScreen",
      "what": "The hosted lobby disables Repair and explains that it needs a live match.",
      "assert": "assert_enabled ButtonHostRecRepairNow 0; assert_label LabelHostRecRepairHint Repair needs a live match session",
      "events": [
        "assert_enabled ButtonHostRecRepairNow expected=0 actual=0 PASS",
        "assert_label LabelHostRecRepairHint .*Repair needs a live match session.* PASS"
      ]
    },
    {
      "id": "ui-leave-confirm-client",
      "peer": "client",
      "run": [
        "640x360",
        "960x540",
        "1280x720"
      ],
      "mark": "ui-leave-confirm-client",
      "screen": "PauseLeaveConfirm",
      "what": "The client reads the leave consequence and confirms; both capture processes then finish.",
      "assert": "probe asserts ButtonLeaveConfirm and activates it; both launch records end without a timeout"
    }
  ],
  "directory_port": 49479
}
