{
  "schema": 1,
  "name": "mp-inplace-rehold",
  "title": "A seat held for its own stall returns in place and stalls again the moment its return is live: it is held again after its return's gap and every peer stays in sync",
  "port_base": 49456,
  "size": "960x540",
  "timeout_s": 150,
  "runs": [
    {
      "name": "rehold-200",
      "peers": [
        {
          "name": "host",
          "args": [
            "-net-match-service-e2e",
            "-net-port",
            "{PORT}",
            "-net-match-peers",
            "3",
            "-net-match-humans",
            "3",
            "-net-match-cpu-slots",
            "0",
            "-net-match-ticks",
            "1200",
            "-net-match-auto-delay",
            "-net-autosave-seconds",
            "0",
            "-num-lua-states",
            "4",
            "-seed",
            "42",
            "-input-script",
            "{INPUT_SCRIPT}",
            "-net-match-report",
            "{OUT}/host-match.json",
            "-out",
            "{OUT}/host_trace.json",
            "-tick-hashes",
            "-net-player-name",
            "host",
            "-net-host"
          ],
          "input_script": "play-input.txt",
          "settings": {
            "NetworkSlowPlayerBoundTicks": "3",
            "NetworkSlowPlayerPolicy": "Substitute",
            "NetworkShowDiagnostics": "1",
            "NetworkMatchStatusMode": "Always"
          },
          "start_delay_s": 0,
          "probe": "mp-inplace-rehold.observe.probe.json"
        },
        {
          "name": "client",
          "args": [
            "-net-match-service-e2e",
            "-net-port",
            "{PORT}",
            "-net-match-peers",
            "3",
            "-net-match-humans",
            "3",
            "-net-match-cpu-slots",
            "0",
            "-net-match-ticks",
            "1200",
            "-net-match-auto-delay",
            "-net-autosave-seconds",
            "0",
            "-num-lua-states",
            "4",
            "-seed",
            "42",
            "-input-script",
            "{INPUT_SCRIPT}",
            "-net-match-report",
            "{OUT}/client-match.json",
            "-out",
            "{OUT}/client_trace.json",
            "-tick-hashes",
            "-net-player-name",
            "client",
            "-net-join",
            "127.0.0.1",
            "-net-fake-lag",
            "200",
            "-net-test-live-stall",
            "500:600",
            "-net-test-live-stall",
            "653:600"
          ],
          "input_script": "play-input.txt",
          "settings": {
            "NetworkSlowPlayerBoundTicks": "3",
            "NetworkSlowPlayerPolicy": "Substitute",
            "NetworkShowDiagnostics": "1",
            "NetworkMatchStatusMode": "Always"
          },
          "start_delay_s": 1
        },
        {
          "name": "survivor",
          "args": [
            "-net-match-service-e2e",
            "-net-port",
            "{PORT}",
            "-net-match-peers",
            "3",
            "-net-match-humans",
            "3",
            "-net-match-cpu-slots",
            "0",
            "-net-match-ticks",
            "1200",
            "-net-match-auto-delay",
            "-net-autosave-seconds",
            "0",
            "-num-lua-states",
            "4",
            "-seed",
            "42",
            "-input-script",
            "{INPUT_SCRIPT}",
            "-net-match-report",
            "{OUT}/survivor-match.json",
            "-out",
            "{OUT}/survivor_trace.json",
            "-tick-hashes",
            "-net-player-name",
            "survivor",
            "-net-join",
            "127.0.0.1",
            "-net-fake-lag",
            "200"
          ],
          "input_script": "play-input.txt",
          "settings": {
            "NetworkSlowPlayerBoundTicks": "3",
            "NetworkSlowPlayerPolicy": "Substitute",
            "NetworkShowDiagnostics": "1",
            "NetworkMatchStatusMode": "Always"
          },
          "start_delay_s": 5,
          "probe": "mp-inplace-rehold.observe.probe.json"
        }
      ],
      "behavior_gate": {
        "kind": "rehold",
        "target": "client",
        "observers": [
          "host",
          "survivor"
        ],
        "holds": 2,
        "reports": {
          "host": "host-match.json",
          "survivor": "survivor-match.json"
        },
        "ticks": {
          "host": 1200,
          "survivor": 1200
        },
        "steady_peers": [
          "host",
          "survivor"
        ],
        "stall_ticks": [
          500,
          653
        ]
      }
    }
  ],
  "checklist": [
    {
      "id": "rehold-200-host-plays-on",
      "run": "rehold-200",
      "peer": "host",
      "screen": "game",
      "sim_ticks": [
        500,
        1200
      ],
      "what": "At 200 ms RTT the client stalls 600 ms at 500, is held and returns in place; the host plays on.",
      "forbidden_log_regex": [
        "host lost",
        "now hosting",
        "resync failed",
        "lockstep stopped",
        "desync at frame"
      ],
      "gate": "scenario-behavior"
    },
    {
      "id": "rehold-200-client-plays-on",
      "run": "rehold-200",
      "peer": "client",
      "screen": "game",
      "sim_ticks": [
        500,
        1200
      ],
      "what": "At 200 ms RTT the client stalls 600 ms at 500, is held and returns in place; the client plays on.",
      "forbidden_log_regex": [
        "host lost",
        "now hosting",
        "resync failed",
        "lockstep stopped",
        "desync at frame"
      ],
      "gate": "scenario-behavior"
    },
    {
      "id": "rehold-200-survivor-plays-on",
      "run": "rehold-200",
      "peer": "survivor",
      "screen": "game",
      "sim_ticks": [
        500,
        1200
      ],
      "what": "At 200 ms RTT the client stalls 600 ms at 500, is held and returns in place; the survivor plays on.",
      "forbidden_log_regex": [
        "host lost",
        "now hosting",
        "resync failed",
        "lockstep stopped",
        "desync at frame"
      ],
      "gate": "scenario-behavior"
    }
  ]
}
