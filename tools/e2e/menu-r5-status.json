{
  "schema": 1,
  "name": "menu-r5-status",
  "title": "Live status geometry on three window sizes",
  "port_base": 49453,
  "size": "960x540",
  "timeout_s": 45,
  "runs": [
    {
      "name": "640x360",
      "size": "640x360",
      "peers": [
        {
          "name": "host",
          "args": [
            "-net-match-service-e2e",
            "-net-port",
            "{PORT}",
            "-net-match-peers",
            "3",
            "-net-match-ticks",
            "1200",
            "-net-autosave-seconds",
            "0",
            "-num-lua-states",
            "4",
            "-input-script",
            "{INPUT_SCRIPT}",
            "-net-host"
          ],
          "settings": {
            "NetworkDisplayName": "host",
            "NetworkMatchStatusMode": "Always",
            "NetworkShowDiagnostics": "1"
          },
          "input_script": "ui-surfaces.input.txt",
          "menu_script": "wait-for-probe.txt",
          "start_delay_s": 0,
          "kill_when": {
            "peer": "host",
            "probe_complete": true
          },
          "probe": "menu-r5-status.probe.json"
        },
        {
          "name": "client",
          "args": [
            "-net-match-service-e2e",
            "-net-port",
            "{PORT}",
            "-net-match-peers",
            "3",
            "-net-match-ticks",
            "1200",
            "-net-autosave-seconds",
            "0",
            "-num-lua-states",
            "4",
            "-input-script",
            "{INPUT_SCRIPT}",
            "-net-join",
            "127.0.0.1"
          ],
          "settings": {
            "NetworkDisplayName": "client",
            "NetworkMatchStatusMode": "Always",
            "NetworkShowDiagnostics": "1"
          },
          "input_script": "ui-surfaces.input.txt",
          "start_delay_s": 3,
          "kill_when": {
            "peer": "host",
            "probe_complete": true
          },
          "menu_script": "menu-r5-observer.menu.txt"
        },
        {
          "name": "survivor",
          "args": [
            "-net-match-service-e2e",
            "-net-port",
            "{PORT}",
            "-net-match-peers",
            "3",
            "-net-match-ticks",
            "1200",
            "-net-autosave-seconds",
            "0",
            "-num-lua-states",
            "4",
            "-input-script",
            "{INPUT_SCRIPT}",
            "-net-join",
            "127.0.0.1"
          ],
          "settings": {
            "NetworkDisplayName": "survivor",
            "NetworkMatchStatusMode": "Always",
            "NetworkShowDiagnostics": "1"
          },
          "input_script": "ui-surfaces.input.txt",
          "start_delay_s": 3,
          "kill_when": {
            "peer": "host",
            "probe_complete": true
          },
          "menu_script": "menu-r5-observer.menu.txt"
        }
      ]
    },
