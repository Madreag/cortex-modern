  "checklist": [
    {
      "id": "status-open",
      "run": "640x360",
      "peer": "host",
      "mark": "status-open",
      "what": "The complete NET STATUS box and open seats panel occupy separate rectangles.",
      "assert": "assert_no_overlap BoxNetMatchStatus NetworkSeats"
    },
    {
      "id": "status-open",
      "run": "960x540",
      "peer": "host",
      "mark": "status-open",
      "what": "The complete NET STATUS box and open seats panel occupy separate rectangles.",
