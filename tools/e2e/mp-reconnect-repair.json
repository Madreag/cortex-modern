{
  "schema": 1,
  "name": "mp-reconnect-repair",
  "port_base": 49420,
  "title": "A dropped client rejoins the running match, then the host repairs it from pause Match Options",
  "size": "960x540",
  "timeout_s": 480,
  "runs": [
    {
      "name": "reconnect",
      "peers": [
        {
          "name": "host",
          "args": [
            "-net-match-service-e2e",
            "-net-port",
            "{PORT}",
            "-net-match-peers",
            "2",
            "-net-match-ticks",
            "3000",
            "-net-match-input-delay",
            "3",
            "-net-autosave-seconds",
            "0",
            "-net-match-report",
            "{OUT}/host-match.json",
            "-net-reconnect-ticket",
            "{OUT}/host.ticket",
            "-input-script",
            "{INPUT_SCRIPT}",
            "-net-host"
          ],
          "input_script": "play-input.txt",
          "settings": {
            "NetworkDisplayName": "Host",
            "NetworkAutoReconnect": "1"
          }
        },
        {
          "name": "client-dropped",
          "args": [
            "-net-match-service-e2e",
            "-net-port",
            "{PORT}",
            "-net-match-peers",
            "2",
            "-net-match-ticks",
            "3000",
            "-net-match-input-delay",
            "3",
            "-net-autosave-seconds",
            "0",
            "-net-match-report",
            "{OUT}/client-match.json",
            "-net-reconnect-ticket",
            "{OUT}/client.ticket",
            "-input-script",
            "{INPUT_SCRIPT}",
            "-net-join",
            "127.0.0.1"
          ],
          "input_script": "play-input.txt",
          "settings": {
            "NetworkDisplayName": "Joiner",
            "NetworkAutoReconnect": "1",
            "NetworkOfferStoredRejoin": "1"
          },
          "start_delay_s": 3.0,
          "kill_at_tick": 900
        },
        {
          "name": "client-rejoined",
          "args": [
            "-net-match-service-e2e",
            "-net-port",
            "{PORT}",
            "-net-match-peers",
            "2",
            "-net-match-ticks",
            "3000",
            "-net-match-input-delay",
            "3",
            "-net-autosave-seconds",
            "0",
            "-net-match-report",
            "{OUT}/rejoin-match.json",
            "-net-reconnect-ticket",
            "{OUT}/client.ticket",
            "-input-script",
            "{INPUT_SCRIPT}",
            "-net-join",
            "127.0.0.1"
          ],
          "input_script": "play-input.txt",
          "settings": {
            "NetworkDisplayName": "Joiner",
            "NetworkAutoReconnect": "1",
            "NetworkOfferStoredRejoin": "1"
          },
          "start_when": {
            "peer": "client-dropped",
            "ended": true
          },
          "after_gate_delay_s": 2,
          "retain_runtime_from": {
            "run": "reconnect",
            "peer": "client-dropped"
          },
          "probe": "mp-reconnect-repair.rejoined.probe.json"
        }
      ]
    },
    {
      "name": "repair",
      "peers": [
        {
          "name": "host",
          "args": [
            "-net-match-service-e2e",
            "-net-port",
            "{PORT}",
            "-net-match-peers",
            "2",
            "-net-match-ticks",
            "1200",
            "-net-match-input-delay",
            "3",
            "-net-autosave-seconds",
            "0",
            "-net-match-e2e-resync",
            "-net-match-report",
            "{OUT}/host-match.json",
            "-input-script",
            "{INPUT_SCRIPT}",
            "-net-host"
          ],
          "input_script": "ui-surfaces.input.txt",
          "menu_script": "wait-for-probe.txt",
          "probe": "mp-reconnect-repair.host.probe.json"
        },
        {
          "name": "client",
          "args": [
            "-net-match-service-e2e",
            "-net-port",
            "{PORT}",
            "-net-match-peers",
            "2",
            "-net-match-ticks",
            "1200",
            "-net-match-input-delay",
            "3",
            "-net-autosave-seconds",
            "0",
            "-net-match-e2e-resync",
            "-net-match-report",
            "{OUT}/client-match.json",
            "-input-script",
            "{INPUT_SCRIPT}",
            "-net-join",
            "127.0.0.1"
          ],
          "input_script": "ui-surfaces.input.txt",
          "menu_script": "wait-for-probe.txt",
          "probe": "mp-reconnect-repair.client.probe.json",
          "start_delay_s": 3.0
        }
      ]
    }
  ],
  "checklist": [
    {
      "id": "rc-play-before-drop",
      "peer": "host",
      "screen": "game",
      "sim_ticks": [
        30,
        900
      ],
      "what": "both peers play the match normally before the drop",
      "assert": "runner record and the host's match report",
      "run": "reconnect"
    },
    {
      "id": "rc-drop-seen",
      "peer": "host",
      "screen": "game",
      "sim_ticks": [
        900,
        1600
      ],
      "what": "the host keeps running when the client is killed and its seat is shown as dropped, not as a crash",
      "assert": "the client-dropped peer's runner record carries injected_termination",
      "run": "reconnect"
    },
    {
      "id": "rc-rejoin",
      "peer": "client-rejoined",
      "screen": "game",
      "sim_ticks": [
        1200,
        3000
      ],
      "what": "the relaunched client rejoins the running match from its stored ticket and plays on from the host's state",
      "assert": "Rejoined client probe requires Running at tick 1200 and again at tick 1300.",
      "run": "reconnect",
      "service_state": "Running"
    },
    {
      "id": "rc-dropped-index-kept",
      "peer": "client-dropped",
      "what": "the killed peer's own video still ends at the frame it was killed on, with its index intact",
      "assert": "frames.jsonl is flushed per frame; the manifest is absent on a killed peer, which is expected",
      "run": "reconnect",
      "drop_tick": 900
    },
    {
      "id": "rp-f6-overlay",
      "screen": "game",
      "what": "F6 opens the network overlay in the running match and its Options view reads the live match rules",
      "assert": "probe: wait panel_open true, assert_control NetworkSeatsOptionsText",
      "run": "repair",
      "mark": "repair-f6"
    },
    {
      "id": "rp-repair-hint-host",
      "peer": "host",
      "screen": "PauseMatchOptions",
      "what": "the host's Match Options offers Repair with its hint inside the dialog",
      "assert": "probe: assert_enabled ButtonMatchRepairNow 1 and the two-press hint",
      "run": "repair",
      "mark": "repair-pause"
    },
    {
      "id": "rp-repair-hint-client",
      "peer": "client",
      "screen": "PauseMatchOptions",
      "what": "the client's Match Options shows no Repair button and says the repair is the host's call",
      "assert": "probe: assert_visible ButtonMatchRepairNow 0, assert_label LabelMatchRepairHint Repair is the host's call",
      "run": "repair",
      "mark": "repair-pause"
    },
    {
      "id": "rp-repair-applied",
      "screen": "game",
      "what": "the second press repairs the match: both peers pause, reload the host's snapshot and keep playing",
      "assert": "Each peer logs snapshot reload and relaunch; an accepted button press alone is insufficient.",
      "run": "repair",
      "log_regex": [
        "\\[net-match\\] resync: reloading from the host snapshot",
        "\\[net-match\\] resync: match relaunched from the snapshot"
      ],
      "mark": "repair-post-play",
      "service_state": "Running"
    },
    {
      "id": "rp-reload-overlay",
      "run": "repair",
      "screen": "ResyncOverlay",
      "what": "The snapshot reload overlay appears on each peer during Repair Match.",
      "log_regex": [
        "\\[net-match\\] resync: reloading from the host snapshot"
      ],
      "assert": "A recorded ResyncOverlay frame and the peer snapshot-reload log line.",
      "probe_steps": []
    }
  ]
}
