  "checklist": [
    {
      "id": "loss-960x540-leaver",
      "run": "960x540",
      "peer": "leaver",
      "mark": "status-loss",
      "screen": "LockstepWaitOverlay",
      "probe_steps": [
        3,
        4,
        5,
        6,
        7,
        8,
        9,
        10
      ],
      "readback": [
        {
          "step": 4,
          "path": [
            "control",
            "text"
          ],
          "contains": "Host connection lost - choosing a new host"
        },
        {
          "step": 4,
          "path": [
            "control",
            "text"
          ],
          "contains": "RTT -- ms"
        },
        {
          "step": 4,
          "path": [
            "control",
            "text"
          ],
          "not_contains": "LIVE"
        },
        {
          "step": 8,
          "path": [
            "control",
            "text"
          ],
          "contains": "Current wait "
        }
      ],
      "what": "During host loss the status box names the loss, blanks RTT and updates its wait; the old top-left roster does not cover Funds.",
      "assert": "Native status text twice, completed probe, first and later screenshots, and dump_network_layout."
    },
    {
