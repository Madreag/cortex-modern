  "checklist": [
    {
      "id": "loss-640x360-leaver",
      "run": "640x360",
      "peer": "leaver",
      "mark": "status-loss",
      "probe_steps": [
        2,
        3,
        4,
        5,
        6,
        7,
        8
      ],
      "readback": [
        {
          "step": 2,
          "path": [
            "control",
            "text"
          ],
          "contains": "Host lost - contacting the next host"
        },
        {
          "step": 2,
          "path": [
            "control",
            "text"
          ],
          "contains": "RTT -- ms / host lost"
        },
        {
          "step": 2,
          "path": [
            "control",
            "text"
          ],
          "contains": "Waiting "
        },
        {
          "step": 2,
          "path": [
            "control",
            "text"
          ],
          "not_contains": "Everyone is connected"
        },
        {
          "step": 6,
          "path": [
            "control",
            "text"
          ],
          "contains": "Held - AI in control"
        },
        {
          "step": 6,
          "path": [
            "control",
            "text"
          ],
          "contains": "The AI is playing for"
        },
        {
          "step": 6,
          "path": [
            "control",
            "text"
          ],
          "not_contains": "Host lost"
        },
        {
          "step": 6,
          "path": [
            "control",
            "text"
          ],
          "not_contains": "RTT -- ms"
        }
      ],
