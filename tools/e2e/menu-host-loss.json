  "checklist": [
    {
      "id": "loss-640x360-leaver",
      "run": "640x360",
      "peer": "leaver",
      "mark": "status-loss",
      "probe_steps": [
        2,
        3,
        4,
        5,
        6,
        7,
        8
      ],
      "readback": [
        {
          "step": 2,
          "path": [
            "control",
            "text"
          ],
          "contains": "Host connection lost - choosing a new host"
        },
        {
          "step": 2,
          "path": [
            "control",
            "text"
          ],
          "contains": "RTT -- ms / host lost"
        },
        {
          "step": 2,
          "path": [
            "control",
            "text"
          ],
          "contains": "Current wait "
        },
        {
          "step": 2,
          "path": [
            "control",
            "text"
          ],
          "not_contains": "LIVE"
        },
        {
          "step": 6,
          "path": [
            "control",
            "text"
          ],
          "contains": "Left - AI in control"
        },
        {
          "step": 6,
          "path": [
            "control",
            "text"
          ],
          "contains": "LIVE"
        },
        {
          "step": 6,
          "path": [
            "control",
            "text"
          ],
          "not_contains": "Host connection lost"
        },
        {
          "step": 6,
          "path": [
            "control",
            "text"
          ],
          "not_contains": "RTT -- ms"
        }
      ],
      "what": "The status box names the host loss and blanks RTT the frame it shows; after the handover the lost host's seat reads left to the AI, RTT names the new link and the box is live again; the old top-left roster does not cover Funds.",
      "assert": "Native status text at the loss and after the handover, completed probe, first and later screenshots, and dump_network_layout."
