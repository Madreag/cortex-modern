{
  "schema": 1,
  "timeout_ms": 170000,
  "steps": [
    {
      "op": "wait",
      "service": "Running",
      "sim_at_least": 150
    },
    {
      "op": "key_down",
      "key": "F6"
    },
    {
      "op": "key_up",
      "key": "F6"
    },
    {
      "op": "wait",
      "panel_open": true
    },
    {
      "op": "mouse_down",
      "control": "NetworkSeatsOptions"
    },
    {
      "op": "mouse_up",
      "control": "NetworkSeatsOptions"
    },
    {
      "op": "wait",
      "control": "NetworkSeatsOptionsText",
      "equals": {
        "visible": true
      }
    },
    {
      "op": "assert_control",
      "control": "NetworkSeatsOptionsText",
      "text_contains": "Frame redundancy:"
    },
    {
      "op": "menu",
      "command": "assert_vertical_scroll NetworkSeatsOptionsText"
    },
    {
      "op": "wait",
      "elapsed_ms": 7000
    },
    {
      "op": "key_down",
      "key": "F6"
    },
    {
      "op": "key_up",
      "key": "F6"
    },
    {
      "op": "wait",
      "panel_open": false
    },
    {
      "op": "key_down",
      "key": "Escape"
    },
    {
      "op": "key_up",
      "key": "Escape"
    },
    {
      "op": "wait",
      "screen": "Pause",
      "elapsed_ms": 400
    },
    {
      "op": "menu",
      "command": "activate ButtonMatchOptions"
    },
    {
      "op": "wait",
      "screen": "PauseMatchOptions",
      "elapsed_ms": 400
    },
    {
      "op": "assert",
      "equals": {
        "service": "Running"
      }
    },
    {
      "op": "menu",
      "command": "assert_rect_inside MatchOptionsBox viewport"
    },
    {
      "op": "menu",
      "command": "assert_visible ButtonMatchRepairNow 0"
    },
    {
      "op": "menu",
      "command": "assert_label LabelMatchRepairHint Repair is the host's call"
    },
    {
      "op": "menu",
      "command": "dump_host_options"
    },
    {
      "op": "signal",
      "name": "ready"
    },
    {
      "op": "wait_file",
      "path": "{PROBE_DIR_host}/done.json"
    },
    {
      "op": "wait",
      "elapsed_ms": 1320
    },
    {
      "op": "menu",
      "command": "activate ButtonMatchOptionsClose"
    },
    {
      "op": "wait",
      "screen": "Pause",
      "elapsed_ms": 400
    },
    {
      "op": "menu",
      "command": "activate ButtonResume"
    },
    {
      "op": "wait",
      "screen": "Gameplay"
    },
    {
      "op": "menu",
      "command": "video_mark repair-post-play"
    },
    {
      "op": "wait",
      "elapsed_ms": 990
    },
    {
      "op": "signal",
      "name": "done"
    },
    {
      "op": "finish"
    }
  ]
}
