{
  "schema": 1,
  "name": "mp-held-seat",
  "port_base": 49476,
  "title": "Three peers; one seat drops at tick 300 and stays under the AI for a minute while the host and the other survivor play on (FeelBaseline: the human teams parked apart, no AI team, so the held seat's AI cannot end the survivors' minute)",
  "size": "960x540",
  "timeout_s": 240,
  "peers": [
    {
      "name": "host",
      "args": [
        "-seed",
        "42",
        "-max-ticks",
        "4300",
        "-tick-hashes",
        "-num-lua-states",
        "4",
        "-input-script",
        "{INPUT_SCRIPT}",
        "-out",
        "{OUT}/host_trace.json",
        "-net-match-report",
        "{OUT}/host-match.json"
      ],
      "input_script": "mp-held-seat.input.txt",
      "observe_after_failure": true,
      "settings": {
        "NetworkDisplayName": "Host",
        "NetworkIceEnable": "0",
        "NetworkShowDiagnostics": "1",
        "NetworkMatchStatusMode": "Always",
        "NetworkSlowPlayerBoundTicks": "3",
        "NetworkSlowPlayerPolicy": "Substitute"
      },
      "menu_script": "mp-held-seat.host.menu.txt",
      "probe": "mp-held-seat.observe.probe.json",
      "runtime_files": [
        {
          "copy": "tools/feel/FeelBaseline.lua",
          "to": "Userdata/UserScenes.rte/FeelBaseline.lua",
          "replace": [
            [
              "^local WINDOW_TICKS = \\d+;$",
              "local WINDOW_TICKS = 5400;"
            ]
          ]
        },
        {
          "to": "Userdata/UserScenes.rte/Index.ini",
          "write": "DataModule\n\tModuleName = User Scenes\n\tScanFolderContents = 1\n\tIgnoreMissingItems = 1\n\tAddActivity = GAScripted\n\t\tCopyOf = P4 Alpha Duel\n\t\tPresetName = Determinism FeelBaseline\n\t\tScriptPath = UserScenes.rte/FeelBaseline.lua\n\t\tLuaClassName = FeelBaseline\n\t\tTeamOfPlayer1 = 0\n\t\tPlayer1IsHuman = 1\n\t\tTeamOfPlayer2 = 1\n\t\tPlayer2IsHuman = 1\n"
        }
      ]
    },
    {
      "name": "clienta",
      "args": [
        "-seed",
        "42",
        "-max-ticks",
        "4300",
        "-tick-hashes",
        "-num-lua-states",
        "4",
        "-input-script",
        "{INPUT_SCRIPT}",
        "-out",
        "{OUT}/clienta_trace.json",
        "-net-match-report",
        "{OUT}/clienta-match.json"
      ],
      "input_script": "mp-held-seat.input.txt",
      "observe_after_failure": true,
      "settings": {
        "NetworkDisplayName": "ClientA",
        "NetworkIceEnable": "0",
        "NetworkShowDiagnostics": "1",
        "NetworkMatchStatusMode": "Always",
        "NetworkSlowPlayerBoundTicks": "3",
        "NetworkSlowPlayerPolicy": "Substitute"
      },
      "menu_script": "mp-host-migration.client.menu.txt",
      "start_when": {
        "peer": "host",
        "event": "video_mark migration-listening",
        "timeout_s": 90
      },
      "probe": "mp-held-seat.observe.probe.json",
      "runtime_files": [
        {
          "copy": "tools/feel/FeelBaseline.lua",
          "to": "Userdata/UserScenes.rte/FeelBaseline.lua",
          "replace": [
            [
              "^local WINDOW_TICKS = \\d+;$",
              "local WINDOW_TICKS = 5400;"
            ]
          ]
        },
        {
          "to": "Userdata/UserScenes.rte/Index.ini",
          "write": "DataModule\n\tModuleName = User Scenes\n\tScanFolderContents = 1\n\tIgnoreMissingItems = 1\n\tAddActivity = GAScripted\n\t\tCopyOf = P4 Alpha Duel\n\t\tPresetName = Determinism FeelBaseline\n\t\tScriptPath = UserScenes.rte/FeelBaseline.lua\n\t\tLuaClassName = FeelBaseline\n\t\tTeamOfPlayer1 = 0\n\t\tPlayer1IsHuman = 1\n\t\tTeamOfPlayer2 = 1\n\t\tPlayer2IsHuman = 1\n"
        }
      ]
    },
    {
      "name": "clientb",
      "args": [
        "-seed",
        "42",
        "-max-ticks",
        "4300",
        "-tick-hashes",
        "-num-lua-states",
        "4",
        "-input-script",
        "{INPUT_SCRIPT}",
        "-out",
        "{OUT}/clientb_trace.json",
        "-net-match-report",
        "{OUT}/clientb-match.json"
      ],
      "input_script": "mp-held-seat.input.txt",
      "observe_after_failure": true,
      "settings": {
        "NetworkDisplayName": "ClientB",
        "NetworkIceEnable": "0",
        "NetworkShowDiagnostics": "1",
        "NetworkMatchStatusMode": "Always",
        "NetworkSlowPlayerBoundTicks": "3",
        "NetworkSlowPlayerPolicy": "Substitute"
      },
      "menu_script": "mp-host-migration.client.menu.txt",
      "start_when": {
        "peer": "clienta",
        "event": "video_mark migration-client-admitted",
        "timeout_s": 90
      },
      "kill_at_tick": 300,
      "runtime_files": [
        {
          "copy": "tools/feel/FeelBaseline.lua",
          "to": "Userdata/UserScenes.rte/FeelBaseline.lua",
          "replace": [
            [
              "^local WINDOW_TICKS = \\d+;$",
              "local WINDOW_TICKS = 5400;"
            ]
          ]
        },
        {
          "to": "Userdata/UserScenes.rte/Index.ini",
          "write": "DataModule\n\tModuleName = User Scenes\n\tScanFolderContents = 1\n\tIgnoreMissingItems = 1\n\tAddActivity = GAScripted\n\t\tCopyOf = P4 Alpha Duel\n\t\tPresetName = Determinism FeelBaseline\n\t\tScriptPath = UserScenes.rte/FeelBaseline.lua\n\t\tLuaClassName = FeelBaseline\n\t\tTeamOfPlayer1 = 0\n\t\tPlayer1IsHuman = 1\n\t\tTeamOfPlayer2 = 1\n\t\tPlayer2IsHuman = 1\n"
        }
      ]
    }
  ],
  "checklist": [
    {
      "id": "held-seat-host-plays-on",
      "peer": "host",
      "screen": "game",
      "sim_ticks": [
        300,
        4200
      ],
      "what": "The host plays on for a minute with ClientB's seat under the AI.",
      "gate": "scenario-behavior"
    },
    {
      "id": "held-seat-survivor-plays-on",
      "peer": "clienta",
      "screen": "game",
      "sim_ticks": [
        300,
        4200
      ],
      "what": "The other survivor plays on beside the held seat.",
      "gate": "scenario-behavior"
    }
  ],
  "behavior_gate": {
    "kind": "held-seat",
    "target": "clientb",
    "observers": [
      "host",
      "clienta"
    ],
    "holds": 1,
    "reports": {
      "host": "host-match.json",
      "clienta": "clienta-match.json"
    },
    "ticks": {
      "host": 4200,
      "clienta": 4200
    },
    "steady_peers": [
      "host",
      "clienta"
    ]
  }
}
