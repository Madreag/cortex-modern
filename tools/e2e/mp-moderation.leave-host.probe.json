{
  "schema": 1,
  "timeout_ms": 180000,
  "steps": [
    {
      "op": "wait",
      "service": "Running",
      "sim_at_least": 800
    },
    {
      "op": "key_down",
      "key": "F6"
    },
    {
      "op": "key_up",
      "key": "F6"
    },
    {
      "op": "wait",
      "panel_open": true
    },
    {
      "op": "assert_control",
      "control": "NetworkSeatDetail0",
      "text_contains": "Held - AI in control"
    },
    {
      "op": "assert_control",
      "control": "NetworkSeatDetail0",
      "text_contains": "Left "
    },
    {
      "op": "menu",
      "command": "video_mark host-seats-after-leave"
    },
    {
      "op": "wait",
      "control": "NetworkSeatApplicant0",
      "text_contains": "newcomer"
    },
    {
      "op": "assert_control",
      "control": "NetworkSeatApplicant0",
      "text_contains": "newcomer"
    },
    {
      "op": "mouse_down",
      "control": "NetworkSeatApplicant0",
      "item": 0
    },
    {
      "op": "wait",
      "renders": 3
    },
    {
      "op": "mouse_up",
      "control": "NetworkSeatApplicant0",
      "item": 0
    },
    {
      "op": "wait",
      "renders": 4
    },
    {
      "op": "assert_control",
      "control": "NetworkSeatName0",
      "text_contains": "leaver"
    },
    {
      "op": "assert_control",
      "control": "NetworkSeatSubstitute0",
      "equals": {
        "enabled": true
      },
      "text_contains": "Let newcomer join"
    },
    {
      "op": "menu",
      "command": "video_mark host-accepts-newcomer"
    },
    {
      "op": "mouse_down",
      "control": "NetworkSeatSubstitute0"
    },
    {
      "op": "wait",
      "control": "NetworkSeatSubstitute0",
      "equals": {
        "pushed": true
      }
    },
    {
      "op": "mouse_up",
      "control": "NetworkSeatSubstitute0"
    },
    {
      "op": "wait",
      "renders": 4
    },
    {
      "op": "assert_control",
      "control": "NetworkSeatsStatus",
      "text_contains": "newcomer takes leaver's place"
    },
    {
      "op": "mouse_down",
      "control": "NetworkSeatSubstitute0"
    },
    {
      "op": "wait",
      "control": "NetworkSeatSubstitute0",
      "equals": {
        "pushed": true
      }
    },
    {
      "op": "mouse_up",
      "control": "NetworkSeatSubstitute0"
    },
    {
      "op": "menu",
      "command": "video_mark host-accepted-newcomer"
    },
    {
      "op": "wait",
      "sim_at_least": 2400
    },
    {
      "op": "assert",
      "equals": {
        "service": "Running"
      },
      "sim_at_least": 2400
    },
    {
      "op": "key_down",
      "key": "F6"
    },
    {
      "op": "key_up",
      "key": "F6"
    },
    {
      "op": "wait",
      "panel_open": false
    },
    {
      "op": "finish"
    }
  ]
}
