{
  "schema": 1,
  "timeout_ms": 180000,
  "steps": [
    {
      "op": "wait",
      "service": "Running",
      "sim_at_least": 800
    },
    {
      "op": "key_down",
      "key": "F6"
    },
    {
      "op": "key_up",
      "key": "F6"
    },
    {
      "op": "wait",
      "panel_open": true
    },
    {
      "op": "assert_control",
      "control": "NetworkSeatDetail0",
      "text_contains": "Held - AI in control"
    },
    {
      "op": "assert_control",
      "control": "NetworkSeatDetail0",
      "text_contains": "Left "
    },
    {
      "op": "menu",
      "command": "video_mark host-seats-after-leave"
    },
    {
      "op": "wait",
      "sim_at_least": 2400
    },
    {
      "op": "assert",
      "equals": {
        "service": "Running"
      },
      "sim_at_least": 2400
    },
    {
      "op": "key_down",
      "key": "F6"
    },
    {
      "op": "key_up",
      "key": "F6"
    },
    {
      "op": "wait",
      "panel_open": false
    },
    {
      "op": "finish"
    }
