{
  "schema": 1,
  "name": "mp-leave",
  "title": "A leaving player and a held player hand their seats to AI while two survivors play on",
  "port_base": 49459,
  "size": "960x540",
  "timeout_s": 240,
  "runs": [
    {
      "name": "announced",
      "peers": [
        {
          "name": "host",
          "args": [
            "-net-match-service-e2e",
            "-net-port",
            "{PORT}",
            "-net-match-peers",
            "3",
            "-net-match-humans",
            "3",
            "-net-match-cpu-slots",
            "0",
            "-net-match-ticks",
            "3600",
            "-net-match-auto-delay",
            "-net-autosave-seconds",
            "0",
            "-num-lua-states",
            "4",
            "-seed",
            "42",
            "-input-script",
            "{INPUT_SCRIPT}",
            "-net-match-report",
            "{OUT}/host-match.json",
            "-out",
            "{OUT}/host_trace.json",
            "-tick-hashes",
            "-net-player-name",
            "host",
            "-net-host"
          ],
          "input_script": "play-input.txt",
          "settings": {
            "NetworkSlowPlayerBoundTicks": "3",
            "NetworkSlowPlayerPolicy": "Substitute",
            "NetworkShowDiagnostics": "1",
            "NetworkMatchStatusMode": "Always"
          },
          "start_delay_s": 0,
          "probe": "mp-leave.announced-host.probe.json"
        },
        {
          "name": "leaver",
          "args": [
            "-net-match-service-e2e",
            "-net-port",
            "{PORT}",
            "-net-match-peers",
            "3",
            "-net-match-humans",
            "3",
            "-net-match-cpu-slots",
            "0",
            "-net-match-ticks",
            "3600",
            "-net-match-auto-delay",
            "-net-autosave-seconds",
            "0",
            "-num-lua-states",
            "4",
            "-seed",
            "42",
            "-input-script",
            "{INPUT_SCRIPT}",
            "-net-match-report",
            "{OUT}/leaver-match.json",
            "-out",
            "{OUT}/leaver_trace.json",
            "-tick-hashes",
            "-net-player-name",
            "leaver",
            "-net-join",
            "127.0.0.1",
            "-net-match-e2e-leave",
            "-net-match-e2e-leave-tick",
            "600"
          ],
          "input_script": "play-input.txt",
          "settings": {
            "NetworkSlowPlayerBoundTicks": "3",
            "NetworkSlowPlayerPolicy": "Substitute",
            "NetworkShowDiagnostics": "1",
            "NetworkMatchStatusMode": "Always"
          },
          "start_delay_s": 1,
          "menu_script": "mp-leave.leaver.menu.txt",
          "probe": "mp-leave.leaver.probe.json"
        },
        {
          "name": "survivor",
          "args": [
            "-net-match-service-e2e",
            "-net-port",
            "{PORT}",
            "-net-match-peers",
            "3",
            "-net-match-humans",
            "3",
            "-net-match-cpu-slots",
            "0",
            "-net-match-ticks",
            "3600",
            "-net-match-auto-delay",
            "-net-autosave-seconds",
            "0",
            "-num-lua-states",
            "4",
            "-seed",
            "42",
            "-input-script",
            "{INPUT_SCRIPT}",
            "-net-match-report",
            "{OUT}/survivor-match.json",
            "-out",
            "{OUT}/survivor_trace.json",
            "-tick-hashes",
            "-net-player-name",
            "survivor",
            "-net-join",
            "127.0.0.1"
          ],
          "input_script": "play-input.txt",
          "settings": {
            "NetworkSlowPlayerBoundTicks": "3",
            "NetworkSlowPlayerPolicy": "Substitute",
            "NetworkShowDiagnostics": "1",
            "NetworkMatchStatusMode": "Always"
          },
          "start_delay_s": 5,
          "probe": "mp-leave.announced-survivor.probe.json"
        }
      ]
    },
    {
      "name": "held",
      "peers": [
        {
          "name": "host",
          "args": [
            "-net-match-service-e2e",
            "-net-port",
            "{PORT}",
            "-net-match-peers",
            "3",
            "-net-match-humans",
            "3",
            "-net-match-cpu-slots",
            "0",
            "-net-match-ticks",
            "1200",
            "-net-match-auto-delay",
            "-net-autosave-seconds",
            "0",
            "-num-lua-states",
            "4",
            "-seed",
            "42",
            "-input-script",
            "{INPUT_SCRIPT}",
            "-net-match-report",
            "{OUT}/host-match.json",
            "-out",
            "{OUT}/host_trace.json",
            "-tick-hashes",
            "-net-player-name",
            "host",
            "-net-host"
          ],
          "input_script": "play-input.txt",
          "settings": {
            "NetworkSlowPlayerBoundTicks": "3",
            "NetworkSlowPlayerPolicy": "Substitute",
            "NetworkShowDiagnostics": "1",
            "NetworkMatchStatusMode": "Always"
          },
          "start_delay_s": 0,
          "probe": "mp-leave.survivor.probe.json"
        },
        {
          "name": "leaver",
          "args": [
            "-net-match-service-e2e",
            "-net-port",
            "{PORT}",
            "-net-match-peers",
            "3",
            "-net-match-humans",
            "3",
            "-net-match-cpu-slots",
            "0",
            "-net-match-ticks",
            "1200",
            "-net-match-auto-delay",
            "-net-autosave-seconds",
            "0",
            "-num-lua-states",
            "4",
            "-seed",
            "42",
            "-input-script",
            "{INPUT_SCRIPT}",
            "-net-match-report",
            "{OUT}/leaver-match.json",
            "-out",
            "{OUT}/leaver_trace.json",
            "-tick-hashes",
            "-net-player-name",
            "leaver",
            "-net-join",
            "127.0.0.1",
            "-selftest-frame-stall",
            "600:1500"
          ],
          "input_script": "play-input.txt",
          "settings": {
            "NetworkSlowPlayerBoundTicks": "3",
            "NetworkSlowPlayerPolicy": "Substitute",
            "NetworkShowDiagnostics": "1",
            "NetworkMatchStatusMode": "Always"
          },
          "start_delay_s": 1,
          "observe_after_failure": true
        },
        {
          "name": "survivor",
          "args": [
            "-net-match-service-e2e",
            "-net-port",
            "{PORT}",
            "-net-match-peers",
            "3",
            "-net-match-humans",
            "3",
            "-net-match-cpu-slots",
            "0",
            "-net-match-ticks",
            "1200",
            "-net-match-auto-delay",
            "-net-autosave-seconds",
            "0",
            "-num-lua-states",
            "4",
            "-seed",
            "42",
            "-input-script",
            "{INPUT_SCRIPT}",
            "-net-match-report",
            "{OUT}/survivor-match.json",
            "-out",
            "{OUT}/survivor_trace.json",
            "-tick-hashes",
            "-net-player-name",
            "survivor",
            "-net-join",
            "127.0.0.1"
          ],
          "input_script": "play-input.txt",
          "settings": {
            "NetworkSlowPlayerBoundTicks": "3",
            "NetworkSlowPlayerPolicy": "Substitute",
            "NetworkShowDiagnostics": "1",
            "NetworkMatchStatusMode": "Always"
          },
          "start_delay_s": 5,
          "probe": "mp-leave.survivor.probe.json"
        }
      ]
    },
    {
      "name": "held-window",
      "peers": [
        {
          "name": "host",
          "args": [
            "-net-match-service-e2e",
            "-net-port",
            "{PORT}",
            "-net-match-peers",
            "2",
            "-net-match-humans",
            "2",
            "-net-match-cpu-slots",
            "0",
            "-net-match-ticks",
            "4200",
            "-net-match-auto-delay",
            "-net-autosave-seconds",
            "0",
            "-num-lua-states",
            "4",
            "-seed",
            "42",
            "-input-script",
            "{INPUT_SCRIPT}",
            "-net-match-report",
            "{OUT}/host-window-match.json",
            "-out",
            "{OUT}/host_window_trace.json",
            "-tick-hashes",
            "-net-player-name",
            "host",
            "-net-host",
            "-net-match-service-preset",
            "Determinism FeelBaseline",
            "-net-match-service-module",
            "UserScenes.rte"
          ],
          "input_script": "play-input.txt",
          "settings": {
            "NetworkSlowPlayerBoundTicks": "3",
            "NetworkSlowPlayerPolicy": "Substitute",
            "NetworkShowDiagnostics": "1",
            "NetworkMatchStatusMode": "Always"
          },
          "start_delay_s": 0,
          "runtime_files": [
            {
              "copy": "tools/feel/FeelBaseline.lua",
              "to": "Userdata/UserScenes.rte/FeelBaseline.lua",
              "replace": [
                [
                  "^local WINDOW_TICKS = \\d+;$",
                  "local WINDOW_TICKS = 6000;"
                ]
              ]
            },
            {
              "to": "Userdata/UserScenes.rte/Index.ini",
              "write": "DataModule\n\tModuleName = User Scenes\n\tScanFolderContents = 1\n\tIgnoreMissingItems = 1\n\tAddActivity = GAScripted\n\t\tCopyOf = P4 Alpha Duel\n\t\tPresetName = Determinism FeelBaseline\n\t\tScriptPath = UserScenes.rte/FeelBaseline.lua\n\t\tLuaClassName = FeelBaseline\n\t\tIsTestActivity = 1\n\t\tTeamOfPlayer1 = 0\n\t\tPlayer1IsHuman = 1\n\t\tTeamOfPlayer2 = 1\n\t\tPlayer2IsHuman = 1\n"
            }
          ]
        },
        {
          "name": "leaver",
          "args": [
            "-net-match-service-e2e",
            "-net-port",
            "{PORT}",
            "-net-match-peers",
            "2",
            "-net-match-humans",
            "2",
            "-net-match-cpu-slots",
            "0",
            "-net-match-ticks",
            "4200",
            "-net-match-auto-delay",
            "-net-autosave-seconds",
            "0",
            "-num-lua-states",
            "4",
            "-seed",
            "42",
            "-input-script",
            "{INPUT_SCRIPT}",
            "-net-match-report",
            "{OUT}/leaver-window-match.json",
            "-out",
            "{OUT}/leaver_window_trace.json",
            "-tick-hashes",
            "-net-player-name",
            "leaver",
            "-net-join",
            "127.0.0.1",
            "-net-match-e2e-leave",
            "-net-match-e2e-leave-tick",
            "600",
            "-net-match-service-preset",
            "Determinism FeelBaseline",
            "-net-match-service-module",
            "UserScenes.rte"
          ],
          "input_script": "play-input.txt",
          "settings": {
            "NetworkSlowPlayerBoundTicks": "3",
            "NetworkSlowPlayerPolicy": "Substitute",
            "NetworkShowDiagnostics": "1",
            "NetworkMatchStatusMode": "Always"
          },
          "start_delay_s": 1,
          "menu_script": "mp-leave.window-leaver.menu.txt",
          "probe": "mp-leave.window-leaver.probe.json",
          "runtime_files": [
            {
              "copy": "tools/feel/FeelBaseline.lua",
              "to": "Userdata/UserScenes.rte/FeelBaseline.lua",
              "replace": [
                [
                  "^local WINDOW_TICKS = \\d+;$",
                  "local WINDOW_TICKS = 6000;"
                ]
              ]
            },
            {
              "to": "Userdata/UserScenes.rte/Index.ini",
              "write": "DataModule\n\tModuleName = User Scenes\n\tScanFolderContents = 1\n\tIgnoreMissingItems = 1\n\tAddActivity = GAScripted\n\t\tCopyOf = P4 Alpha Duel\n\t\tPresetName = Determinism FeelBaseline\n\t\tScriptPath = UserScenes.rte/FeelBaseline.lua\n\t\tLuaClassName = FeelBaseline\n\t\tIsTestActivity = 1\n\t\tTeamOfPlayer1 = 0\n\t\tPlayer1IsHuman = 1\n\t\tTeamOfPlayer2 = 1\n\t\tPlayer2IsHuman = 1\n"
            }
          ]
        }
      ]
    }
  ],
  "checklist": [
    {
      "id": "announced-before",
      "what": "Both survivors show the original three-seat match before tick 600.",
      "screen": "game",
      "assert": "Running service, gameplay frames and scripted movement",
      "run": "announced",
      "sim_ticks": [
        30,
        590
      ]
    },
    {
      "id": "announced-continues",
      "what": "The host continues to advance after the departure, with the seat under AI control.",
      "screen": "game",
      "assert": "Probe asserts Running at tick 1000; inspect the AI seat and acting units",
      "peer": "host",
      "run": "announced",
      "sim_ticks": [
        620,
        1100
      ]
    },
    {
      "id": "announced-survivor",
      "what": "The second surviving peer also continues; its overlay reflects the departed seat.",
      "screen": "game",
      "assert": "Probe asserts Running at tick 1000 and opens F6",
      "peer": "survivor",
      "run": "announced",
      "sim_ticks": [
        620,
        1100
      ]
    },
    {
      "id": "held-before",
      "what": "Both survivors show the original three-seat match before tick 600.",
      "screen": "game",
      "assert": "Running service, gameplay frames and scripted movement",
      "run": "held",
      "sim_ticks": [
        30,
        590
      ]
    },
    {
      "id": "held-continues",
      "what": "The host continues to advance after the departure, with the seat under AI control.",
      "screen": "game",
      "assert": "Probe asserts Running at tick 1000; inspect the AI seat and acting units",
      "peer": "host",
      "run": "held",
      "sim_ticks": [
        620,
        1100
      ]
    },
    {
      "id": "held-survivor",
      "what": "The second surviving peer also continues; its overlay reflects the departed seat.",
      "screen": "game",
      "assert": "Probe asserts Running at tick 1000 and opens F6",
      "peer": "survivor",
      "run": "held",
      "sim_ticks": [
        620,
        1100
      ]
    },
    {
      "id": "held-ai",
      "what": "The silent seat is held at an agreed frame and its units keep acting.",
      "screen": "game",
      "assert": "host log: hold peer=2 ... AI in control; inspect post-hold unit motion",
      "peer": "host",
      "run": "held",
      "sim_ticks": [
        600,
        1200
      ],
      "log_regex": [
        "\\[net-match\\] hold peer=2 frame=\\d+ AI in control"
      ]
    },
    {
      "id": "announced-ai-label",
      "peer": "host",
      "run": "announced",
      "screen": "game",
      "mark": "survivor-after-leave",
      "what": "The departed seat reads Held - AI in control: it is still its player's.",
      "probe_steps": [
        9
      ]
    },
    {
      "id": "held-client-rejoining",
      "peer": "leaver",
      "run": "held",
      "screen": "game",
      "sim_ticks": [
        600,
        800
      ],
      "what": "The held client catches up in place on the game screen under the 'Held - AI in control - rejoining' toast, then returns to play.",
      "assert": "Private catch-up completes in place in the held client log; its match report carries the held toast; its game frames through the catch-up are recorded.",
      "log_regex": [
        "\\[net-match\\] private catch-up complete frame=\\d+ in_place=1"
      ],
      "report_toasts": {
        "report": "{peer}-match.json",
        "require": [
          {
            "kind": "seat_held",
            "text": "^Held - AI in control - rejoining$",
            "ticks": [
              600,
              800
            ]
          }
        ]
      }
    },
    {
      "id": "announced-ai-toast-host",
      "peer": "host",
      "run": "announced",
      "screen": "game",
      "mark": "survivor-after-leave",
      "what": "The departure toast names leaver and says AI in control while the survivors keep playing.",
      "probe_steps": [
        2
      ],
      "readback": [
        {
          "step": 2,
          "path": [
            "control",
            "text"
          ],
          "contains": "AI in control"
        },
        {
          "step": 2,
          "path": [
            "control",
            "text"
          ],
          "contains": "leaver"
        },
        {
          "step": 2,
          "path": [
            "control",
            "visible"
          ],
          "equals": true
        }
      ]
    },
    {
      "id": "announced-ai-toast-survivor",
      "peer": "survivor",
      "run": "announced",
      "screen": "game",
      "mark": "survivor-after-leave",
      "what": "The departure toast names leaver and says AI in control while the survivors keep playing.",
      "probe_steps": [
        2
      ],
      "readback": [
        {
          "step": 2,
          "path": [
            "control",
            "text"
          ],
          "contains": "AI in control"
        },
        {
          "step": 2,
          "path": [
            "control",
            "text"
          ],
          "contains": "leaver"
        },
        {
          "step": 2,
          "path": [
            "control",
            "visible"
          ],
          "equals": true
        }
      ]
    },
    {
      "id": "announced-ai-roster-once",
      "run": "announced",
      "peer": "survivor",
      "mark": "survivor-after-leave",
      "what": "The remote roster names AI control once for the departed seat.",
      "readback": [
        {
          "step": 9,
          "path": [
            "control",
            "text"
          ],
          "contains": "AI in control"
        },
        {
          "step": 9,
          "path": [
            "control",
            "text"
          ],
          "not_contains": "AI in control - AI in control"
        }
      ]
    },
    {
      "id": "announced-toast-band-host",
      "run": "announced",
      "peer": "host",
      "mark": "survivor-after-leave",
      "what": "The departure toasts lie inside the screen and clear of the open seats panel.",
      "assert": "The probe's own refused-step record: a failed readback stops the probe at that index.",
      "probe_steps": [
        7
      ]
    },
    {
      "id": "announced-toast-band-survivor",
      "run": "announced",
      "peer": "survivor",
      "mark": "survivor-after-leave",
      "what": "The departure toasts lie inside the screen and clear of the open seats panel.",
      "assert": "The probe's own refused-step record: a failed readback stops the probe at that index.",
      "probe_steps": [
        7
      ]
    },
    {
      "id": "announced-roster-names",
      "run": "announced",
      "peer": "survivor",
      "screen": "game",
      "mark": "survivor-after-leave",
      "what": "The F6 roster names host, leaver and survivor beside their states.",
      "probe_steps": [
        9
      ],
      "readback": [
        {
          "step": 9,
          "path": [
            "control",
            "text"
          ],
          "contains": "leaver"
        },
        {
          "step": 9,
          "path": [
            "control",
            "text"
          ],
          "contains": "host"
        },
        {
          "step": 9,
          "path": [
            "control",
            "text"
          ],
          "contains": "survivor"
        }
      ]
    },
    {
      "id": "announced-roster-state",
      "run": "announced",
      "peer": "survivor",
      "screen": "game",
      "mark": "survivor-after-leave",
      "what": "The departed row uses the same Held - AI in control phrase as the seat detail.",
      "probe_steps": [
        9
      ],
      "readback": [
        {
          "step": 9,
          "path": [
            "control",
            "text"
          ],
          "contains": "Held - AI in control"
        }
      ]
    },
    {
      "id": "announced-toast-state",
      "run": "announced",
      "peer": "host",
      "screen": "game",
      "mark": "survivor-after-leave",
      "what": "The departure toast names the player and uses Held - AI in control.",
      "probe_steps": [
        2
      ],
      "readback": [
        {
          "step": 2,
          "path": [
            "control",
            "text"
          ],
          "contains": "leaver: Held - AI in control"
        }
      ]
    },
    {
      "id": "held-survivor-not-held",
      "run": "held",
      "peer": "survivor",
      "screen": "game",
      "sim_ticks": [
        600,
        1200
      ],
      "what": "The unimpaired survivor keeps playing without being held.",
      "assert": "No hold for peer 3 in the survivor log.",
      "forbidden_log_regex": [
        "hold peer=3 frame=",
        "PeerHeld:"
      ]
    },
    {
      "id": "announced-seat-cause",
      "peer": "host",
      "run": "announced",
      "screen": "game",
      "mark": "survivor-after-leave",
      "what": "The host's Seats panel holds the left seat for its player and names why: Held - AI in control / Left N s ago.",
      "probe_steps": [
        10,
        11
      ],
      "readback": [
        {
          "step": 10,
          "path": [
            "control",
            "text"
          ],
          "contains": "Held - AI in control"
        },
        {
          "step": 11,
          "path": [
            "control",
            "text"
          ],
          "contains": "Left "
        }
      ]
    },
    {
      "id": "announced-rejoin-offer",
      "peer": "leaver",
      "run": "announced",
      "screen": "MultiplayerScreen",
      "mark": "leaver-rejoin-offer",
      "what": "Back at the menu after its leave, the leaver's landing offers Rejoin Match."
    },
    {
      "id": "announced-leaver-back",
      "peer": "leaver",
      "run": "announced",
      "screen": "game",
      "mark": "leaver-back",
      "what": "Rejoin Match brings the leaver back into its own seat and it plays on while the match runs.",
      "assert": "The leaver's probe asserts Running at tick 2700 after its rejoin, in its own seat; the host plays on to tick 3000.",
      "probe_steps": [
        2
      ],
      "ownership_reclaim": {
        "native": true
      }
    },
    {
      "id": "window-seat-survives",
      "run": "held-window",
      "peer": "host",
      "screen": "game",
      "sim_ticks": [
        600,
        4200
      ],
      "what": "A left seat stays its player's past the 20 s hold window: the host never releases it and the AI keeps playing it.",
      "assert": "host log: the seat held at the leave, never released",
      "log_regex": [
        "\\[net-match\\] hold peer=2 frame=\\d+ AI in control"
      ],
      "forbidden_log_regex": [
        "seat released peer=2"
      ]
    },
    {
      "id": "window-leaver-back",
      "run": "held-window",
      "peer": "leaver",
      "screen": "game",
      "mark": "window-leaver-back",
      "what": "The leaver presses Rejoin Match 25 s after its leave, past the hold window, and plays on in its own seat.",
      "assert": "The leaver's probe asserts Running at tick 3000 after its rejoin.",
      "probe_steps": [
        2
      ],
      "ownership_reclaim": {
        "native": true
      }
    }
  ]
}
