{
  "version": 1,
  "boxes": [
    {
      "name": "EROL-PC", "kind": "windows-local",
      "peers_per_box": 1,
      "guard_file": "D:/mx/BOX-FREE-FOR-CROSS",
      "exclusive_marker": "D:/mx/FEEL-MATRIX-RUNNING",
      "tree": "D:/Projects/alias-walk", "executable": "D:/Projects/alias-walk/Cortex Command.exe",
      "runner": "tools/win32_test_runner.py via run_sim_test.make_run",
      "ports": [49900, 49919], "directory_port": 49918,
      "sampler": "engine-process-handle", "scratch": "D:/mx/{lane}",
      "python": "python"
    },
    {
      "name": "EDITH", "kind": "windows-task", "ssh": "edith",
      "peers_per_box": 1,
      "tree": "D:/mx/{lane}/engine", "executable": "D:/mx/{lane}/engine/Cortex Command.exe",
      "runner": "cortex-session1", "task_script": "D:/mx/session1/run.ps1",
      "ports": [49900, 49919], "directory_port": 49985,
      "sampler": "engine-process-handle", "scratch": "D:/mx/{lane}",
      "python": "python"
    },
    {
      "name": "Mac", "kind": "posix-ssh", "ssh": "Erol-Mac",
      "peers_per_box": 1,
      "tree": "/Users/erol/cortex-workers/{lane}/repo",
      "executable": "/Users/erol/cortex-workers/{lane}/repo/build-gcc/CortexCommand",
      "runner": "tools/posix_test_runner.py via run_sim_test.make_run over ssh",
      "ports": [49900, 49919], "directory_port": 49918,
      "sampler": "engine-pid-ps", "scratch": "/Users/erol/cortex-workers/{lane}",
      "python": "/opt/homebrew/bin/python3",
      "guard_file": "{mac_guard}"
    },
    {
      "name": "Linux", "kind": "posix-ssh", "ssh": "3090",
      "peers_per_box": 1,
      "tree": "/home/erol/cortex-workers/opus-run-cross-linux-20260928/repo",
      "executable": "/home/erol/cortex-workers/opus-run-cross-linux-20260928/repo/build-gcc/CortexCommand",
      "runner": "tools/posix_test_runner.py via run_sim_test.make_run over ssh",
      "ports": [50310, 50319], "directory_port": 50318,
      "sampler": "engine-pid-ps", "scratch": "/home/erol/cortex-workers/opus-run-cross-linux-20260928/runs/{lane}",
      "python": "/usr/bin/python3",
      "guard_file": "/home/erol/cortex-workers/opus-run-cross-linux-20260928/BOX-FREE-FOR-CROSS"
    }
  ],
  "instances": [
    {"name": "erol", "box": "EROL-PC", "port_block": [49900, 49904], "seat": "player"},
    {"name": "edith", "box": "EDITH", "port_block": [49900, 49904], "seat": "player"},
    {"name": "mac", "box": "Mac", "port_block": [49900, 49904], "seat": "player"},
    {"name": "linux", "box": "Linux", "port_block": [50310, 50314], "seat": "player", "rosters": ["four-way"]}
  ]
}
