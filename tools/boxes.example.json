{
  "about": "The shape of the box file the multi-machine tools read (tools/box_facts.py). Copy it to ~/.cortex-modern/boxes.json (or point CORTEX_BOXES at a copy) and write your own machines in; that copy stays outside every work tree. Names, aliases and paths here are neutral and the addresses are documentation addresses; the unit tests run against this file.",
  "schema": 1,
  "users": [
    "player"
  ],
  "boxes": [
    {
      "role": "pc",
      "name": "box-a",
      "instance": "peer-a",
      "hostname": "BOX-A",
      "ssh": null,
      "aliases": [],
      "os": "windows",
      "user": "player",
      "home": "home/player",
      "scratch": "scratch",
      "markers": {
        "timing": "scratch/TIMING-RUN",
        "cross-free": "scratch/FREE-FOR-CROSS",
        "verification": "scratch/VERIFICATION.lock",
        "battery": "scratch/BATTERY.lock",
        "exclusive": "scratch/EXCLUSIVE.lock",
        "harness": "scratch/HARNESS.lock"
      }
    },
    {
      "role": "remote",
      "name": "box-b",
      "instance": "peer-b",
      "hostname": "BOX-B",
      "ssh": "host-b",
      "aliases": [
        "host-b-lan"
      ],
      "os": "windows",
      "user": "player",
      "home": "home/player"
    },
    {
      "role": "mac",
      "name": "box-c",
      "instance": "peer-c",
      "hostname": "BOX-C",
      "ssh": "host-c",
      "aliases": [],
      "os": "macos",
      "user": "player",
      "home": "home/player"
    },
    {
      "role": "linux",
      "name": "box-d",
      "instance": "peer-d",
      "hostname": "BOX-D",
      "ssh": "host-d",
      "aliases": [
        "host-d.local"
      ],
      "os": "linux",
      "user": "player",
      "home": "home/player"
    },
    {
      "role": "laptop",
      "name": "box-e",
      "instance": "peer-e",
      "hostname": "BOX-E",
      "ssh": "host-e",
      "aliases": [
        "host-e-vpn"
      ],
      "os": "windows",
      "user": "player",
      "home": "home/player"
    },
    {
      "role": "handheld",
      "name": "box-f",
      "instance": "peer-f",
      "hostname": "BOX-F",
      "ssh": "host-f",
      "aliases": [
        "host-f-vpn"
      ],
      "os": "windows",
      "user": "player",
      "home": "home/player"
    }
  ],
  "paths": {
    "relay_coturn_config": "scratch/relay/directory-coturn.json",
    "relay_cloudflare_config": "scratch/relay/turn-config-cloudflare.json"
  },
  "cross_peers": {
    "version": 1,
    "boxes": [
      {
        "name": "box-a",
        "kind": "windows-local",
        "peers_per_box": 1,
        "guard_file": "scratch/FREE-FOR-CROSS",
        "exclusive_marker": "scratch/TIMING-RUN",
        "tree": "work/cross-tree",
        "executable": "work/cross-tree/Cortex Command.exe",
        "runner": "tools/win32_test_runner.py via run_sim_test.make_run",
        "ports": [
          49900,
          49919
        ],
        "directory_port": 49918,
        "sampler": "engine-process-handle",
        "scratch": "scratch/{lane}",
        "python": "python"
      },
      {
        "name": "box-b",
        "kind": "windows-task",
        "ssh": "host-b",
        "peers_per_box": 1,
        "tree": "scratch/{lane}/engine",
        "executable": "scratch/{lane}/engine/Cortex Command.exe",
        "runner": "cortex-session1",
        "task_script": "scratch/session1/run.ps1",
        "ports": [
          49900,
          49919
        ],
        "directory_port": 49985,
        "sampler": "engine-process-handle",
        "scratch": "scratch/{lane}",
        "python": "python"
      },
      {
        "name": "box-d",
        "kind": "posix-ssh",
        "ssh": "host-d",
        "environment": {
          "DISPLAY": ":0"
        },
        "peers_per_box": 1,
        "tree": "workers/cross-linux/repo",
        "executable": "workers/cross-linux/repo/build-gcc/CortexCommand",
        "runner": "tools/posix_test_runner.py via run_sim_test.make_run over ssh",
        "ports": [
          50310,
          50319
        ],
        "directory_port": 50318,
        "sampler": "engine-pid-ps",
        "scratch": "workers/cross-linux/runs/{lane}",
        "python": "/usr/bin/python3",
        "guard_file": "workers/cross-linux/BOX-FREE-FOR-CROSS"
      },
      {
        "name": "box-c",
        "kind": "posix-ssh",
        "ssh": "host-c",
        "peers_per_box": 1,
        "tree": "workers/{lane}/repo",
        "executable": "workers/{lane}/repo/build-gcc/CortexCommand",
        "runner": "tools/posix_test_runner.py via run_sim_test.make_run over ssh",
        "ports": [
          49900,
          49919
        ],
        "directory_port": 49918,
        "sampler": "engine-pid-ps",
        "scratch": "workers/{lane}",
        "python": "/opt/homebrew/bin/python3",
        "guard_file": "{mac_guard}"
      }
    ],
    "instances": [
      {
        "name": "peer-a",
        "box": "box-a",
        "port_block": [
          49900,
          49904
        ],
        "seat": "player"
      },
      {
        "name": "peer-b",
        "box": "box-b",
        "port_block": [
          49900,
          49904
        ],
        "seat": "player"
      },
      {
        "name": "peer-c",
        "box": "box-c",
        "port_block": [
          49900,
          49904
        ],
        "seat": "player"
      },
      {
        "name": "peer-d",
        "box": "box-d",
        "port_block": [
          50310,
          50314
        ],
        "seat": "player",
        "rosters": [
          "four-way"
        ]
      }
    ]
  }
}
