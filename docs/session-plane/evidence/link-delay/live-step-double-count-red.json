  "source_diff": "diff --git a/Source/Main.cpp b/Source/Main.cpp\nindex e5086d4ce..5a806fad3 100644\n--- a/Source/Main.cpp\n+++ b/Source/Main.cpp\n@@ -10893,6 +10893,9 @@ std::string BuildNetMatchServiceE2EReportJson(int exitCode, const std::string& s\n \tout << \"\\\"frames_planned\\\":\" << (s_netLockstepTicks > 0 ? s_netLockstepTicks : 600) << \",\";\n \tout << \"\\\"local_prediction\\\":{\\\"enabled\\\":\" << (LocalPrediction::IsEnabled() ? \"true\" : \"false\")\n \t    << \",\\\"previews\\\":\" << LocalPrediction::GetPreviewCount() << \",\\\"actor_ticks\\\":\" << LocalPrediction::GetPreviewTicks()\n+\t    << \",\\\"last_depth\\\":\" << LocalPrediction::GetLastDepth()\n+\t    << \",\\\"configured_max_ticks\\\":\" << g_SettingsMan.GetLocalPredictionMaxTicks()\n+\t    << \",\\\"effective_max_ticks\\\":\" << (ScenarioRunner::UsesBoundedLockstepWait() ? std::max(LocalPrediction::GetLastDepth(), g_SettingsMan.GetLocalPredictionMaxTicks()) : g_SettingsMan.GetLocalPredictionMaxTicks())\n \t    << \",\\\"ms_total\\\":\" << LocalPrediction::GetPreviewMs() << \",\\\"shadows\\\":\" << LocalPrediction::GetShadows() << \",\\\"taken\\\":\" << LocalPrediction::GetTaken()\n \t    << \",\\\"violations\\\":\" << LocalPrediction::GetViolations()\n \t    << \",\\\"events_played_at_preview\\\":\" << PreviewEventLedger::GetCounters().playedAtPreview\ndiff --git a/Source/Managers/FrameMan.cpp b/Source/Managers/FrameMan.cpp\nindex 72c3d7859..e2a5d0e76 100644\n--- a/Source/Managers/FrameMan.cpp\n+++ b/Source/Managers/FrameMan.cpp\n@@ -482,7 +482,14 @@ bool FrameMan::FeelBeginDraw() {\n \tif (const double capHz = FeelCapHz(); capHz > 0) {\n \t\tconst double now = FeelNowMS();\n \t\tif (s_Feel.nextDrawMS > now) return false;\n-\t\ts_Feel.nextDrawMS = std::max(now, s_Feel.nextDrawMS) + 1000.0 / capHz;\n+\t\tif (ScenarioRunner::IsLockstepControllerSyncActive() && s_Feel.nextDrawMS > 0) {\n+\t\t\t// Preview work can cross a draw deadline. Keep the match's cadence anchored to its scheduled slots,\n+\t\t\t// skipping elapsed slots after a hitch instead of carrying every late draw into all later deadlines.\n+\t\t\tconst double periodMS = 1000.0 / capHz;\n+\t\t\ts_Feel.nextDrawMS += (std::floor((now - s_Feel.nextDrawMS) / periodMS) + 1) * periodMS;\n+\t\t} else {\n+\t\t\ts_Feel.nextDrawMS = std::max(now, s_Feel.nextDrawMS) + 1000.0 / capHz;\n+\t\t}\n \t}\n \tif (!FeelRecordingEnabled()) return true;\n \tconst FeelCost cost;\ndiff --git a/Source/Managers/LocalPrediction.cpp b/Source/Managers/LocalPrediction.cpp\nindex 209c18129..01659efb5 100644\n--- a/Source/Managers/LocalPrediction.cpp\n+++ b/Source/Managers/LocalPrediction.cpp\n@@ -234,7 +234,9 @@ namespace RTE {\n \t\tClear();\n \t\ts_PhaseMs[0] += std::chrono::duration<double, std::milli>(RTE::SteadyClock::now() - dropStart).count();\n \t\tconst int delay = s_DepthOverride > 0 ? s_DepthOverride : static_cast<int>(ScenarioRunner::GetLockstepLocalInputDelay());\n-\t\tconst int depth = ScenarioRunner::UsesBoundedLockstepWait() ? delay : std::min(delay, std::max(0, g_SettingsMan.GetLocalPredictionMaxTicks()));\n+\t\tconst int configuredCap = std::max(0, g_SettingsMan.GetLocalPredictionMaxTicks());\n+\t\tconst int effectiveCap = ScenarioRunner::UsesBoundedLockstepWait() ? std::max(delay, configuredCap) : configuredCap;\n+\t\tconst int depth = std::min(delay, effectiveCap);\n \t\tif (depth <= 0) {\n \t\t\treturn;\n \t\t}\ndiff --git a/Source/Menus/NetModerationGUI.cpp b/Source/Menus/NetModerationGUI.cpp\nindex 6c0e98c16..15ee8f8d9 100644\n--- a/Source/Menus/NetModerationGUI.cpp\n+++ b/Source/Menus/NetModerationGUI.cpp\n@@ -1800,7 +1800,7 @@ void NetModerationGUI::DrawMatchStatus(const NetLobbySnapshot& snapshot) {\n \t\t};\n \t\tif (menuLobby) return \"In the lobby\";\n \t\tif (hostLost) return snapshot.statusText.starts_with(\"Changing hosts\") ? \"Changing hosts - the match picks up in a moment\" : \"Host lost - contacting the next host...\";\n-\t\t// The toast and the full-screen wait say the rest; the box's line never repeats theirs.\n+\t\t// The toast band suppresses this sentence when the status box already shows it.\n \t\tif (ownHeld) return NetPlayerPresentation::PlayingSummary(true, 0, {});\n \t\tif (resyncing) return \"Match repair in progress\";\n \t\tif (placing) {\n@@ -2536,6 +2536,11 @@ void NetModerationGUI::DrawMatchToasts(const std::string& screenLine) {\n \tstd::vector<size_t> indices;\n \tstd::vector<std::string> lines;\n \tconst auto sentence = [](const std::string& text) { return text.substr(0, text.find_last_not_of(\". \") + 1); };\n+\tstd::vector<std::string> statusLines;\n+\tif (m_StatusRect.visible && m_StatusWrap.active) {\n+\t\tstd::istringstream status(m_StatusWrap.source);\n+\t\tfor (std::string line; std::getline(status, line);) statusLines.push_back(sentence(line));\n+\t}\n \tconst uint8_t localPeer = ScenarioRunner::GetLockstepLocalPeerId();\n \tconst PauseMenuGUI* pauseMenu = g_MenuMan.GetActivePauseMenu();\n \tconst std::string menuSaveLine = pauseMenu ? pauseMenu->GetShownSaveLine() : std::string();\n@@ -2544,6 +2549,8 @@ void NetModerationGUI::DrawMatchToasts(const std::string& screenLine) {\n \t\t// A seat's toast reads its current state, so two events about one seat can read alike: the band shows that line once.\n \t\tstd::string line = ToastText(queued[index]);\n \t\tif (std::find(lines.begin(), lines.end(), line) != lines.end()) continue;\n+\t\t// The status box was drawn this frame. Its full sentences need only one visible copy, even when they wrap.\n+\t\tif (std::find(statusLines.begin(), statusLines.end(), sentence(line)) != statusLines.end()) continue;\n \t\t// The screen beneath shows its own line; the band does not read it out again, nor this seat's own state when that is the line.\n \t\tconst bool ownSeat = queued[index].senderPeerId == 0 || queued[index].senderPeerId == localPeer;\n \t\t// The wait's own screen already says this seat is on its way back.\ndiff --git a/tools/feel/session_delay.py b/tools/feel/session_delay.py\nindex 1f6043e6b..87a7ea2a5 100644\n--- a/tools/feel/session_delay.py\n+++ b/tools/feel/session_delay.py\n@@ -125,6 +125,8 @@ def reduce_peer(folder, peer, rtt, plan, lag_step=None):\n     preview_cost = preview.get('ms_total', 0) / preview['actor_ticks'] if preview.get('actor_ticks') else None\n     watches = watch_results(folder / peer / 'stdout.log')\n     delay_watches = [w for w in watches if w['watch'] == 'b4-delay']\n+    duplicate_watches = [w for w in watches if w['watch'] == 'screen-duplicates']\n+    own_hold_watches = [w for w in watches if w['watch'] == 'c-own-hold']\n     delay_values = [r['delay'] for r in frames if r['actors']]\n     limit = 16 if lag_step else 6 if rtt == 30 else 16 if rtt == 200 else 0\n     low_delay = [r['delay'] for r in frames if r['actors'] and lag_step and r['tick'] < lag_step[0]]\n@@ -141,6 +143,9 @@ def reduce_peer(folder, peer, rtt, plan, lag_step=None):\n                   rtt_samples=[dict(tick=r['tick'], peer=p['peer'], ping_ms=p['ping_ms'])\n                                for r in frames if r['tick'] % 60 == 0 for p in r.get('rtt', []) if not p['local']],\n                   captures=[r for r in rows if r['type'] == 'capture'], delay_watches=delay_watches,\n+                  duplicate_watches=duplicate_watches, own_hold_watches=own_hold_watches,\n+                  c_duplicates_pass=rtt is None or bool(duplicate_watches) and all(w['active_frames'] > 0 and w['violations'] == 0 for w in duplicate_watches),\n+                  c_own_hold_pass=all(w['violations'] == 0 for w in own_hold_watches),\n                   b1_delay_pass=bool(delay_values) and max(delay_values) <= limit and\n                                 (not lag_step or bool(low_delay) and max(low_delay) <= 6),\n                   b2_depth_pass=bool(owed) and not mismatches and not missing_state and (rtt is None or preview.get('enabled') and preview.get('previews', 0) > 0),\n@@ -159,7 +164,7 @@ def launch_case(root, arm, repeat, port, exe_sha, size, lag_step=None, preview_c\n     input_pattern(script)\n     plan = json.loads(script.with_name('input-schedule.json').read_text())\n     watches = out / 'screen-watches.txt'\n-    watches.write_text('b4-delay input_delay running\\nc-own-hold sentence local_held LabelNetMatchStatus The AI is playing for you until you are back\\n', encoding='utf-8')\n+    watches.write_text('b4-delay input_delay running\\nc-own-hold sentence local_held LabelNetMatchStatus The AI is playing for you until you are back\\nscreen-duplicates duplicates always\\n', encoding='utf-8')\n     rtt = ARMS[arm]\n     peers = ['sp'] if rtt is None else ['host', 'client']\n     runs, receipts = {}, {}\n@@ -280,13 +285,14 @@ def summarize(cases, repeats, selected):\n             judged.append(dict(arm=case['arm'], repeat=case['repeat'], peer=p['peer'], latency_ms=p['latency_ms'],\n                                latency_frames=p['latency_frames'], b3_pass=feel_pass,\n                                b1_delay_pass=p['b1_delay_pass'], b2_depth_pass=p['b2_depth_pass'], b4_overlay_pass=p['b4_overlay_pass'],\n+                               c_duplicates_pass=p['c_duplicates_pass'], c_own_hold_pass=p['c_own_hold_pass'],\n                                preview_ms_per_actor_tick=p['preview_ms_per_actor_tick'], delay_min=p['delay_min'], delay_max=p['delay_max']))\n     complete = repeats >= 3 and set(selected) == set(ARMS) and len(cases) == repeats * len(ARMS) and all(\n         c['manifest']['complete'] and c['manifest']['quiet'] and c['manifest']['binary_unchanged'] for c in cases)\n     rise_checks = [case['manifest']['live_resize'] for case in cases if case['manifest'].get('lag_step')]\n     return dict(complete=complete, single_player_repeat_noise=noise, rows=judged, live_resize_checks=rise_checks,\n                 pass_check=complete and coverage and all(r['pass_check'] for r in rise_checks) and\n-                           all(all(p[k] for k in ('b1_delay_pass', 'b2_depth_pass', 'b3_pass', 'b4_overlay_pass')) for p in judged),\n+                           all(all(p[k] for k in ('b1_delay_pass', 'b2_depth_pass', 'b3_pass', 'b4_overlay_pass', 'c_duplicates_pass', 'c_own_hold_pass')) for p in judged),\n                 definition='Existing feel.report.input_latencies: first completed presentation whose local actor changes aim/velocity in the requested direction and carries that input. Every missing response remains RED. Each network p50 must lie inside the measured single-player repeat p50 range, in milliseconds and presented frames; no added tolerance.',\n                 scope='Headed Linux local two-engine fake-RTT measurement, not a spread/relay proof or physical display scanout measurement.')\n \n",
